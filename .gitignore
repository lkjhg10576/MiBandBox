node_modules/
build/
dist/
.temp_*/
*.log
.venv-emu/
_re/
__pycache__/
*.rpk
# AstroBox 资源仓库例外：downloads/ 下的包体是平台下载入口指向的文件，
# 必须入库 —— AtomGit 每次提交都会覆盖镜像仓库（= GitHub 资源仓库），
# 不入库的话控制台上传的包体下一次 push 就被冲掉，平台链接失效。
!downloads/*.rpk
docs/
.release/
.vscode/

# AstroBox 插件：AstroBox-Plugin-WIT 由 `npm run wit` 拉取，不入库
plugin/*/wit/
plugin/*/node_modules/
plugin/*/dist/

# 本地工具 / Agent 运行状态，不入库
.mimosa/
.v2c/
plugin/*/.mimosa/
.zcode/
.workbuddy/
.atomcode/
.arts/

# profile 物化的本地状态（构建期备份与标记，不入库）
.profile-baseline/
.profile-state.json

# 发行证书目录：私钥绝不入库
# production 打包（aiot release）按 sign/release/ -> sign/ 的顺序找 certificate.pem + private.pem
sign/

# tools/ 整个目录不入库（本地开发工具链，不随项目开源）
# 用 tools/* 而不是 tools/：目录整体被排除时，下面的 ! 例外不会生效
tools/*
# 例外：发行门禁是构建链的一部分，必须跟着仓库走
!tools/release-gate.mjs
# 例外：AstroBox 上架同步脚本同理（控制台改完资源要把文件拉回本地）
!tools/astrobox-sync.mjs

# 本地验证截图（本地工具产出）
.shots/

#HyperFrames宣传视频
.promo/
# 宣传片工程目录（HyperFrames 合成 + 帧序列，体积 2.5G，不入库）
/promo/
# 宣传片配套物料（BGM 音频、封面大图、AstroBox 图标），均由 promo/tools 生成
bandbox-promo-bgm-*.mp3
bandbox-promo-bgm-*.wav
/hero-zh-3x2.jpg
/icon_astrobox.png

# 歸藏设计社交卡任务产物（本地生成，不随仓库开源）
local-tests/

# 宣传封面矩阵工作区（本地生成，含本机绝对路径与大体积素材，不入库）
resources/
