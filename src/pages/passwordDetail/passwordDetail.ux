<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="密码详情" clock="{{ clock }}"></pagehead>
    <div class="pwdCard">
      <text class="f pwd">{{ shown ? item : masked }}</text>
      <text class="f meta">{{ len }} 位 · {{ timeText }}</text>
      <div class="eye" @click="toggle"><text class="f eyeT">{{ shown ? '隐藏' : '显示' }}</text></div>
    </div>

    <div class="card" @click="qr"><text class="f cT">生成二维码</text><text class="f arrow">></text></div>
    <div class="card card2" @click="del"><text class="f cT" style="color: #FF6B6B;">{{ delStep === 0 ? '删除这条收藏' : '再次点击确认删除' }}</text><text class="f arrow" style="color: #FF6B6B;">></text></div>

    <text class="f tip">密码仅保存在本机</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.pwdCard { position: absolute; left: 3px; top: 84px; width: 206px; height: 132px; border-radius: 26px; background-color: #262626; align-items: center; justify-content: center; flex-direction: column; }
.pwd { width: 186px; height: 48px; line-height: 48px; text-align: center; font-size: 17px; color: #FFFFFF; letter-spacing: 1px; text-overflow: ellipsis; lines: 1; }
.meta { width: 186px; height: 20px; line-height: 20px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.4); }
.eye { width: 56px; height: 22px; margin-top: 6px; border-radius: 11px; background-color: rgba(255,255,255,0.08); align-items: center; justify-content: center; }
.eyeT { font-size: 14px; color: rgba(255,255,255,0.6); }
.card { position: absolute; left: 3px; top: 236px; width: 206px; height: 72px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 18px; }
.card2 { top: 316px; }
.cT { font-size: 17px; color: #FFFFFF; }
.arrow { font-size: 20px; color: rgba(255,255,255,0.4); }
.tip { position: absolute; left: 16px; top: 438px; width: 180px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.3); }
</style>

<script>
import time from '../../utils/time'
import kv from '../../utils/kv'
import router from '../../utils/router'
import haptic from '../../utils/haptic'
import prompt from '@system.prompt'

export default {
  protected: { id: '' },
  private: { clock: '--:--', item: '', masked: '', len: 0, timeText: '', shown: false, delStep: 0, list: [], timer: null },
  onShow() {
    this.clock = time.formatClock(new Date())
    this.delStep = 0
    kv.init(() => {
      const raw = kv.get('pwdFavs', [])
      this.list = Array.isArray(raw) ? raw : []
      const idx = parseInt(this.id, 10) || 0
      const it = this.list[idx]
      if (!it) {
        prompt.showToast({ message: '密码不存在', duration: 1400 })
        setTimeout(() => router.back(), 400)
        return
      }
      this.item = it.item
      this.len = it.item.length
      this.masked = it.item.slice(0, 2) + '••••••' + it.item.slice(-2)
      const d = new Date(it.time)
      this.timeText = d.getFullYear() + '-' + time.pad2(d.getMonth() + 1) + '-' + time.pad2(d.getDate())
    })
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  toggle() {
    this.shown = !this.shown
    haptic.short()
  },
  qr() {
    if (!this.item) return
    router.push('/pages/qrcode/show', { qr: this.item })
  },
  del() {
    if (this.delStep === 0) {
      this.delStep = 1
      return
    }
    const idx = parseInt(this.id, 10) || 0
    const next = this.list.slice()
    next.splice(idx, 1)
    kv.set('pwdFavs', next)
    haptic.long()
    prompt.showToast({ message: '已删除', duration: 1200 })
    setTimeout(() => router.back(), 300)
  }
}
</script>
