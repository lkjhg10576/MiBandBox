<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ !awake }}"><text class="napLoadT">加载中…</text></div><div class="napWrap" if="{{ awake }}">
    <pagehead title="密码详情" clock="{{ clock }}"></pagehead>
    <div class="pwdCard">
      <text class="f pwd">{{ shown ? item : masked }}</text>
      <text class="f meta">{{ len }} 位 · {{ timeText }}</text>
      <div class="eye" @click="toggle"><text class="f eyeT">{{ shown ? '隐藏' : '显示' }}</text></div>
    </div>

    <div class="card" @click="qr"><text class="f cT">生成二维码</text><text class="f arrow">></text></div>
    <div class="card card2" @click="del"><text class="f cT" style="color: #FF6B6B;">{{ delStep === 0 ? '删除这条收藏' : '再次点击确认删除' }}</text><text class="f arrow" style="color: #FF6B6B;">></text></div>

    <text class="f tip">密码仅保存在本机</text>
    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../common/styles/theme.css';
.pwdCard { position: absolute; left: 3px; top: 84px; width: 206px; height: 132px; border-radius: 26px; background-color: #262626; align-items: center; justify-content: center; flex-direction: column; }
.pwd { width: 186px; height: 48px; line-height: 48px; text-align: center; font-size: 17px; color: #FFFFFF; letter-spacing: 1px; text-overflow: ellipsis; lines: 1; }
.meta { width: 186px; height: 20px; line-height: 20px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.4); }
.eye { width: 56px; height: 22px; margin-top: 6px; border-radius: 11px; background-color: rgba(255,255,255,0.08); align-items: center; justify-content: center; }
.eyeT { font-size: 14px; color: rgba(255,255,255,0.6); }
.card { position: absolute; left: 3px; top: 236px; width: 206px; height: 72px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 18px; }
.card2 { top: 316px; }
.cT { font-size: 17px; color: #FFFFFF; }
.arrow { font-size: 20px; color: rgba(255,255,255,0.55); }
.tip { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.55); }
</style>

<script>
import g from '../../utils/g'
import prompt from '@system.prompt'
import life from '../../utils/pageLife'

export default life({
  protected: { id: '' },
  private: { clock: '--:--', item: '', masked: '', len: 0, timeText: '', shown: false, delStep: 0, list: [], timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.delStep = 0
    g.kv.init(() => {
      const raw = g.kv.get('pwdFavs', [])
      this.list = Array.isArray(raw) ? raw : []
      // 路由参数是密码文本（收藏按文本去重、必然唯一），不用下标定位 ——
      // list/for 里 $index 不可靠（同 sentence/fav.ux 的处理），下标路由会让点谁都进第一条。
      // 文本经 encodeURIComponent 传过来（见 password.ux openFav），由 locate() 解码匹配。
      const idx = this.locate()
      const it = idx >= 0 ? this.list[idx] : null
      if (!it) {
        prompt.showToast({ message: '该收藏已不存在', duration: 1400 })
        setTimeout(() => g.router.back(), 400)
        return
      }
      this.item = it.item
      this.len = it.item.length
      this.masked = it.item.slice(0, 2) + '••••••' + it.item.slice(-2)
      const d = new Date(it.time)
      this.timeText = d.getFullYear() + '-' + g.time.pad2(d.getMonth() + 1) + '-' + g.time.pad2(d.getDate())
    })
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  /**
   * 按密码文本定位收藏（查看与删除共用）。
   * 路由参数是 encodeURIComponent 过的密码文本（见 password.ux openFav），router 搬运
   * 时可能原样透传（页面拿到编码串），也可能被它自己再编/解一层 —— 所以先按原文比，
   * 再逐层解码比（最多两层，解码前后相同即停），都找不到返回 -1。
   * list/for 里的 $index 不可靠（同 sentence/fav.ux 的处理），不用下标。
   */
  locate() {
    const raw = this.id
    if (typeof raw !== 'string' || !raw) return -1
    let idx = this.list.findIndex((e) => e.item === raw)
    if (idx >= 0) return idx
    let cur = raw
    for (let i = 0; i < 2; i++) {
      let next
      try {
        next = decodeURIComponent(cur)
      } catch (e) {
        return -1
      }
      if (next === cur) return -1
      cur = next
      idx = this.list.findIndex((e) => e.item === cur)
      if (idx >= 0) return idx
    }
    return -1
  },
  toggle() {
    this.shown = !this.shown
    g.haptic.short()
  },
  qr() {
    if (!this.item) return
    g.router.push('/pages/qrcode/show', { qr: this.item })
  },
  del() {
    if (this.delStep === 0) {
      this.delStep = 1
      return
    }
    // 同 onShow：按密码文本定位，不用下标（list/for 里的 $index 不可靠）
    const idx = this.locate()
    if (idx < 0) {
      prompt.showToast({ message: '该收藏已不存在', duration: 1200 })
      g.router.back()
      return
    }
    const next = this.list.slice()
    next.splice(idx, 1)
    g.kv.set('pwdFavs', next)
    // set 只写内存 + 120ms 防抖落盘（src/utils/kv.js:19,31-79）；紧跟着 router.back 会销毁
    // 页面并取消那个 timer，删除偶发不落盘（V4 文件日志里失败那次只有读 open、没有写 open）。
    // 显式 flush 先把整份 JSON 写出去再返回（同 sentence/favdetail 的取消收藏）。
    g.kv.flush()
    g.haptic.long()
    prompt.showToast({ message: '已删除', duration: 1200 })
    g.router.back()
  }
})
</script>
