<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="水平仪" clock="{{ clock }}"></pagehead>

    <div class="dial"></div>
    <div class="crossH"></div>
    <div class="crossV"></div>
    <div class="target" style="border-color: {{ stateColor }};"></div>
    <div class="dot" style="left: {{ dotLeft }}px; top: {{ dotTop }}px; background-color: {{ stateColor }};"></div>

    <text class="f angles">Roll {{ rollText }} · Pitch {{ pitchText }}</text>
    <text class="f state" style="color: {{ stateColor }};">{{ state }}</text>

    <div class="btn" @click="calibrate"><text class="f btnT">校准为零</text></div>
    <text class="f foot">放平设备，圆点回到中心</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.dial { position: absolute; left: 16px; top: 92px; width: 180px; height: 180px; border-radius: 90px; background-color: #151515; border-width: 2px; border-style: solid; border-color: #333333; }
.crossH { position: absolute; left: 26px; top: 181px; width: 160px; height: 2px; background-color: #3A3A3A; }
.crossV { position: absolute; left: 105px; top: 102px; width: 2px; height: 160px; background-color: #3A3A3A; }
.target { position: absolute; left: 78px; top: 154px; width: 56px; height: 56px; border-radius: 28px; background-color: transparent; border-width: 2px; border-style: solid; }
.dot { position: absolute; width: 18px; height: 18px; border-radius: 9px; }
.angles { position: absolute; left: 0px; top: 284px; width: 212px; height: 22px; line-height: 22px; text-align: center; font-size: 15px; color: rgba(255,255,255,0.7); }
.state { position: absolute; left: 0px; top: 312px; width: 212px; height: 28px; line-height: 28px; text-align: center; font-size: 17px; }
.btn { position: absolute; left: 48px; top: 352px; width: 116px; height: 42px; border-radius: 21px; background-color: #262626; align-items: center; justify-content: center; }
.btnT { font-size: 14px; color: #FFFFFF; }
.foot { position: absolute; left: 21px; top: 424px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import time from '../../utils/time'
import sensor from '@system.sensor'
import brightness from '@system.brightness'
import haptic from '../../utils/haptic'

const RAD2DEG = 180 / Math.PI
const MAX_ANGLE = 45
const MAX_OFFSET = 70
const DOT_BASE_LEFT = 97
const DOT_BASE_TOP = 173

function clamp(v, min, max) {
  if (v < min) return min
  if (v > max) return max
  return v
}

function formatAngle(v) {
  return (v > 0 ? '+' : '') + v.toFixed(1) + '°'
}

export default {
  data: {
    clock: '--:--',
    roll: null,
    pitch: null,
    rollText: '0.0°',
    pitchText: '0.0°',
    state: '等待传感器',
    stateColor: '#0D6EFF',
    dotLeft: DOT_BASE_LEFT,
    dotTop: DOT_BASE_TOP,
    offsetRoll: 0,
    offsetPitch: 0,
    timer: null
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
    // 读数时避免自动熄屏（只常亮，不动亮度）
    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })
    this.subscribe()
  },
  onHide() {
    this.unsubscribe()
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },
  onDestroy() {
    this.unsubscribe()
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  subscribe() {
    try {
      sensor.subscribeAccelerometer({
        interval: 200,
        callback: (ret) => {
          const x = ret.x || 0
          const y = ret.y || 0
          const z = ret.z || 0
          // 左右倾斜（roll）与前后倾斜（pitch），z 接近 0 时结果仍在 ±90 内
          const rollRaw = Math.atan2(x, z) * RAD2DEG - this.offsetRoll
          const pitchRaw = Math.atan2(y, z) * RAD2DEG - this.offsetPitch
          // 双轴各自平滑：0.8 旧值 + 0.2 新值
          this.roll = this.roll === null ? rollRaw : this.roll * 0.8 + rollRaw * 0.2
          this.pitch = this.pitch === null ? pitchRaw : this.pitch * 0.8 + pitchRaw * 0.2
          this.apply()
        },
        fail: () => {
          this.state = '传感器不可用'
          this.stateColor = '#FF9500'
        }
      })
    } catch (e) {
      this.state = '传感器不可用'
      this.stateColor = '#FF9500'
    }
  },
  unsubscribe() {
    try {
      sensor.unsubscribeAccelerometer()
    } catch (e) {}
  },
  apply() {
    const roll = this.roll === null ? 0 : this.roll
    const pitch = this.pitch === null ? 0 : this.pitch
    const absRoll = Math.abs(roll)
    const absPitch = Math.abs(pitch)

    this.rollText = formatAngle(roll)
    this.pitchText = formatAngle(pitch)

    // 圆点偏移：最大 70px，roll 为正向右，pitch 为正向上
    const cr = clamp(roll, -MAX_ANGLE, MAX_ANGLE)
    const cp = clamp(pitch, -MAX_ANGLE, MAX_ANGLE)
    this.dotLeft = DOT_BASE_LEFT + (cr / MAX_ANGLE) * MAX_OFFSET
    this.dotTop = DOT_BASE_TOP - (cp / MAX_ANGLE) * MAX_OFFSET

    if (absRoll < 1.5 && absPitch < 1.5) {
      this.stateColor = '#00C853'
      this.state = '已水平'
    } else if (absRoll < 8 && absPitch < 8) {
      this.stateColor = '#0D6EFF'
      this.state = '微倾'
    } else {
      this.stateColor = absRoll > 30 || absPitch > 30 ? '#FF3B30' : '#FF9500'
      this.state = '倾斜'
    }
  },
  calibrate() {
    haptic.short()
    // 把当前角度计入偏移，两轴归零
    this.offsetRoll = this.offsetRoll + (this.roll === null ? 0 : this.roll)
    this.offsetPitch = this.offsetPitch + (this.pitch === null ? 0 : this.pitch)
    this.roll = 0
    this.pitch = 0
    this.apply()
  }
}
</script>
