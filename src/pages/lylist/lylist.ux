<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="歌词本" clock="{{ clock }}"></pagehead>
    <list class="list" bounces="true">
      <list-item type="transfer" class="card transferCard" @click="openTransfer">
        <div class="cMain">
          <text class="f cTitle">从手机传输</text>
          <text class="f cSub">在手机插件中选择 LRC 文件发送</text>
        </div>
        <img class="enter" src="/common/enter.png" />
      </list-item>
      <list-item type="lyric" class="card" for="{{ items }}" @click="open($item)">
        <div class="cMain">
          <text class="f cTitle">{{ $item.title }}</text>
          <text class="f cSub">{{ $item.dateText }} · {{ $item.sizeText }}</text>
        </div>
        <img class="enter" src="/common/enter.png" />
      </list-item>
      <list-item type="empty" class="empty" if="{{ items.length === 0 }}">
        <img class="emptyImg" src="/common/empty.png" />
        <text class="f emptyT">还没有歌词</text>
        <text class="f emptyS">点右下角新建，纯本地保存</text>
      </list-item>
      <list-item type="pad" class="pad"></list-item>
    </list>

    <img class="plus" src="/common/plus.png" @click="create" />
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
/* 列表项不留横向 margin：原生 list 会把子项 margin 计入可横向滚动范围（3px 边距即产生可拖动空间，抢占右滑返回），内缩改由 list 自身 padding 提供。 */
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; padding: 0px 3px 0px 3px; }
.card { width: 206px; height: 72px; margin: 0px 0px 8px 0px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 14px 0px 16px; }
.transferCard { background-color: #14324F; }
.cMain { width: 140px; height: 54px; flex-direction: column; justify-content: center; }
.cTitle { width: 140px; height: 28px; line-height: 28px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 140px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.45); }
.enter { width: 26px; height: 26px; }
.empty { width: 206px; height: 320px; align-items: center; justify-content: center; flex-direction: column; }
.emptyImg { width: 80px; height: 80px; margin-bottom: 12px; }
.emptyT { font-size: 17px; color: #FFFFFF; }
.emptyS { font-size: 14px; color: rgba(255,255,255,0.4); }
.pad { width: 206px; height: 110px; }
.plus { position: absolute; left: 132px; top: 396px; width: 64px; height: 64px; }
</style>

<script>
import g from '../../utils/g'
import docs from '../../utils/docs'

function sizeText(n) {
  if (!n && n !== 0) return '0 B'
  if (n < 1024) return n + ' B'
  return (Math.round((n / 1024) * 10) / 10) + ' KB'
}

function dateText(ms) {
  if (!ms) return '—'
  const d = new Date(ms)
  return (d.getMonth() + 1) + '月' + d.getDate() + '日'
}

export default {
  data: { clock: '--:--', items: [], timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.load()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  load() {
    docs.list('lyrics', (list) => {
      this.items = list.map((it) => ({
        name: it.name,
        title: it.title,
        sizeText: sizeText(it.size),
        dateText: dateText(it.mtime)
      }))
    })
  },
  open(item) {
    g.router.push('/pages/lyrics/show', { name: item.name })
  },
  openTransfer() {
    g.haptic.short()
    g.router.push('/pages/lyrics/transfer')
  },
  create() {
    g.haptic.short()
    g.router.push('/pages/lyrics/edit', { name: '' })
  }
}
</script>
