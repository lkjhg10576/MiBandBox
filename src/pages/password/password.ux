<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <pagehead title="密码生成" clock="{{ clock }}"></pagehead>
    <div class="tabs">
      <div class="tab" style="background-color: {{ tab === 'gen' ? '#0D6EFF' : 'transparent' }};" @click="setTab('gen')"><text class="f tabT">生成</text></div>
      <div class="tab" style="background-color: {{ tab === 'fav' ? '#0D6EFF' : 'transparent' }};" @click="setTab('fav')"><text class="f tabT">收藏夹</text></div>
    </div>

    <div class="pane" if="{{ tab === 'gen' }}">
      <div class="pwdCard">
        <text class="f pwd">{{ shown ? password : maskText }}</text>
        <div class="eye" @click="toggleShow"><text class="f eyeT">{{ shown ? '隐藏' : '显示' }}</text></div>
      </div>

      <div class="lenRow" @click="openLenKb">
        <text class="f label">长度</text>
        <text class="f len">{{ kbShow && lenDraft ? lenDraft : len }}</text>
      </div>

      <div class="sets">
        <div class="set {{ useUpper ? 'on' : '' }}" @click="toggle('upper')"><text class="f setT">A-Z</text></div>
        <div class="set {{ useLower ? 'on' : '' }}" @click="toggle('lower')"><text class="f setT">a-z</text></div>
        <div class="set {{ useDigit ? 'on' : '' }}" @click="toggle('digit')"><text class="f setT">0-9</text></div>
        <div class="set {{ useSymbol ? 'on' : '' }}" @click="toggle('symbol')"><text class="f setT">#!?</text></div>
      </div>

      <div class="actions">
        <div class="btn" @click="generate"><text class="f btnT">重新生成</text></div>
        <div class="btn dark" @click="favorite"><text class="f btnT">收藏</text></div>
      </div>
    </div>

    <div class="pane" if="{{ tab === 'fav' }}">
      <list class="favList" bounces="true">
        <list-item type="fav" class="favCard" for="{{ favs }}" @click="openFav($item, $index)">
          <text class="f favPwd">{{ $item.masked }}</text>
          <text class="f favTime">{{ $item.timeText }}</text>
        </list-item>
        <list-item type="empty" class="empty" if="{{ favs.length === 0 }}">
          <text class="f emptyT">还没有收藏</text>
          <text class="f emptyS">生成密码后点收藏</text>
        </list-item>
      </list>
    </div>
    <backbtn></backbtn>
    <div class="kbBar" show="{{ kbShow }}" @click="closeKb"><text class="f kbBarT">完成</text></div>
    <input-method hide="{{ !kbShow }}" keyboardtype="number" maxlength="2" vibratemode="short" screentype="pill-shaped" @complete="onLenKey" @delete="onLenDel"></input-method>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.pane { position: absolute; left: 0px; top: 126px; width: 212px; height: 340px; z-index: 1; }
.tabs { position: absolute; left: 6px; top: 82px; width: 200px; height: 40px; z-index: 50; border-radius: 20px; background-color: #1A1A1A; flex-direction: row; padding: 3px; }
.tab { flex: 1; height: 34px; border-radius: 17px; align-items: center; justify-content: center; }
.tab.on { background-color: #0D6EFF; }
.tabT { font-size: 14px; color: #FFFFFF; }
.pwdCard { position: absolute; left: 3px; top: 0px; width: 206px; height: 92px; border-radius: 26px; background-color: #262626; align-items: center; justify-content: center; flex-direction: column; }
.pwd { width: 190px; height: 52px; line-height: 26px; text-align: center; font-size: 15px; color: #FFFFFF; letter-spacing: 1px; text-overflow: ellipsis; lines: 2; }
.eye { width: 52px; height: 22px; border-radius: 11px; background-color: rgba(255,255,255,0.08); align-items: center; justify-content: center; }
.eyeT { font-size: 14px; color: rgba(255,255,255,0.6); }
.lenRow { position: absolute; left: 12px; top: 104px; width: 188px; height: 24px; flex-direction: row; justify-content: space-between; align-items: center; }
.label { font-size: 14px; color: rgba(255,255,255,0.5); }
.len { font-size: 16px; color: #0D6EFF; padding: 2px 8px; border-radius: 12px; border: 1px solid rgba(13,110,255,0.4); }
.sets { position: absolute; left: 6px; top: 176px; width: 200px; height: 36px; flex-direction: row; justify-content: space-between; }
.set { width: 46px; height: 34px; border-radius: 17px; background-color: #262626; align-items: center; justify-content: center; }
.set.on { background-color: rgba(13,110,255,0.35); }
.setT { font-size: 14px; color: #FFFFFF; }
.actions { position: absolute; left: 18px; top: 224px; width: 176px; height: 44px; flex-direction: row; justify-content: space-between; }
.btn { width: 84px; height: 44px; border-radius: 22px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.btn.dark { background-color: #262626; }
.btnT { font-size: 14px; color: #FFFFFF; }
.favList { position: absolute; left: 0px; top: 0px; width: 212px; height: 340px; }
.favCard { width: 206px; height: 72px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 0px 16px; flex-direction: column; justify-content: center; }
.favPwd { width: 174px; height: 26px; line-height: 26px; font-size: 17px; color: #FFFFFF; letter-spacing: 1px; }
.favTime { width: 174px; height: 18px; line-height: 18px; font-size: 14px; color: rgba(255,255,255,0.4); }
.empty { width: 212px; height: 240px; align-items: center; justify-content: center; flex-direction: column; }
.emptyT { font-size: 17px; color: #FFFFFF; }
.emptyS { font-size: 14px; color: rgba(255,255,255,0.4); }
</style>

<script>
import g from '../../utils/g'
import prompt from '@system.prompt'
import crypto from '@system.crypto'

const UPPER = 'ABCDEFGHJKLMNPQRSTUVWXYZ'
const LOWER = 'abcdefghijkmnopqrstuvwxyz'
const DIGITS = '23456789'
const SYMBOLS = '!@#$%^&*-_=+?'

function randomInt(max) {
  try {
    if (crypto && typeof crypto.getRandomValues === 'function') {
      const arr = new Uint8Array(1)
      crypto.getRandomValues(arr)
      return arr[0] % max
    }
  } catch (e) {}
  return Math.floor(Math.random() * max)
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    tab: 'gen',
    password: '',
    shown: false,
    maskText: '••••••••',
    len: 16,
    useUpper: true,
    useLower: true,
    useDigit: true,
    useSymbol: false,
    favs: [],
    timer: null,
    kbShow: false,
    lenDraft: ''
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    g.kv.init(() => {
      this.loadFavs()
    })
    if (this.password) this.maskText = this.mask(this.password)
    else this.generate()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    this.kbShow = false
    this.lenDraft = ''
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  mask(p) {
    let s = ''
    for (let i = 0; i < p.length; i++) s += '•'
    return s
  },
  loadFavs() {
    const raw = g.kv.get('pwdFavs', [])
    const list = Array.isArray(raw) ? raw : []
    this.favs = list.map((it) => ({
      item: it.item,
      time: it.time,
      masked: it.item.slice(0, 2) + '••••' + it.item.slice(-2),
      timeText: this.fmtTime(it.time)
    }))
  },
  fmtTime(ms) {
    if (!ms) return ''
    const d = new Date(ms)
    return d.getFullYear() + '-' + g.time.pad2(d.getMonth() + 1) + '-' + g.time.pad2(d.getDate()) + ' ' + g.time.formatClock(d)
  },
  setTab(t) {
    this.tab = t
    g.haptic.short()
  },
  toggleShow() {
    this.shown = !this.shown
    g.haptic.short()
  },
  openLenKb() {
    this.lenDraft = ''
    this.kbShow = true
    g.haptic.short()
  },
  closeKb() {
    this.kbShow = false
    if (this.lenDraft) {
      this.applyLen(this.lenDraft)
    }
    this.lenDraft = ''
    g.haptic.short()
  },
  applyLen(val) {
    let v = parseInt(val, 10)
    if (isNaN(v)) return
    this.len = Math.max(8, Math.min(32, v))
    this.generate()
  },
  onLenKey(e) {
    const raw = e && e.detail && e.detail.content ? String(e.detail.content) : ''
    if (!raw) return
    const digits = raw.replace(/[^0-9]/g, '')
    if (!digits) return
    if (this.lenDraft.length >= 2 && digits.length === 1) return
    this.lenDraft = (this.lenDraft + digits).slice(-2)
    if (this.lenDraft.length >= 2) {
      this.applyLen(this.lenDraft)
    }
  },
  onLenDel() {
    this.lenDraft = this.lenDraft.slice(0, -1)
  },
  toggle(which) {
    if (which === 'upper') this.useUpper = !this.useUpper
    if (which === 'lower') this.useLower = !this.useLower
    if (which === 'digit') this.useDigit = !this.useDigit
    if (which === 'symbol') this.useSymbol = !this.useSymbol
    if (!this.useUpper && !this.useLower && !this.useDigit && !this.useSymbol) {
      this.useLower = true
    }
    this.generate()
    g.haptic.short()
  },
  generate() {
    const sets = []
    if (this.useUpper) sets.push(UPPER)
    if (this.useLower) sets.push(LOWER)
    if (this.useDigit) sets.push(DIGITS)
    if (this.useSymbol) sets.push(SYMBOLS)
    if (!sets.length) sets.push(LOWER)
    let out = ''
    for (let i = 0; i < this.len; i++) {
      const set = sets[i < sets.length ? i : randomInt(sets.length)]
      out += set[randomInt(set.length)]
    }
    this.password = out
    this.maskText = this.mask(out)
    this.shown = false
  },
  favorite() {
    if (!this.password) {
      prompt.showToast({ message: '你还没有生成密码哦~', duration: 1500 })
      return
    }
    const raw = g.kv.get('pwdFavs', [])
    const list = Array.isArray(raw) ? raw.slice() : []
    const item = { item: this.password, time: Date.now() }
    const dup = list.some((x) => x.item === item.item)
    if (!dup) list.unshift(item)
    if (list.length > 50) list.length = 50
    g.kv.set('pwdFavs', list)
    this.loadFavs()
    this.tab = 'fav'
    g.haptic.short()
    prompt.showToast({ message: dup ? '已经在收藏夹里了' : '收藏成功，可切换查看', duration: 1600 })
  },
  openFav(item, index) {
    g.router.push('/pages/passwordDetail', { id: index })
  }
}
</script>
