<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <!-- 计数区：只负责「运行中」的点击计数，启动由独立的开始按钮负责 -->
    <div class="tapZone" @click="onTap">
    <pagehead title="手速测试" clock="{{ clock }}"></pagehead>
    <text class="f big" style="color: {{ bigColor }};">{{ big }}</text>
    <text class="f status">{{ status }}</text>

    <div class="bar">
      <div class="fill" style="width: {{ progress }}%;"></div>
    </div>

    <text class="f result" if="{{ state === 'done' }}">{{ cps }} 次/秒</text>
    <text class="f hint">{{ hint }}</text>
    </div>

    <!-- 开始按钮与 .tapZone 是兄弟节点，互不为父节点：
         点按钮不会冒泡到计数区，不会顺带 count++ ；结算后再点屏幕也不会重开 -->
    <div class="startBtn" if="{{ state === 'idle' || state === 'done' }}" @click="start">
      <text class="f startT" if="{{ state === 'idle' }}">开始测试</text>
      <text class="f startT" if="{{ state === 'done' }}">再测一次</text>
    </div>

    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.tapZone { position: absolute; left: 0px; top: 0px; width: 212px; height: 520px; }
.big { position: absolute; left: 0px; top: 120px; width: 212px; height: 96px; line-height: 96px; text-align: center; font-size: 76px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.status { position: absolute; left: 20px; top: 226px; width: 172px; height: 28px; line-height: 28px; text-align: center; font-size: 16px; color: rgba(255,255,255,0.7); }
.bar { position: absolute; left: 26px; top: 272px; width: 160px; height: 8px; border-radius: 4px; background-color: #262626; }
.fill { height: 8px; border-radius: 4px; background-color: #0D6EFF; }
.result { position: absolute; left: 0px; top: 300px; width: 212px; text-align: center; font-size: 26px; color: #00C853; }
.hint { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.4); }
/* 开始按钮：z-index 20 < 返回按钮的 99，不会挡住返回 */
.startBtn { position: absolute; left: 26px; top: 360px; width: 160px; height: 44px; border-radius: 22px; background-color: #0D6EFF; z-index: 20; align-items: center; justify-content: center; }
.startT { font-size: 17px; font-weight: bold; color: #FFFFFF; }
</style>

<script>

import g from '../../utils/g'
const DURATION = 5000

export default {
  data: {
    _ck: null,
    clock: '--:--',
    state: 'idle',
    big: '5.0',
    bigColor: '#FFFFFF',
    status: '点下方按钮开始',
    progress: 0,
    cps: '0.00',
    hint: '5 秒内尽可能多地点击',
    count: 0,
    timer: null,
    clockTimer: null,
    startAt: 0
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    this.resetView()
  },
  onHide() {
    this.clearTimers()
  },
  onDestroy() {
    this.clearTimers()
  },
  clearTimers() {
    if (this.timer) clearInterval(this.timer)
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    this.timer = null
    this.clockTimer = null
    // 回到初始态：避免测试中切后台/退出后回来卡在 countdown 或 running
    this.state = 'idle'
    this.count = 0
    this.progress = 0
    this.cps = '0.00'
  },
  resetView() {
    this.big = '5.0'
    this.bigColor = '#FFFFFF'
    this.status = '点下方按钮开始'
    this.hint = '5 秒内尽可能多地点击'
  },
  onTap() {
    // 只在计时中计数；idle/done 时点屏幕一律无效，防止误触重开
    if (this.state !== 'running') return
    this.count++
    this.big = String(this.count)
    this.status = '正在计数'
    g.haptic.short()
  },
  start() {
    // 防重入：连点按钮只产生一个倒计时
    if (this.state !== 'idle' && this.state !== 'done') return
    this.state = 'countdown'
    this.count = 0
    this.big = '3'
    this.bigColor = '#FF9500'
    this.status = '准备'
    this.progress = 0
    this.cps = '0.00'
    this.hint = '倒计时结束后开始点击'
    let n = 3
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      n--
      if (n > 0) {
        this.big = String(n)
        this.status = '准备'
      } else if (n === 0) {
        this.big = '开始'
        this.status = '快速点击！'
        this.bigColor = '#00C853'
        this.beginRun()
      }
    }, 800)
  },
  beginRun() {
    this.state = 'running'
    this.count = 0
    this.startAt = Date.now()
    this.big = '0'
    this.status = '快速点击！'
    this.hint = '别停，继续点'
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      const elapsed = Date.now() - this.startAt
      const left = Math.max(0, DURATION - elapsed)
      this.progress = Math.round((left / DURATION) * 100)
      if (left <= 0) {
        this.finish()
      }
    }, 80)
  },
  finish() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    // state 停在 done 以保留结果，直到用户主动点「再测一次」或退出
    this.state = 'done'
    this.progress = 0
    const seconds = DURATION / 1000
    this.cps = (this.count / seconds).toFixed(2)
    this.big = String(this.count)
    this.bigColor = '#0D6EFF'
    this.status = '点击次数'
    this.hint = '点按钮再测一次'
    g.haptic.pattern(2, 160)
  }
}
</script>
