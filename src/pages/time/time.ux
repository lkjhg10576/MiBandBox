<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="剩余时间" clock="{{ clock }}"></pagehead>
    <scroll class="body" scroll-y="true" bounces="true">
      <div class="inner">
        <div class="card c1">
          <text class="f cLabel">本分钟还剩</text>
          <div class="vrow"><text class="f midNum">{{ minuteSec }}</text><text class="f unit">秒</text></div>
          <div class="bar"><div class="fill" style="width: {{ minutePercent }}%;"></div></div>
          <text class="f sub">本分钟已过去 {{ minutePercent }}%</text>
        </div>
        <div class="card c2">
          <text class="f cLabel">本小时还剩</text>
          <text class="f mid">{{ hourText }}</text>
          <div class="bar"><div class="fill" style="width: {{ hourPercent }}%;"></div></div>
          <text class="f sub">本小时已过去 {{ hourPercent }}%</text>
        </div>
        <div class="card c3">
          <text class="f cLabel">今天还剩</text>
          <text class="f big">{{ todayText }}</text>
          <div class="bar"><div class="fill" style="width: {{ dayPercent }}%;"></div></div>
          <text class="f sub">今天已过去 {{ dayPercent }}%</text>
        </div>
        <div class="card c4">
          <text class="f cLabel">本周还剩</text>
          <div class="vrowBig"><text class="f bigNum">{{ weekDays }}</text><text class="f unit">天</text></div>
          <div class="bar"><div class="fill" style="width: {{ weekPercent }}%;"></div></div>
          <text class="f sub">本周已过去 {{ weekPercent }}%</text>
        </div>
        <div class="card c5">
          <text class="f cLabel">今年还剩</text>
          <div class="vrowBig"><text class="f bigNum">{{ yearDays }}</text><text class="f unit">天</text></div>
          <div class="bar"><div class="fill green" style="width: {{ yearPercent }}%;"></div></div>
          <text class="f sub">今年已过去 {{ yearPercent }}%</text>
        </div>
        <text class="f foot">{{ dateText }}</text>
        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 438px; }
.inner { width: 212px; height: 636px; flex-direction: column; }
.card { width: 206px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; }
.c1 { height: 104px; }
.c2 { height: 104px; }
.c3 { height: 116px; }
.c4 { height: 116px; }
.c5 { height: 116px; }
.cLabel { width: 174px; height: 22px; line-height: 22px; font-size: 15px; color: rgba(255,255,255,0.55); }
.mid { width: 174px; height: 40px; line-height: 40px; font-size: 32px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.big { width: 174px; height: 48px; line-height: 48px; font-size: 32px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.vrow { width: 174px; height: 40px; flex-direction: row; align-items: center; }
.vrowBig { width: 174px; height: 48px; flex-direction: row; align-items: center; }
.midNum { height: 40px; line-height: 40px; font-size: 32px; color: #FFFFFF; }
.bigNum { height: 48px; line-height: 48px; font-size: 38px; color: #FFFFFF; }
.unit { font-size: 16px; color: rgba(255,255,255,0.6); margin-left: 6px; }
.bar { width: 174px; height: 6px; border-radius: 3px; background-color: #3A3A3A; margin-top: 4px; margin-bottom: 4px; }
.fill { height: 6px; border-radius: 3px; background-color: #0D6EFF; }
.green { background-color: #00C853; }
.sub { width: 174px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.4); }
.foot { width: 212px; height: 24px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.35); }
.pad { width: 212px; height: 16px; }
</style>

<script>

import g from '../../utils/g'
function hms(sec) {
  const d = g.time.splitDuration(sec)
  return g.time.pad2(d.hours) + ':' + g.time.pad2(d.minutes) + ':' + g.time.pad2(d.seconds)
}

// 分级刷新的边界缓存：小时级/天级字段只在边界变化时才写。
// 放在模块作用域（本页同时只有一个实例）：Vela 页面对象不允许 data 与 private 并存。
let lastHour = null
let lastDay = null

export default {
  data: {
    clock: '--:--',
    minuteSec: 0,
    minutePercent: 0,
    hourText: '--:--',
    hourPercent: 0,
    todayText: '--:--:--',
    dayPercent: 0,
    weekDays: 0,
    weekPercent: 0,
    yearDays: 0,
    yearPercent: 0,
    dateText: '',
    timer: null
  },
  onShow() {
    lastHour = null
    lastDay = null
    this.refresh()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.refresh(), 1000)
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  refresh() {
    const now = new Date()

    // 秒级：恒刷（5 个字段）
    this.clock = g.time.formatClock(now)
    this.minuteSec = g.time.countdownEndOfMinute(now)
    this.minutePercent = Math.min(100, Math.round(((60 - this.minuteSec) / 60) * 100))
    const remainDay = g.time.countdownToEndOfDay(now)
    this.todayText = hms(remainDay)
    this.dayPercent = Math.min(100, Math.round(((86400 - remainDay) / 86400) * 100))

    // 小时级：小时数变化时刷
    const hour = now.getHours()
    if (hour !== lastHour) {
      lastHour = hour
      const remainHour = g.time.countdownEndOfHour(now)
      this.hourText = hms(remainHour).slice(3)
      this.hourPercent = Math.min(100, Math.round(((3600 - remainHour) / 3600) * 100))
    }

    // 天级：跨天时刷
    const dayKey = now.getFullYear() + '-' + now.getMonth() + '-' + now.getDate()
    if (dayKey !== lastDay) {
      lastDay = dayKey
      const remainWeek = g.time.countdownEndOfWeek(now)
      const wd = g.time.splitDuration(remainWeek)
      this.weekDays = wd.days
      this.weekPercent = Math.min(100, Math.round(((7 * 86400 - remainWeek) / (7 * 86400)) * 100))
      const remainYear = g.time.countdownToEndOfYear(now)
      const yd = g.time.splitDuration(remainYear)
      this.yearDays = yd.days
      const total = g.time.isLeap(now.getFullYear()) ? 366 : 365
      const passed = total * 86400 - remainYear
      this.yearPercent = Math.min(100, Math.round((passed / (total * 86400)) * 100))
      this.dateText = now.getFullYear() + '年' + (now.getMonth() + 1) + '月' + now.getDate() + '日'
    }
  }
}
</script>
