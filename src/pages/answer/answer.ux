<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ !awake }}"><text class="napLoadT">加载中…</text></div><div class="napWrap" if="{{ awake }}">
    <pagehead title="答案之书" clock="{{ clock }}"></pagehead>
    <div class="stack" @click="open">
      <div class="sheet s1"></div>
      <div class="sheet s2"></div>
      <div class="sheet s3"></div>
      <div class="cover">
        <img class="book" src="/common/icons/answerBig.png" />
        <text class="f coverT">答案之书</text>
        <text class="f coverS">想一个问题</text>
      </div>
    </div>

    <text class="f hint">摇一摇翻开</text>
    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../common/styles/theme.css';
.stack { position: absolute; left: 0px; top: 96px; width: 212px; height: 300px; align-items: center; justify-content: center; }
.sheet { position: absolute; width: 130px; height: 180px; border-radius: 16px; background-color: #1C2B4A; }
.s1 { left: 28px; top: 58px; transform: rotate(-14deg); background-color: #15233C; }
.s2 { left: 54px; top: 50px; transform: rotate(9deg); background-color: #1A2E52; }
.s3 { left: 40px; top: 54px; transform: rotate(-3deg); background-color: #20365E; }
.cover { position: absolute; left: 32px; top: 42px; width: 148px; height: 204px; border-radius: 18px; background-color: #0D6EFF; align-items: center; justify-content: center; flex-direction: column; }
.book { width: 66px; height: 66px; margin-bottom: 14px; }
.coverT { font-size: 18px; color: #FFFFFF; }
.coverS { font-size: 14px; color: rgba(255,255,255,0.7); }
.hint { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); }
</style>

<script>

import g from '../../utils/g'
import accelHub from '../../utils/accelHub'
import motionCore from '../../utils/motionCore'
import motionShake from '../../utils/motionShake'
import life from '../../utils/pageLife'

// 本页同时只有一个实例：内核与处理器放模块作用域（体感页的既有做法）。
// 页面对象不能同时有 data 与 private（Vela 运行时会抛错），所以不用 private。
let core = null
let shake = null
let myHandler = null   // 挂进 accelHub 的帧消费者（引用存模块级，摘除时传同一个）
let opening = false    // 摇一摇触发 push 的防重入标志

export default life({
  data: { clock: '--:--', timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    // 封面摇一摇 = 翻开（apps.js 描述「摇一摇 · 看答案」）：每次进页换新内核
    core = motionCore.createMotionCore({})
    shake = motionShake.createShake({})
    opening = false
    // 订阅由本页（栈底传感器页）持有：注册一次后帧持续投递，经 accelHub 的消费者槽
    // 转发给当前可见页（封面自己或答案页）。本页 hide 时绝不退订 —— 答案页全靠
    // 这份订阅，且全局退订异步落定会误杀别的注册（E2E 实测，见 accelHub 注释）
    accelHub.ensureSubscribed()
    myHandler = (ret) => {
      if (!core || !shake) return
      const t = Date.now()
      const snap = core.feed(ret.x || 0, ret.y || 0, ret.z || 0, t)
      const events = shake.feed(snap, t)
      for (let i = 0; i < events.length; i++) {
        page.handle(events[i])
      }
    }
    accelHub.setConsumer(myHandler)
  },
  onHide() {
    // 只摘自己的消费者：被 a1 盖住时槽已是 a1 的（引用不同摘不动），
    // 这里防的是「页头返回回首页」路径 —— 回首页后没人消费帧，封面内核休眠
    accelHub.clearConsumer(myHandler)
    myHandler = null
    core = null
    shake = null
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    accelHub.clearConsumer(myHandler)
    accelHub.unsubscribe()
    core = null
    shake = null
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  handle(ev) {
    if (!ev || ev.type !== 'shake' || !this.$valid) return
    this.open()
  },
  open() {
    if (opening) return
    opening = true
    g.haptic.short()
    // 翻开即离开本页：消费者槽由 a1.onShow 接管；本页内核在 onHide 休眠。
    // 摇一摇路径下本页不另开静默窗 —— a1 接管前 refractory 1.2s + opening
    // 防重入已经挡住了马达共振与同摇余波
    g.router.push('/pages/answer/a1')
  }
})
</script>
