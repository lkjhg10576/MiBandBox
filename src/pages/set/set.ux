<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="设置" clock="{{ clock }}"></pagehead>
    <scroll class="body" scroll-y="true" bounces="true">
      <div class="inner" style="height: {{ innerH }}px;">
        <div class="card" @click="goStyle">
          <div class="cardTop">
            <text class="f cTitle">首页样式</text>
            <text class="f arrow">></text>
          </div>
          <text class="f cSub">{{ layoutText }}</text>
        </div>
        <div class="card" style="background-color: {{ catOn ? 'rgba(13,110,255,0.24)' : '#262626' }};" @click="toggleCat">
          <div class="cardTop">
            <text class="f cTitle">工具分类</text>
            <text class="f swState" style="color: {{ catOn ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ catOn ? '开' : '关' }}</text>
          </div>
          <text class="f cSub">{{ catHint }}</text>
        </div>
        <div class="card" @click="goHide">
          <div class="cardTop">
            <text class="f cTitle">隐藏功能</text>
            <text class="f arrow">></text>
          </div>
          <text class="f cSub">{{ hideCountText }}</text>
        </div>
        <div class="card" style="background-color: {{ todayAuto ? 'rgba(13,110,255,0.24)' : '#262626' }};" @click="toggleToday">
          <div class="cardTop">
            <text class="f cTitle">目标日不常驻</text>
            <text class="f swState" style="color: {{ todayAuto ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ todayAuto ? '开' : '关' }}</text>
          </div>
          <text class="f cSub">{{ todayHint }}</text>
        </div>
        <div class="card" @click="goAbout">
          <div class="cardTop">
            <text class="f cTitle">关于 BandBox</text>
            <text class="f arrow">></text>
          </div>
          <text class="f cSub">版本 0.1.3</text>
        </div>
        <div class="card" @click="reset">
          <div class="cardTop">
            <text class="f cTitle" style="color: #FF3B30;">恢复默认设置</text>
            <text class="f arrow">></text>
          </div>
          <text class="f cSub">{{ resetHint }}</text>
        </div>
        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';

/* 卡片六张：内容高 6×(76+8)+48 = 552，超出两机型的 body（band10 418 / Pro 358），
   所以 body 改成 scroll（同 about.ux 的 .body + .inner），别再改回普通 div。
   内容高必须显式写进 .inner（style="height: {{ innerH }}px;"）：Vela 的 scroll 不给内容高
   就按视口高裁 —— 卡片被 flex 压扁（文字挤在一起）、整页滚不动（2026-11-22 修的就是这个）。
   .card / .pad 一律 flex-shrink:0：万一常量与 CSS 对不上，宁可裁掉尾巴也不压扁文字。 */
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 418px; }
.inner { width: 212px; flex-direction: column; }
.card { width: 206px; height: 76px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 11px 16px; flex-direction: column; flex-shrink: 0; }
.cardTop { width: 174px; height: 30px; flex-direction: row; align-items: center; justify-content: space-between; }
.cTitle { font-size: 17px; color: #FFFFFF; }
.arrow { font-size: 20px; color: rgba(255,255,255,0.4); }
/* 开关状态字：与 calculator 的 swRow 同一套写法（内联 style 三元 + 文字「开/关」），不用 <switch> */
.swState { width: 40px; height: 30px; line-height: 30px; text-align: right; font-size: 16px; }
.cSub { width: 174px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.6); text-overflow: ellipsis; lines: 1; }
/* 末尾留白 48px：滚动到底时最后一张卡要完整落在可绘制区内（视口底 500 超出画布底 466） */
.pad { width: 212px; height: 48px; flex-shrink: 0; }
</style>

<script>
import g from '../../utils/g'
import layoutApi from '../../utils/homeLayout'
import layoutFlag from '../../utils/layoutFlag'
import homeToday from '../../utils/homeToday'
import homeTools from '../../utils/homeTools'
import prompt from '@system.prompt'

/**
 * 设置页卡片几何常量：滚动内容高（innerH）= 卡片数 ×(卡高+卡间距) + 末尾留白。
 *
 * 为什么必须显式给内容高：Vela 的 <scroll> 不给子容器高度就按视口高裁内容 ——
 * 卡片被 flex 压扁（文字挤在一起），整页也滚不动（2026-11-22 的 bug）。
 * 三条约束，改任何一条都要同步：
 *   1) CARD_H / CARD_GAP / PAD_H 必须与 CSS 的 .card / .pad 对得上；
 *   2) CARD_COUNT 必须等于模板里 .card 的个数 —— **新增设置项要改这里**；
 *   3) 门禁 R17 会逐条核对（改了卡片忘了改常量，构建直接拦下）。
 */
const CARD_H = 76      // .card 高
const CARD_GAP = 8     // .card 下外边距
const CARD_COUNT = 6   // 模板里的 .card 个数
const PAD_H = 48       // .pad 高：末尾留白，保证滚到底时最后一张卡完整可见
const INNER_H = CARD_COUNT * (CARD_H + CARD_GAP) + PAD_H

/** 布局名：分类单栏 / 单栏列表 / 双栏网格（Pro 的「双栏网格」由 profile 替换成「三栏网格」） */
function layoutName(mode) {
  if (mode === 'cat') return '分类单栏'
  if (mode === 'list') return '单栏列表'
  // grid2 在 Pro 上也显示两栏叫法：拆开拼接，避开本文件的带引号文案替换对
  if (mode === 'grid2') return '双栏' + '网格'
  return '双栏网格'
}

export default {
  data: {
    clock: '--:--',
    layoutText: '双栏网格',
    catOn: false,
    catHint: '首页直接显示全部工具',
    hideCountText: '未隐藏任何工具',
    todayAuto: false,
    todayHint: '首页顶部常驻显示',
    resetHint: '连按两次清空偏好设置',
    resetStep: 0,
    kvDirty: false,
    catBusy: false,
    todayBusy: false,
    innerH: INNER_H,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.catBusy = false
    this.todayBusy = false
    this.kvDirty = false
    const page = this
    homeToday.read((on) => {
      if (!page.$valid) return
      page.applyTodayMode(on)
    })
    homeTools.read((prefs) => {
      if (!page.$valid) return
      const count = (prefs && prefs.hide && prefs.hide.length) || 0
      page.hideCountText = count > 0 ? ('已隐藏 ' + count + ' 个') : '未隐藏任何工具'
    })
    const app = layoutApi.api(this)
    if (app && app.getHomeLayout && app.isHomeLayoutReady && app.isHomeLayoutReady()) {
      this.applyMode(app.getHomeLayout())
    } else {
      g.kv.init(() => {
        // kv.init 是异步读盘：读盘窗口内用户点了开关会被旧值覆盖，kvDirty 挡住回写
        if (!this.$valid || this.kvDirty) return
        this.applyMode(g.kv.get('home', 'grid'))
      })
    }
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  /** 布局模式 → 两张卡的显示字段（首页样式 + 工具分类开关） */
  applyMode(mode) {
    const m = mode === 'cat' ? 'cat' : mode === 'list' ? 'list' : mode === 'grid2' ? 'grid2' : 'grid'
    this.catOn = m === 'cat'
    this.catHint = m === 'cat' ? '首页按类别单栏显示' : '首页直接显示全部工具'
    this.layoutText = layoutName(m)
  },
  goStyle() {
    g.router.push('/pages/hset')
  },
  goHide() {
    g.router.push('/pages/toolhide')
  },
  goAbout() {
    g.router.push('/pages/about')
  },
  /**
   * 工具分类开关：开 = 首页单栏显示 9 个类别；关 = 回到上次记住的网格/列表样式。
   * 「上次样式」存独立的 KV 键 'homeStyle'：关分类不动它，样式页改样式时会同步它。
   */
  toggleCat() {
    if (this.catBusy) return
    this.catBusy = true
    this.kvDirty = true
    const page = this
    g.kv.init(() => {
      if (!page.$valid) return
      const cur = g.kv.get('home', 'grid')
      let mode
      if (cur !== 'cat') {
        // 开：先把当前样式（网格/双栏/列表）记进 homeStyle
        g.kv.set('homeStyle', cur === 'list' ? 'list' : cur === 'grid2' ? 'grid2' : 'grid')
        mode = 'cat'
      } else {
        // 关：回到 homeStyle 记住的样式
        const s = g.kv.get('homeStyle', 'grid')
        mode = s === 'list' ? 'list' : s === 'grid2' ? 'grid2' : 'grid'
      }
      // 三写范式：内存状态 + 启动快标志 + KV（与 hset.pick 同一套）
      const app = layoutApi.api(page)
      if (app && app.setHomeLayout) app.setHomeLayout(mode)
      layoutFlag.write(mode)
      g.kv.set('home', mode)
      g.kv.flush()
      page.applyMode(mode)
      page.catBusy = false
      g.haptic.short()
    })
  },
  /** 目标日不常驻：开 = 没有目标日时首页顶部不显示卡片，列表占满 */
  applyTodayMode(on) {
    this.todayAuto = on === true
    this.todayHint = this.todayAuto ? '无目标日时隐藏卡片' : '首页顶部常驻显示'
  },
  toggleToday() {
    if (this.todayBusy) return
    this.todayBusy = true
    const page = this
    homeToday.toggle((on) => {
      if (!page.$valid) return
      page.applyTodayMode(on)
      page.todayBusy = false
      g.haptic.short()
    })
  },
  reset() {
    if (this.resetStep === 0) {
      this.resetStep = 1
      this.resetHint = '再次点击确认恢复'
      return
    }
    g.kv.reset()
    g.kv.flush()
    // 快标志也要重写：否则「恢复默认后重启」会先按旧标志闪一帧旧布局、再被 KV 纠正
    layoutFlag.write('grid')
    const app = layoutApi.api(this)
    if (app && app.setHomeLayout) {
      app.setHomeLayout('grid')
    }
    this.resetStep = 0
    this.resetHint = '连按两次清空偏好设置'
    this.applyMode('grid')
    this.applyTodayMode(false)
    this.hideCountText = '未隐藏任何工具'
    prompt.showToast({ message: '已恢复默认设置', duration: 1600 })
  }
}
</script>
