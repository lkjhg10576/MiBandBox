<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>
<import name="input-method" src="../../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <pagehead title="重命名" clock="{{ clock }}"></pagehead>
    <div class="card {{ kbShow ? 'cardKb' : '' }}" @click="openKb">
      <text class="f label {{ kbShow ? 'labelKb' : '' }}">新名称</text>
      <text class="f value" if="{{ value }}">{{ value }}</text>
      <text class="f iPlace" if="{{ !value }}">点击输入</text>
    </div>

    <div class="check" show="{{ !kbShow }}" @click="save"><img class="checkImg" src="/common/check.png" /></div>
    <text class="f tip" show="{{ !kbShow }}">名称最多 20 个字</text>

    <backbtn></backbtn>
    <div class="kbBar" show="{{ kbShow }}" @click="closeKb"><text class="f kbBarT">完成</text></div>
    <input-method hide="{{ !kbShow }}" keyboardtype="QWERTY" maxlength="5" vibratemode="short" screentype="pill-shaped" @complete="onKey" @delete="onDel"></input-method>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.card { position: absolute; left: 3px; top: 86px; width: 206px; height: 84px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; }
.cardKb {}
.label { width: 174px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.45); }
.labelKb {}
.value { width: 174px; height: 40px; line-height: 40px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.iPlace { width: 174px; height: 40px; line-height: 40px; font-size: 15px; color: rgba(255,255,255,0.3); text-overflow: ellipsis; lines: 1; }
.check { position: absolute; left: 74px; top: 210px; width: 64px; height: 64px; align-items: center; justify-content: center; }
.checkImg { width: 64px; height: 64px; }
.tip { position: absolute; left: 0px; top: 292px; width: 212px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import g from '../../../utils/g'
import docs from '../../../utils/docs'
import prompt from '@system.prompt'
import textInput from '../../../utils/textInput'

export default {
  protected: { docName: '' },
  private: { clock: '--:--', value: '', oldName: '', kbShow: false, timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.oldName = this.docName
    this.value = this.docName
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  openKb() {
    this.kbShow = true
  },
  closeKb() {
    this.kbShow = false
  },
  onKey(e) {
    const content = e && e.detail && e.detail.content ? e.detail.content : ''
    this.value = textInput.clamp(this.value + content, 20, false)
  },
  onDel() {
    this.value = this.value.slice(0, -1)
  },
  save() {
    this.kbShow = false
    const clean = docs.safeName(this.value)
    if (!clean) {
      prompt.showToast({ message: '名称不能为空', duration: 1400 })
      return
    }
    if (clean === this.oldName) {
      g.router.back()
      return
    }
    docs.exists('notes', clean, (exists) => {
      if (exists) {
        prompt.showToast({ message: '已有同名笔记', duration: 1500 })
        return
      }
      docs.rename('notes', this.oldName, clean, (ok) => {
        if (!ok) {
          prompt.showToast({ message: '重命名失败', duration: 1500 })
          return
        }
        g.haptic.short()
        prompt.showToast({ message: '保存成功', duration: 1200 })
        this.oldName = clean
        g.router.replace('/pages/notebook/list')
      })
    })
  }
}
</script>
