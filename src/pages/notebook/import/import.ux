<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="从手机接收" clock="{{ clock }}"></pagehead>

    <list class="list" bounces="true">
      <list-item type="row" class="card" for="{{ rows }}" @click="onRow($item)">
        <div class="cMain">
          <text class="f cTitle">{{ $item.title }}</text>
          <text class="f cSub">{{ $item.sub }}</text>
        </div>
        <text class="f arrow" if="{{ $item.arrow }}">{{ $item.arrow }}</text>
      </list-item>
      <list-item type="pad" class="pad"></list-item>
    </list>

    <text class="f tip">保持本页打开，在手机插件的「便签」页发送正文即可直达笔记本</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; overflow: hidden; }
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; padding: 0px 3px 0px 3px; }
.card { width: 206px; height: 72px; margin: 0px 0px 8px 0px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 14px 0px 16px; }
.cMain { width: 140px; height: 54px; flex-direction: column; justify-content: center; }
.cTitle { width: 140px; height: 28px; line-height: 28px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 140px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.6); text-overflow: ellipsis; lines: 1; }
.arrow { width: 26px; height: 24px; line-height: 24px; text-align: right; font-size: 20px; color: rgba(255,255,255,0.55); }
.pad { width: 206px; height: 60px; }
.tip { position: absolute; left: 21px; top: 410px; width: 170px; height: 54px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); background-color: #000000; }
</style>

<script>
import g from '../../../utils/g'
import interconnectUtil from '../../../utils/interconnect'
import otpProtocol from '../../../utils/otpProtocol'
import noteProtocol from '../../../utils/noteProtocol'
import noteBridge from '../../../utils/noteBridge'
import docs from '../../../utils/docs'
import prompt from '@system.prompt'
import brightness from '@system.brightness'

const state = {
  timer: null,
  subscriber: null,
  statusSubscriber: null,
  noteSubscriber: null,
  pingId: '',
  lastProbeAt: 0,
  lastHeardAt: 0,
  connected: false,
  timeoutReported: false,
  diagnosing: false
}

function newId(prefix) {
  return prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6)
}

export default {
  data: {
    clock: '--:--',
    rows: [],
    connText: '检测中',
    stateText: '等待手机心跳',
    lastTitle: '',
    totalCount: 0
  },

  onShow() {
    this.clock = g.time.formatClock(new Date())
    state.connected = false
    state.lastHeardAt = Date.now()
    state.lastProbeAt = 0
    state.pingId = ''
    state.timeoutReported = false
    state.diagnosing = false

    this.connText = '检测中'
    this.stateText = '等待手机心跳'

    const recent = noteBridge.getLastNote()
    this.lastTitle = recent ? recent.title : ''

    this.loadCount()
    this.refreshRows()

    this.arm()
    noteBridge.init()
    this.probe()

    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })

    if (state.timer) clearInterval(state.timer)
    state.timer = setInterval(() => {
      if (!this.$valid) return
      this.clock = g.time.formatClock(new Date())
      this.tick()
    }, 5000)
  },

  onHide() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  onDestroy() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  loadCount() {
    docs.list('notes', (arr) => {
      if (!this.$valid) return
      this.totalCount = Array.isArray(arr) ? arr.length : 0
      this.refreshRows()
    })
  },

  refreshRows() {
    const rows = []
    rows.push({
      title: this.connText,
      sub: this.stateText,
      act: ''
    })
    if (this.lastTitle) {
      rows.push({
        title: '已接收：' + this.lastTitle.slice(0, 10),
        sub: '笔记本共 ' + this.totalCount + ' 篇',
        act: 'openLast',
        arrow: '>'
      })
    }
    rows.push({
      title: '重新检测连接',
      sub: '检测手机插件的连接',
      act: 'recheck',
      arrow: '>'
    })
    rows.push({
      title: '返回笔记本',
      sub: '查看全部手机与本地笔记',
      act: 'back',
      arrow: '>'
    })
    this.rows = rows
  },

  arm() {
    if (!state.subscriber) {
      state.subscriber = interconnectUtil.onMessage((text) => {
        if (this.$valid) this.handle(text)
      })
    }
    if (!state.statusSubscriber) {
      state.statusSubscriber = interconnectUtil.onStatus((status) => {
        if (
          status === 1 &&
          !state.connected &&
          state.lastProbeAt > 0 &&
          Date.now() - state.lastProbeAt > 1000
        ) {
          this.probe()
        }
      })
    }
    if (!state.noteSubscriber) {
      state.noteSubscriber = noteBridge.subscribe((entry) => {
        this.onSavedNote(entry)
      })
    }
  },

  disarm() {
    if (state.subscriber) {
      try { state.subscriber() } catch (e) {}
      state.subscriber = null
    }
    if (state.statusSubscriber) {
      try { state.statusSubscriber() } catch (e) {}
      state.statusSubscriber = null
    }
    if (state.noteSubscriber) {
      try { state.noteSubscriber() } catch (e) {}
      state.noteSubscriber = null
    }
  },

  onSavedNote(entry) {
    if (!this.$valid || !entry) return
    this.markConnected()
    this.lastTitle = entry.title || ''
    this.connText = '已接收'
    this.stateText = entry.overwritten ? '已覆盖同名笔记' : '已存入笔记本'
    g.haptic.short()
    prompt.showToast({ message: '已存入「' + this.lastTitle + '」', duration: 1500 })
    this.loadCount()
  },

  probe() {
    state.lastProbeAt = Date.now()
    if (!interconnectUtil.isReady()) interconnectUtil.init()
    if (!interconnectUtil.isReady()) return

    const id = newId('npb')
    state.pingId = id
    const sent = interconnectUtil.send(otpProtocol.pingMessage(id), () => {}, () => {})
    if (!sent) state.pingId = ''
  },

  tick() {
    const now = Date.now()
    if (state.connected) {
      if (now - state.lastHeardAt > 20000) {
        this.markDisconnected('未收到插件心跳')
        this.diagnose()
      }
      return
    }
    if (now - state.lastHeardAt > 12000 && !state.timeoutReported) {
      state.timeoutReported = true
      this.markDisconnected('未收到插件心跳')
      this.diagnose()
    }
    if (now - state.lastProbeAt >= 5000) {
      this.probe()
    }
  },

  markConnected() {
    const was = state.connected
    state.connected = true
    state.lastHeardAt = Date.now()
    state.timeoutReported = false
    state.pingId = ''
    if (!was) {
      this.connText = '已连接手机'
      this.stateText = '插件在线，在手机「便签」页发送即可'
      this.refreshRows()
      g.haptic.short()
    }
  },

  markDisconnected(reason) {
    const was = state.connected
    state.connected = false
    this.connText = '未连接手机'
    this.stateText = reason || '请打开手机插件'
    this.refreshRows()
    if (was) g.haptic.short()
  },

  diagnose() {
    if (state.diagnosing) return
    state.diagnosing = true
    interconnectUtil.diagnosis(3000, (code) => {
      state.diagnosing = false
      if (state.connected || !this.$valid) return
      if (code === 0) this.stateText = '蓝牙已连，插件未响应'
      else if (code === 1001) this.stateText = '未启用手机插件'
      else if (code === 204) this.stateText = '连接超时，请检查蓝牙'
      else if (code) this.stateText = '诊断码 ' + code
      else this.stateText = '请打开手机插件'
      this.refreshRows()
    })
  },

  handle(raw) {
    const n = noteProtocol.parse(raw)
    if (n.ok) {
      if (n.msg.type === 'note_push') this.markConnected()
      return
    }
    const o = otpProtocol.parse(raw)
    if (o.ok) this.markConnected()
  },

  onRow(item) {
    if (item.act === 'openLast' && this.lastTitle) {
      g.haptic.short()
      g.router.push('/pages/notebook/show', { name: this.lastTitle })
      return
    }
    if (item.act === 'recheck') {
      g.haptic.short()
      state.connected = false
      state.lastHeardAt = Date.now()
      state.timeoutReported = false
      this.connText = '检测中'
      this.stateText = '等待手机心跳'
      this.refreshRows()
      state.lastProbeAt = 0
      this.probe()
      return
    }
    if (item.act === 'back') {
      g.haptic.short()
      g.router.back()
    }
  }
}
</script>
