<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="功能设置" clock="{{ clock }}"></pagehead>
    <scroll class="body" scroll-y="true" bounces="true">
      <div class="inner" style="height: {{ innerH }}px;">
        <div class="infoCard">
          <img class="infoIcon" src="{{ tool.icon }}" />
          <div class="infoMeta">
            <text class="f infoName">{{ tool.name }}</text>
            <text class="f infoDesc">{{ tool.desc }}</text>
          </div>
        </div>

        <div class="card" style="background-color: {{ isPin ? 'rgba(13,110,255,0.24)' : '#262626' }};" @click="togglePin">
          <div class="cardTop">
            <text class="f cTitle">功能置顶</text>
            <text class="f swState" style="color: {{ isPin ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ isPin ? '开' : '关' }}</text>
          </div>
          <text class="f cSub">{{ pinSubText }}</text>
        </div>

        <div class="card" style="background-color: {{ isFav ? 'rgba(13,110,255,0.24)' : '#262626' }};" @click="toggleFav">
          <div class="cardTop">
            <text class="f cTitle">功能收藏</text>
            <text class="f swState" style="color: {{ isFav ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ isFav ? '开' : '关' }}</text>
          </div>
          <text class="f cSub">{{ favSubText }}</text>
        </div>

        <div class="card" @click="toggleHide">
          <div class="cardTop">
            <text class="f cTitle" style="color: {{ isHide ? '#FF9500' : '#FF453A' }};">{{ isHide ? '恢复显示' : '隐藏功能' }}</text>
            <text class="f cState" style="color: {{ isHide ? '#FF9500' : 'rgba(255,255,255,0.4)' }};">{{ isHide ? '已隐藏' : '未隐藏' }}</text>
          </div>
          <text class="f cSub">{{ isHide ? '点按恢复在首页与分类中显示' : '隐藏后可在 设置-隐藏功能 恢复' }}</text>
        </div>

        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';

/* 内容高必须显式给（style="height: {{ innerH }}px;"）：Vela 的 scroll 不给内容高就按视口高裁
   —— 卡片被 flex 压扁（文字挤在一起）、整页滚不动。Pro 的视口只有 358px，
   而内容是 348px：只差 10px，再加一张卡就会踩中设置页踩过的那个坑。
   .card / .pad 一律 flex-shrink:0：常量与 CSS 对不上时宁可裁掉尾巴也不压扁文字。 */
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 418px; }
.inner { width: 212px; flex-direction: column; }
.infoCard { width: 206px; height: 72px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #1A1A1A; flex-direction: row; align-items: center; padding: 0px 14px; flex-shrink: 0; }
.infoIcon { width: 34px; height: 34px; margin-right: 10px; }
.infoMeta { width: 134px; height: 52px; flex-direction: column; align-items: flex-start; justify-content: center; }
.infoName { width: 134px; height: 26px; line-height: 26px; text-align: left; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.infoDesc { width: 134px; height: 20px; line-height: 20px; text-align: left; font-size: 14px; color: rgba(255,255,255,0.4); text-overflow: ellipsis; lines: 1; }
.card { width: 206px; height: 76px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 11px 16px; flex-direction: column; flex-shrink: 0; }
.cardTop { width: 174px; height: 30px; flex-direction: row; align-items: center; justify-content: space-between; }
.cTitle { font-size: 17px; color: #FFFFFF; }
/* 开关状态字：与设置页「工具分类」开关同一套写法（整张卡作开关：开=卡底染蓝 + 「开」，
   关=灰底 + 「关」），不用 <switch>。置顶 / 收藏都走这一套，开启状态一眼可见。 */
.swState { width: 40px; height: 30px; line-height: 30px; text-align: right; font-size: 16px; }
.cState { height: 30px; line-height: 30px; text-align: right; font-size: 14px; }
.cSub { width: 174px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.6); text-overflow: ellipsis; lines: 1; }
.pad { width: 212px; height: 16px; flex-shrink: 0; }
</style>

<script>
import g from '../../utils/g'
import apps from '../../data/apps'
import homeTools from '../../utils/homeTools'
import prompt from '@system.prompt'

/**
 * 页面卡片几何常量：滚动内容高（innerH）= 信息卡 + 设置卡 ×个数 + 末尾留白。
 *
 * 为什么必须显式给内容高：Vela 的 <scroll> 不给子容器高度就按视口高裁内容 ——
 * 卡片被 flex 压扁（文字挤在一起），整页也滚不动（设置页 2026-11-22 踩过这个坑）。
 * 约束：常量必须与 CSS 的 .infoCard / .card / .pad 对得上，
 * 且 CARD_COUNT 必须等于模板里 .card 的个数 —— 新增一个设置项要改这里。
 */
const INFO_H = 72       // .infoCard 高
const INFO_GAP = 8      // .infoCard 下外边距
const CARD_H = 76       // .card 高
const CARD_GAP = 8      // .card 下外边距
const CARD_COUNT = 3    // 模板里的 .card 个数（功能置顶 / 功能收藏 / 隐藏功能）
const PAD_H = 16        // .pad 高
const INNER_H = INFO_H + INFO_GAP + CARD_COUNT * (CARD_H + CARD_GAP) + PAD_H

export default {
  protected: { id: '' },
  private: {
    clock: '--:--',
    tool: { id: '', name: '', desc: '', icon: '' },
    isPin: false,
    isFav: false,
    isHide: false,
    pinCount: 0,
    pinSubText: '点按置顶到首页顶部',
    favSubText: '点按加入收藏快捷入口',
    busy: false,
    innerH: INNER_H,
    _ck: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)

    let found = null
    for (let i = 0; i < apps.length; i++) {
      if (apps[i].id === this.id) {
        found = apps[i]
        break
      }
    }
    if (!found) {
      g.router.back()
      return
    }
    this.tool = found

    homeTools.read((prefs) => {
      if (!page.$valid) return
      page.applyPrefs(prefs)
    })
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  applyPrefs(prefs) {
    const pin = (prefs && prefs.pin) || []
    const fav = (prefs && prefs.fav) || []
    const hide = (prefs && prefs.hide) || []

    this.isPin = pin.indexOf(this.id) !== -1
    this.isFav = fav.indexOf(this.id) !== -1
    this.isHide = hide.indexOf(this.id) !== -1
    this.pinCount = pin.length

    this.syncSubText()
  },
  /** 两张开关卡的副标题：开关状态由「开/关」与卡底染色表达，副标题只说明动作与限制 */
  syncSubText() {
    if (this.isHide) {
      this.pinSubText = '请先恢复显示'
      this.favSubText = '请先恢复显示'
      return
    }
    this.pinSubText = this.isPin ? '已置顶 · 首页顶部显示' : (this.pinCount >= 4 ? '最多置顶 4 个' : '点按置顶到首页顶部')
    this.favSubText = this.isFav ? '已加入收藏列表' : '点按加入收藏快捷入口'
  },
  togglePin() {
    if (this.busy) return
    if (this.isHide) {
      prompt.showToast({ message: '已隐藏，请先恢复显示', duration: 1600 })
      return
    }
    this.busy = true
    const page = this
    homeTools.togglePin(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      if (!res.ok && res.reason === 'max') {
        prompt.showToast({ message: '最多置顶 4 个', duration: 1600 })
        return
      }
      g.haptic.short()
      page.isPin = res.active
      page.pinCount = (res.pin && res.pin.length) || 0
      page.syncSubText()
    })
  },
  toggleFav() {
    if (this.busy) return
    if (this.isHide) {
      prompt.showToast({ message: '已隐藏，请先恢复显示', duration: 1600 })
      return
    }
    this.busy = true
    const page = this
    homeTools.toggleFav(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      g.haptic.short()
      page.isFav = res.active
      page.syncSubText()
    })
  },
  toggleHide() {
    if (this.busy) return
    this.busy = true
    const page = this
    homeTools.toggleHide(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      g.haptic.short()
      if (res.hidden) {
        prompt.showToast({ message: '已隐藏，可在 设置-隐藏功能 查看', duration: 1600 })
        page.isHide = true
        page.isPin = false
        page.isFav = false
        page.pinCount = (res.pin && res.pin.length) || 0
      } else {
        prompt.showToast({ message: '已恢复显示', duration: 1600 })
        page.isHide = false
      }
      page.syncSubText()
    })
  }
}
</script>
