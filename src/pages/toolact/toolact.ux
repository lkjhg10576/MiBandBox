<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="功能设置" clock="{{ clock }}"></pagehead>
    <scroll class="body" scroll-y="true" bounces="true">
      <div class="inner">
        <div class="infoCard">
          <img class="infoIcon" src="{{ tool.icon }}" />
          <div class="infoMeta">
            <text class="f infoName">{{ tool.name }}</text>
            <text class="f infoDesc">{{ tool.desc }}</text>
          </div>
        </div>

        <div class="card" @click="togglePin">
          <div class="cardTop">
            <text class="f cTitle">功能置顶</text>
            <text class="f cState" style="color: {{ isPin ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ isPin ? '已置顶' : '未置顶' }}</text>
          </div>
          <text class="f cSub">{{ pinSubText }}</text>
        </div>

        <div class="card" @click="toggleFav">
          <div class="cardTop">
            <text class="f cTitle">功能收藏</text>
            <text class="f cState" style="color: {{ isFav ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ isFav ? '已收藏' : '未收藏' }}</text>
          </div>
          <text class="f cSub">{{ isFav ? '已加入收藏列表 · 点按取消' : '加入首页收藏快捷入口' }}</text>
        </div>

        <div class="card" @click="toggleHide">
          <div class="cardTop">
            <text class="f cTitle" style="color: {{ isHide ? '#FF9500' : '#FF453A' }};">{{ isHide ? '恢复显示' : '隐藏功能' }}</text>
            <text class="f cState" style="color: {{ isHide ? '#FF9500' : 'rgba(255,255,255,0.4)' }};">{{ isHide ? '已隐藏' : '未隐藏' }}</text>
          </div>
          <text class="f cSub">{{ isHide ? '点按恢复在首页与分类中显示' : '隐藏后可在 设置-隐藏功能 恢复' }}</text>
        </div>

        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 418px; }
.inner { width: 212px; flex-direction: column; }
.infoCard { width: 206px; height: 72px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #1A1A1A; flex-direction: row; align-items: center; padding: 0px 14px; }
.infoIcon { width: 34px; height: 34px; margin-right: 10px; }
.infoMeta { width: 134px; height: 52px; flex-direction: column; align-items: flex-start; justify-content: center; }
.infoName { width: 134px; height: 26px; line-height: 26px; text-align: left; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.infoDesc { width: 134px; height: 20px; line-height: 20px; text-align: left; font-size: 14px; color: rgba(255,255,255,0.4); text-overflow: ellipsis; lines: 1; }
.card { width: 206px; height: 76px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 11px 16px; flex-direction: column; }
.cardTop { width: 174px; height: 30px; flex-direction: row; align-items: center; justify-content: space-between; }
.cTitle { font-size: 17px; color: #FFFFFF; }
.cState { height: 30px; line-height: 30px; text-align: right; font-size: 14px; }
.cSub { width: 174px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.6); text-overflow: ellipsis; lines: 1; }
.pad { width: 212px; height: 16px; }
</style>

<script>
import g from '../../utils/g'
import apps from '../../data/apps'
import homeTools from '../../utils/homeTools'
import prompt from '@system.prompt'

export default {
  protected: { id: '' },
  private: {
    clock: '--:--',
    tool: { id: '', name: '', desc: '', icon: '' },
    isPin: false,
    isFav: false,
    isHide: false,
    pinCount: 0,
    pinSubText: '首页最上方显示',
    busy: false,
    _ck: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)

    let found = null
    for (let i = 0; i < apps.length; i++) {
      if (apps[i].id === this.id) {
        found = apps[i]
        break
      }
    }
    if (!found) {
      g.router.back()
      return
    }
    this.tool = found

    homeTools.read((prefs) => {
      if (!page.$valid) return
      page.applyPrefs(prefs)
    })
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  applyPrefs(prefs) {
    const pin = (prefs && prefs.pin) || []
    const fav = (prefs && prefs.fav) || []
    const hide = (prefs && prefs.hide) || []

    this.isPin = pin.indexOf(this.id) !== -1
    this.isFav = fav.indexOf(this.id) !== -1
    this.isHide = hide.indexOf(this.id) !== -1
    this.pinCount = pin.length

    if (this.isPin) {
      this.pinSubText = '首页最上方显示 · 点按取消'
    } else {
      this.pinSubText = this.pinCount >= 4 ? '最多置顶 4 个' : '首页最上方显示'
    }
  },
  togglePin() {
    if (this.busy) return
    this.busy = true
    const page = this
    homeTools.togglePin(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      if (!res.ok && res.reason === 'max') {
        prompt.showToast({ message: '最多置顶 4 个', duration: 1600 })
        return
      }
      g.haptic.short()
      page.isPin = res.active
      page.pinCount = (res.pin && res.pin.length) || 0
      page.pinSubText = page.isPin ? '首页最上方显示 · 点按取消' : (page.pinCount >= 4 ? '最多置顶 4 个' : '首页最上方显示')
    })
  },
  toggleFav() {
    if (this.busy) return
    this.busy = true
    const page = this
    homeTools.toggleFav(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      g.haptic.short()
      page.isFav = res.active
    })
  },
  toggleHide() {
    if (this.busy) return
    this.busy = true
    const page = this
    homeTools.toggleHide(this.id, (res) => {
      page.busy = false
      if (!page.$valid) return
      g.haptic.short()
      if (res.hidden) {
        prompt.showToast({ message: '已隐藏，可在 设置-隐藏功能 查看', duration: 1600 })
        page.isHide = true
        page.isPin = false
        page.isFav = false
      } else {
        prompt.showToast({ message: '已恢复显示', duration: 1600 })
        page.isHide = false
      }
      page.pinSubText = page.isPin ? '首页最上方显示 · 点按取消' : '首页最上方显示'
    })
  }
}
</script>
