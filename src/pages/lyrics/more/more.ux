<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="歌词操作" clock="{{ clock }}"></pagehead>
    <div class="card" @click="edit"><text class="f cT">编辑歌词</text><text class="f arrow">></text></div>
    <div class="card card2" @click="showmode"><text class="f cT">显示方式</text><text class="f arrow">></text></div>
    <div class="card card3" @click="del"><text class="f cT" style="color: #FF6B6B;">{{ delStep === 0 ? '删除歌词' : '再次点击确认删除' }}</text><text class="f arrow" style="color: #FF6B6B;">></text></div>

    <text class="f tip">歌词全部保存在本机</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.card { position: absolute; left: 3px; top: 84px; width: 206px; height: 72px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 18px; }
.card2 { top: 164px; }
.card3 { top: 244px; }
.cT { font-size: 17px; color: #FFFFFF; }
.arrow { font-size: 20px; color: rgba(255,255,255,0.4); }
.tip { position: absolute; left: 0px; top: 340px; width: 212px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import g from '../../../utils/g'
import docs from '../../../utils/docs'
import prompt from '@system.prompt'

export default {
  protected: { name: '' },
  private: { clock: '--:--', delStep: 0, timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.delStep = 0
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  edit() {
    g.router.push('/pages/lyrics/edit', { name: this.name })
  },
  showmode() {
    g.router.push('/pages/lyrics/showmode')
  },
  del() {
    if (this.delStep === 0) {
      this.delStep = 1
      return
    }
    docs.remove('lyrics', this.name, (ok) => {
      g.haptic.long()
      if (ok) {
        prompt.showToast({ message: '删除成功', duration: 1200 })
        g.router.replace('/pages/lylist')
      } else {
        prompt.showToast({ message: '删除失败', duration: 1400 })
      }
    })
  }
}
</script>
