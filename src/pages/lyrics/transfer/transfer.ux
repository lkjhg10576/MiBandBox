<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="从手机传输" clock="{{ clock }}"></pagehead>

    <list class="list" bounces="true">
      <list-item type="row" class="card" for="{{ rows }}" @click="onRow($item)">
        <div class="cMain">
          <text class="f cTitle">{{ $item.title }}</text>
          <text class="f cSub">{{ $item.sub }}</text>
        </div>
        <text class="f arrow" if="{{ $item.arrow }}">{{ $item.arrow }}</text>
      </list-item>
      <list-item type="pad" class="pad"></list-item>
    </list>

    <text class="f tip">保持本页打开，并在手机上打开 AstroBox 的「BandBox歌词同步」插件</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; }
.card { width: 206px; height: 72px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 14px 0px 16px; }
.cMain { width: 140px; height: 54px; flex-direction: column; justify-content: center; }
.cTitle { width: 140px; height: 28px; line-height: 28px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 140px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.6); }
.arrow { width: 26px; height: 24px; line-height: 24px; text-align: right; font-size: 20px; color: rgba(255,255,255,0.4); }
.pad { width: 212px; height: 60px; }
.tip { position: absolute; left: 21px; top: 410px; width: 170px; height: 54px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.35); background-color: #000000; }
</style>

<script>
import g from '../../../utils/g'
import docs from '../../../utils/docs'
import interconnectUtil from '../../../utils/interconnect'
import transfer from '../../../utils/lyricsTransfer'
import prompt from '@system.prompt'
import brightness from '@system.brightness'

/**
 * 页面内部状态：定时器、订阅句柄、分片会话、心跳状态。
 * 这些值不是可序列化的界面数据，放在模块闭包里，
 * 不进入 data 的响应式代理（与 app.ux 的 layoutState 同一思路）。
 */
const state = {
  timer: null,
  subscriber: null,
  statusSubscriber: null,
  session: null,
  pingId: '',
  pingSeq: 0,
  lastProbeAt: 0,
  lastHeardAt: 0,
  connected: false,
  timeoutReported: false,
  diagnosing: false
}

/**
 * 生成心跳 id（不依赖 crypto，手环 JS 环境可用）。
 */
function newId(prefix) {
  return prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6)
}

export default {
  data: {
    clock: '--:--',
    rows: [],
    connText: '检测中',
    stateText: '正在检测手机插件',
    receivedName: '',
    receivedLines: 0
  },

  onShow() {
    this.clock = g.time.formatClock(new Date())
    state.session = transfer.createSession()
    state.connected = false
    // 从进入页面开始给手机插件 12 秒心跳宽限
    state.lastHeardAt = Date.now()
    state.lastProbeAt = 0
    state.pingId = ''
    state.timeoutReported = false
    state.diagnosing = false

    this.connText = '检测中'
    this.stateText = '等待手机心跳'
    this.refreshRows()

    this.arm()
    this.probe()
    this.notifyReady()

    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })

    if (state.timer) clearInterval(state.timer)
    state.timer = setInterval(() => {
      this.clock = g.time.formatClock(new Date())
      this.tick()
    }, 5000)
  },

  onHide() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  onDestroy() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    state.session = null
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  /**
   * 重建列表内容。
   */
  refreshRows() {
    const rows = []
    rows.push({
      title: this.connText,
      sub: this.stateText,
      act: ''
    })
    if (this.receivedName) {
      rows.push({
        title: '已接收：' + this.receivedName,
        sub: '共 ' + this.receivedLines + ' 行，已保存到歌词本',
        act: ''
      })
    }
    rows.push({
      title: '重新检测连接',
      sub: '重新检测与手机插件的连接状态',
      act: 'recheck',
      arrow: '>'
    })
    rows.push({
      title: '返回歌词本',
      sub: '回到歌词列表',
      act: 'back',
      arrow: '>'
    })
    this.rows = rows
  },

  /**
   * 订阅手机消息与连接状态。进入页面时 arm，离开时 disarm（同一时刻只允许一个页面接收）。
   */
  arm() {
    if (state.subscriber) return
    state.subscriber = interconnectUtil.onMessage((text) => {
      this.handle(text)
    })
    state.statusSubscriber = interconnectUtil.onStatus((status) => {
      // 连接刚打开时补一次探测；避免和 onShow 里的 probe 同时发
      if (
        status === 1 &&
        !state.connected &&
        state.lastProbeAt > 0 &&
        Date.now() - state.lastProbeAt > 1000
      ) {
        this.probe()
      }
    })
    // 兼容「刚进页面就收到消息」：只补处理缓存里的歌词推送，
    // 不用缓存的 pong 判断连接（可能是上一次会话的旧消息）
    const cached = interconnectUtil.getLastMessage()
    if (cached) {
      const parsed = transfer.parse(cached)
      if (
        parsed.ok &&
        (parsed.msg.type === 'lyrics' || parsed.msg.type === 'chunk')
      ) {
        this.handle(cached)
      }
    }
  },

  disarm() {
    if (state.subscriber) {
      try {
        state.subscriber()
      } catch (e) {}
      state.subscriber = null
    }
    if (state.statusSubscriber) {
      try {
        state.statusSubscriber()
      } catch (e) {}
      state.statusSubscriber = null
    }
    interconnectUtil.clearLastMessage()
  },

  /**
   * 告知手机端手环已就绪。
   */
  notifyReady() {
    if (!interconnectUtil.isReady()) interconnectUtil.init()
    if (!interconnectUtil.isReady()) return
    interconnectUtil.send(transfer.ready(newId('r')), () => {}, () => {})
  },

  /**
   * 发一次 ping（best-effort）。
   *
   * 部分固件/签名组合下手环→手机方向不可用，因此这里发失败也不判死；
   * 真正的连接状态以手机插件每 5 秒下发的 hello 心跳为准。
   */
  probe() {
    state.lastProbeAt = Date.now()

    // 上次 instance() 失败时允许重试，不再因为 inited 标志永久卡死
    if (!interconnectUtil.isReady()) interconnectUtil.init()
    if (!interconnectUtil.isReady()) return

    state.pingSeq++
    const id = newId('p')
    state.pingId = id
    const sent = interconnectUtil.send(transfer.ping(id), () => {}, () => {})
    if (!sent) {
      // 手环→手机方向不可用时不要立刻判死；手机→手环心跳仍然会到达
      state.pingId = ''
    }
  },

  /**
   * 5 秒一次的定时任务：未连接时继续探测，已连接时检查心跳是否超时。
   */
  tick() {
    const now = Date.now()
    if (state.connected) {
      if (now - state.lastHeardAt > 20000) {
        this.markDisconnected('未收到插件心跳')
        this.diagnose()
      }
      return
    }

    // 进页面后给手机插件 12 秒心跳宽限；超时只提示一次
    if (now - state.lastHeardAt > 12000 && !state.timeoutReported) {
      state.timeoutReported = true
      this.markDisconnected('未收到插件心跳')
      this.diagnose()
    }

    // 即使超时也继续探测，兼容旧版插件/连接恢复
    if (now - state.lastProbeAt >= 5000) {
      this.probe()
    }
  },

  /**
   * 标记已连接手机插件。
   */
  markConnected() {
    const was = state.connected
    state.connected = true
    state.lastHeardAt = Date.now()
    state.timeoutReported = false
    state.pingId = ''
    if (!was) {
      this.connText = '已连接手机'
      this.stateText = '插件在线，等待发送'
      this.refreshRows()
      g.haptic.short()
    }
  },

  /**
   * 标记未连接，并保留具体原因。
   */
  markDisconnected(reason) {
    const was = state.connected
    state.connected = false
    this.connText = '未连接手机'
    this.stateText = reason || '请打开手机插件'
    this.refreshRows()
    if (was) g.haptic.short()
  },

  /**
   * 诊断对端。getReadyState/diagnosis 在 AstroBox 场景下只作为提示，
   * 真正的连接状态以 ping/pong 为准。
   */
  diagnose() {
    if (state.diagnosing) return
    state.diagnosing = true
    interconnectUtil.diagnosis(3000, (code) => {
      state.diagnosing = false
      if (state.connected) return
      if (code === 0) {
        this.stateText = '蓝牙已连，插件未响应'
      } else if (code === 1001) {
        this.stateText = '未启用歌词同步插件'
      } else if (code === 204) {
        this.stateText = '连接超时，请检查蓝牙'
      } else if (code) {
        this.stateText = '诊断码 ' + code
      } else {
        this.stateText = '请打开手机插件'
      }
      this.refreshRows()
    })
  },

  /**
   * 处理一条来自手机的原始消息。
   */
  handle(raw) {
    const parsed = transfer.parse(raw)
    if (!parsed.ok) {
      // 非本协议的消息静默忽略；坏 JSON / 版本不符才回 err
      if (parsed.reason === transfer.ERRORS.BAD_JSON || parsed.reason === transfer.ERRORS.VERSION) {
        this.reply(transfer.err('', parsed.reason))
      }
      return
    }

    const msg = parsed.msg
    const type = msg.type

    if (type === 'pong') {
      this.markConnected()
      return
    }

    if (type === 'ping') {
      this.markConnected()
      this.reply(transfer.pong(msg.id))
      return
    }

    // 收到任何合法协议消息都说明手机插件在线
    this.markConnected()

    if (type === 'hello') {
      this.reply(transfer.pong(msg.id))
      return
    }

    if (type === 'lyrics') {
      const payload = transfer.toLyricsPayload(msg)
      if (!payload.ok) {
        this.reply(transfer.err(msg.id, payload.reason))
        return
      }
      this.save(msg.id, payload.title, payload.text, payload.lines.length)
      return
    }

    if (type === 'chunk') {
      const res = transfer.acceptChunk(state.session, msg)
      if (!res.ok) {
        this.reply(transfer.err(msg.id, res.reason))
        state.session = transfer.createSession()
        return
      }
      if (!res.done) {
        this.reply(transfer.progress(msg.id, res.received, res.total))
        return
      }
      const lines = res.text === '' ? [] : res.text.split('\n')
      // 分片只承载正文，标题随 chunk 元数据单独传递；
      // 落盘仍走「首行标题 + 正文」格式，否则展示页会把首行当标题吃掉。
      const title = res.title || '未命名'
      this.save(msg.id, title, transfer.buildText(title, res.text), lines.length)
      return
    }
  },

  /**
   * 落盘并回执。
   */
  save(id, title, text, count) {
    docs.save('lyrics', title, text, (ok, code, name) => {
      if (!ok) {
        this.connText = '保存失败'
        this.stateText = '错误码 ' + code
        this.refreshRows()
        this.reply(transfer.err(id, transfer.ERRORS.WRITE_FAILED))
        prompt.showToast({ message: '歌词保存失败' })
        g.haptic.short()
        return
      }
      this.receivedName = name
      this.receivedLines = count
      this.connText = '已接收'
      this.stateText = '共 ' + count + ' 行，已保存到歌词本'
      this.refreshRows()
      this.reply(transfer.ack(id, name))
      prompt.showToast({ message: '已接收：' + name })
      g.haptic.short()
      state.session = transfer.createSession()
    })
  },

  /**
   * 回一条消息给手机。
   */
  reply(msg) {
    interconnectUtil.send(msg, () => {}, () => {})
  },

  onRow(item) {
    if (item.act === 'recheck') {
      g.haptic.short()
      // 重新检测时先回到未连接状态，这样收到心跳会触发一次刷新
      state.connected = false
      state.lastHeardAt = Date.now()
      state.timeoutReported = false
      this.connText = '检测中'
      this.stateText = '等待手机心跳'
      this.refreshRows()
      state.lastProbeAt = 0
      this.probe()
      this.notifyReady()
      return
    }
    if (item.act === 'back') {
      g.haptic.short()
      g.router.back()
    }
  }
}
</script>
