<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ awake }}">
    <pagehead title="编辑歌词" clock="{{ clock }}"></pagehead>

    <div class="field {{ active === 'title' ? 'on' : '' }}" @click="openTitle">
      <text class="f fLabel">标题</text>
      <text class="f fTitle" if="{{ title }}">{{ title }}</text>
      <text class="f fPlace" if="{{ !title }}">歌曲名称</text>
    </div>

    <div class="bodyCard {{ active === 'body' ? 'on' : '' }}" @click="openBody">
      <text class="f fLabel">歌词正文 · 支持换行</text>
      <scroll class="bodyScroll" scroll-y="true">
        <text class="f fBody" if="{{ body }}">{{ body }}</text>
        <text class="f fPlace" if="{{ !body }}">逐行输入歌词…</text>
      </scroll>
    </div>

    <text class="f tip">点击标题或正文输入</text>

    <div class="actRow" @click="save"><text class="f actRowT">保存</text></div>
    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../../common/styles/theme.css';
.field { position: absolute; left: 3px; top: 80px; width: 206px; height: 62px; border-radius: 26px; background-color: #262626; padding: 6px 16px; flex-direction: column; border-width: 1px; border-style: solid; border-color: transparent; }
.field.on { border-color: #0D6EFF; }
.bodyCard { position: absolute; left: 3px; top: 150px; width: 206px; height: 100px; border-radius: 26px; background-color: #262626; padding: 6px 16px; flex-direction: column; border-width: 1px; border-style: solid; border-color: transparent; }
.bodyCard.on { border-color: #0D6EFF; }
.fLabel { width: 174px; height: 18px; line-height: 18px; font-size: 14px; color: rgba(255,255,255,0.55); }
.fTitle { width: 174px; height: 32px; line-height: 32px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.fPlace { width: 174px; height: 32px; line-height: 32px; font-size: 15px; color: rgba(255,255,255,0.45); }
.bodyScroll { width: 174px; height: 68px; }
.fBody { width: 174px; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.85); }
.tip { position: absolute; left: 0px; top: 262px; width: 212px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); }
</style>

<script>
import g from '../../../utils/g'
import docs from '../../../utils/docs'
import { parseLyricsDoc } from '../../../utils/lyricsDoc'
import prompt from '@system.prompt'
import inputResult from '../../../utils/inputResult'
import life from '../../../utils/pageLife'

export default life({
  protected: { name: '' },
  private: {
    _ck: null,
    clock: '--:--',
    title: '',
    body: '',
    active: 'title',
    oldName: '',
    loaded: false,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.oldName = this.name || ''
    // 消费 /pages/input 的结果（一次性文件，take 后即删除）：
    // 一次 take 只有一份结果，标题与正文两个字段分支并进同一次 take
    inputResult.take((r) => {
      if (!r || !r.field) return
      if (r.field === 'lyTitle') this.title = r.value
      else if (r.field === 'lyBody') this.body = r.value
    })
    // loaded 标志：磁盘重载只在首次进入时做一次。
    // 从通用输入页返回时 onShow 会再跑一遍，若无此标志就会用盘上的旧标题/正文覆盖刚输入回来的值。
    if (this.name && !this.loaded) {
      this.loaded = true
      docs.read('lyrics', this.name, (text) => {
        // 读失败：docs.read 回调收到 null；给出显式提示而不是留空
        if (text === null || text === undefined) {
          prompt.showToast({ message: '歌词读取失败', duration: 1500 })
          return
        }
        // 与展示页共用同一套解析规则，正文逐行一致
        const doc = parseLyricsDoc(text, this.name)
        this.title = doc.title
        this.body = doc.body
      })
    }
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  openTitle() {
    this.active = 'title'
    g.haptic.short()
    g.router.push('/pages/input', {
      field: 'lyTitle',
      inputTitle: '歌词标题',
      text: this.title,
      max: 20,
      multiline: 0,
      hint: '最多 20 字'
    })
  },
  openBody() {
    this.active = 'body'
    g.router.push('/pages/input', {
      field: 'lyBody',
      inputTitle: '歌词正文',
      text: this.body,
      max: 5000,
      multiline: 1,
      hint: '逐行输入歌词，支持换行'
    })
  },
  save() {
    let name = docs.safeName(this.title)
    if (!name) name = docs.safeName((this.body || '').split('\n')[0] || '未命名歌词')
    if (!name) name = '未命名歌词'
    const text = name + '\n' + this.body
    docs.save('lyrics', name, text, (ok) => {
      if (!ok) {
        prompt.showToast({ message: '保存失败，请重试', duration: 1500 })
        return
      }
      if (this.oldName && this.oldName !== name) docs.remove('lyrics', this.oldName, () => {})
      g.haptic.short()
      prompt.showToast({ message: '保存成功', duration: 1200 })
      g.router.replace('/pages/lylist')
    })
  }
})
</script>
