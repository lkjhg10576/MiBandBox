<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="{{ title }}" clock="{{ clock }}"></pagehead>

    <!-- 竖屏正文 -->
    <scroll id="lyScroll" class="lyScroll" if="{{ mode !== 'h' }}" scroll-y="true">
      <text class="f lyric">{{ body || '（空歌词）' }}</text>
      <div class="pad"></div>
    </scroll>

    <!-- 横屏正文：整块旋转 90°。注意旋转容器与内部滚动容器都用显式像素。 -->
    <div class="lyLandWrap" if="{{ mode === 'h' }}">
      <scroll id="lyScrollLand" class="lyScrollLand" scroll-y="true">
        <text class="f lyricLand">{{ body || '（空歌词）' }}</text>
        <div class="padLand"></div>
      </scroll>
    </div>

    <div class="bar">
      <div class="btn {{ auto ? 'on' : '' }}" @click="toggleAuto"><text class="f btnT">{{ auto ? '自动滚动中' : '自动滚动' }}</text></div>
      <div class="btn dark" @click="more"><text class="f btnT">更多</text></div>
    </div>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
/* 竖屏：绝对定位 + 显式像素 + align-items: flex-start（与 notebook/show / history / morseCode 同款） */
.lyScroll { position: absolute; left: 0px; top: 80px; width: 212px; height: 336px; padding: 0px 12px; align-items: flex-start; }
.lyric { width: 188px; font-size: 18px; line-height: 28px; color: rgba(255,255,255,0.9); }
.pad { width: 188px; height: 40px; }
/* 横屏：520x212 的内容条旋转 90°，铺满 212x520 屏幕。
   旋转中心取左上角（transform-origin: 0 0）+ left:212px：
   旋转后正好落在 (0,0)-(212,520)。若沿用原来的 left:-154px（绕中心旋转），
   元素框会向左溢出页面，被裁剪掉 → 整块不渲染（实测）。 */
.lyLandWrap { position: absolute; left: 212px; top: 0px; width: 520px; height: 212px; transform-origin: 0 0; transform: rotate(90deg); }
.lyScrollLand { width: 520px; height: 212px; padding: 0px 12px; align-items: flex-start; }
/* 正文宽 412px + 左内边距 80px = 492px，正好落在滚动容器 496px 的内容宽度内，
   既给页头让出 80px（旋转后即屏幕顶部），又不会把长句的尾巴裁掉。 */
.lyricLand { width: 412px; padding-left: 80px; font-size: 20px; line-height: 30px; color: rgba(255,255,255,0.9); }
.padLand { width: 412px; height: 40px; padding-left: 80px; }
.bar { position: absolute; left: 18px; top: 420px; width: 176px; height: 44px; flex-direction: row; justify-content: space-between; }
.btn { width: 84px; height: 44px; border-radius: 22px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.btn.on { background-color: #00A846; }
.btn.dark { background-color: #262626; }
.btnT { font-size: 14px; color: #FFFFFF; }
</style>

<script>
import time from '../../../utils/time'
import router from '../../../utils/router'
import docs from '../../../utils/docs'
import { parseLyricsDoc } from '../../../utils/lyricsDoc'
import kv from '../../../utils/kv'
import haptic from '../../../utils/haptic'
import brightness from '@system.brightness'
import prompt from '@system.prompt'

export default {
  protected: { name: '' },
  private: { clock: '--:--', title: '歌词', body: '', mode: 'v', auto: false, timer: null, scrollTimer: null },
  onShow() {
    this.clock = time.formatClock(new Date())
    this.title = this.name || '歌词'
    this.load()
    kv.init(() => {
      this.mode = kv.get('lyricsm', 'v') === 'h' ? 'h' : 'v'
    })
    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
  },
  onHide() {
    this.stopAuto()
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    this.stopAuto()
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  load() {
    if (!this.name) return
    docs.read('lyrics', this.name, (text) => {
      // 读失败：docs.read 回调收到 null；此时给出显式提示，不静默空白
      if (text === null || text === undefined) {
        this.title = this.name || '歌词'
        this.body = ''
        prompt.showToast({ message: '歌词读取失败', duration: 1500 })
        return
      }
      // 与编辑页共用同一套解析规则：首行与文件名一致才算标题，否则首行属于正文
      const doc = parseLyricsDoc(text, this.name)
      this.title = doc.title || this.name || '歌词'
      this.body = doc.body
    })
  },
  toggleAuto() {
    haptic.short()
    if (this.auto) {
      this.stopAuto()
      return
    }
    this.auto = true
    this.scrollTimer = setInterval(() => {
      try {
        const el = this.mode === 'h' ? this.$element('lyScrollLand') : this.$element('lyScroll')
        if (el) el.scrollBy({ top: 3, behavior: 'instant' })
      } catch (e) {}
    }, 260)
  },
  stopAuto() {
    this.auto = false
    if (this.scrollTimer) clearInterval(this.scrollTimer)
    this.scrollTimer = null
  },
  more() {
    this.stopAuto()
    router.push('/pages/lyrics/more', { name: this.name })
  }
}
</script>
