<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="显示方式" clock="{{ clock }}"></pagehead>
    <div class="opt optA {{ mode === 'v' ? 'on' : '' }}" @click="pick('v')">
      <text class="f oT">竖屏</text>
      <text class="f oS">沿手环长边阅读</text>
      <text class="f chk" if="{{ mode === 'v' }}">✓</text>
    </div>
    <div class="opt optB {{ mode === 'h' ? 'on' : '' }}" @click="pick('h')">
      <text class="f oT">横屏</text>
      <text class="f oS">旋转 90°，字更大</text>
      <text class="f chk" if="{{ mode === 'h' }}">✓</text>
    </div>

    <text class="f tip">返回播放页后生效</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.opt { position: absolute; left: 3px; width: 206px; height: 92px; border-radius: 26px; background-color: #262626; padding: 12px 18px; flex-direction: column; }
.optA { top: 92px; }
.optB { top: 200px; }
.opt.on { background-color: rgba(13,110,255,0.24); }
.oT { width: 140px; height: 30px; line-height: 30px; font-size: 17px; color: #FFFFFF; }
.oS { width: 140px; height: 24px; line-height: 24px; font-size: 14px; color: rgba(255,255,255,0.5); }
.chk { position: absolute; right: 16px; top: 18px; font-size: 22px; color: #0D6EFF; }
.tip { position: absolute; left: 0px; top: 320px; width: 212px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>

import g from '../../../utils/g'
export default {
  data: { clock: '--:--', mode: 'v', timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    g.kv.init(() => {
      this.mode = g.kv.get('lyricsm', 'v') === 'h' ? 'h' : 'v'
    })
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  pick(m) {
    this.mode = m
    g.kv.init(() => {
      g.kv.set('lyricsm', m)
      g.kv.flush()
    })
    g.haptic.short()
    g.router.back()
  }
}
</script>
