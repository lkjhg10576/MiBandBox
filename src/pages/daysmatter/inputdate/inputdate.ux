<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="{{ headTitle }}" clock="{{ clock }}"></pagehead>

    <!-- 第一步：选年（单列滚轮，复刻系统定时器“设置 小时”样式） -->
    <picker class="pkYear" if="{{ step === 1 }}" type="text" range="{{ years }}" selected="{{ yi }}" onchange="onYear"></picker>

    <!-- 第二步：选月 / 选日（双列滚轮，复刻“设置 分秒”样式） -->
    <div class="mdRow" if="{{ step === 2 }}">
      <picker class="pkMd" type="text" range="{{ months }}" selected="{{ mi }}" onchange="onMonth"></picker>
      <text class="f sep">/</text>
      <picker class="pkMd" type="text" range="{{ days }}" selected="{{ di }}" onchange="onDay"></picker>
    </div>

    <div class="go" if="{{ step === 1 }}" @click="nextStep"><img class="goImg" src="/common/arrow.png"></img></div>
    <div class="go" if="{{ step === 2 }}" @click="confirm"><img class="goImg" src="/common/arrow.png"></img></div>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
/* 滚轮高度决定可见行数（原版 HyperBox 同页 picker 高 140px、选中行 30px）；非选中行压暗 */
.pkYear { position: absolute; left: 46px; top: 140px; width: 120px; height: 176px; color: rgba(255,255,255,0.35); font-size: 22px; selected-color: #FFFFFF; selected-font-size: 30px; selected-background-color: rgba(255,255,255,0.08); }
.mdRow { position: absolute; left: 0px; top: 140px; width: 212px; height: 176px; flex-direction: row; align-items: center; justify-content: center; }
.pkMd { width: 76px; height: 176px; color: rgba(255,255,255,0.35); font-size: 22px; selected-color: #FFFFFF; selected-font-size: 30px; selected-background-color: rgba(255,255,255,0.08); }
.sep { width: 24px; text-align: center; font-size: 22px; color: rgba(255,255,255,0.35); }
.go { position: absolute; left: 58px; top: 404px; width: 96px; height: 52px; border-radius: 26px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.goImg { width: 28px; height: 28px; }
</style>

<script>
import g from '../../../utils/g'
import pickState from '../pickState'

/**
 * 取 picker 当前选中的下标。
 * 兼容三种事件形态：e.detail.newSelected、e.newSelected、e.detail.index；
 * 若事件只带选中值文本，则回退到 range 里的下标。
 */
function pickIndex(e, range) {
  const detail = e && e.detail ? e.detail : null
  let raw = null
  if (detail && detail.newSelected !== undefined && detail.newSelected !== null) {
    raw = detail.newSelected
  } else if (e && e.newSelected !== undefined && e.newSelected !== null) {
    raw = e.newSelected
  } else if (detail && detail.index !== undefined && detail.index !== null) {
    raw = detail.index
  } else if (detail && typeof detail.value === 'string' && range) {
    const pos = range.indexOf(detail.value)
    if (pos >= 0) return pos
  }
  const num = parseInt(raw, 10)
  return isNaN(num) ? -1 : num
}

export default {
  protected: { date: '' },
  private: {
    _ck: null,
    clock: '--:--',
    headTitle: '设置 年份',
    step: 1,
    years: [],
    months: [],
    days: [],
    yi: 0,
    mi: 0,
    di: 0,
    y: 2026,
    m: 1,
    d: 1,
    timer: null
  },
  onInit() {
    this.clock = g.time.formatClock(new Date())
    const years = []
    for (let y = 1970; y <= 2100; y++) years.push(String(y))
    const months = []
    for (let m = 1; m <= 12; m++) months.push(String(m))
    this.years = years
    this.months = months
    const base = g.time.parseDate(this.date) || new Date()
    this.y = base.getFullYear()
    this.m = base.getMonth() + 1
    this.d = base.getDate()
    this.yi = this.y - 1970
    this.mi = this.m - 1
    this.buildDays()
  },
  onShow() {
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  buildDays() {
    const max = g.time.daysInMonth(this.y, this.m)
    const days = []
    for (let i = 1; i <= max; i++) days.push(String(i))
    this.days = days
    // 换月后天数变化，重算并把日夹紧到当月最大值
    if (this.d > max) this.d = max
    this.di = this.d - 1
  },
  onYear(e) {
    const idx = pickIndex(e, this.years)
    if (idx < 0) return
    this.yi = idx
    this.y = 1970 + idx
    this.buildDays()
    g.haptic.short()
  },
  onMonth(e) {
    const idx = pickIndex(e, this.months)
    if (idx < 0) return
    this.mi = idx
    this.m = idx + 1
    this.buildDays()
    g.haptic.short()
  },
  onDay(e) {
    const idx = pickIndex(e, this.days)
    if (idx < 0) return
    this.di = idx
    this.d = idx + 1
    g.haptic.short()
  },
  nextStep() {
    this.step = 2
    this.headTitle = '设置 月日'
    g.haptic.short()
  },
  confirm() {
    const str = this.y + '-' + g.time.pad2(this.m) + '-' + g.time.pad2(this.d)
    pickState.date = str
    g.haptic.short()
    g.router.back()
  }
}
</script>
