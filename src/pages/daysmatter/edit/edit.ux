<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>
<import name="input-method" src="../../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <pagehead title="目标日" clock="{{ clock }}"></pagehead>

    <div class="card {{ kbShow ? 'cardKb' : '' }}" @click="openKb">
      <text class="f label {{ kbShow ? 'labelKb' : '' }}">事件名称</text>
      <text class="f value" if="{{ title }}">{{ title }}</text>
      <text class="f iPlace" if="{{ !title }}">例如：考试、生日、旅行</text>
    </div>

    <div class="card card2" show="{{ !kbShow }}" @click="pickDate">
      <text class="f label">日期</text>
      <text class="f value" style="color: #0D6EFF;">{{ date }}</text>
    </div>

    <text class="f delta" show="{{ !kbShow }}">{{ deltaText }}</text>

    <div class="del" show="{{ !kbShow }}" @click="del"><text class="f delT">{{ delStep === 0 ? '删除这个目标日' : '再次点击确认删除' }}</text></div>

    <div class="save" @click="save"><text class="f saveT">保存</text></div>
    <backbtn></backbtn>
    <div class="kbBar" show="{{ kbShow }}" @click="closeKb"><text class="f kbBarT">完成</text></div>
    <input-method hide="{{ !kbShow }}" keyboardtype="QWERTY" maxlength="5" vibratemode="short" screentype="pill-shaped" @complete="onKey" @delete="onDel"></input-method>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.save { position: absolute; left: 146px; top: 42px; width: 32px; height: 28px; border-radius: 14px; background-color: #0D6EFF; align-items: center; justify-content: center; z-index: 99; }
.saveT { font-size: 14px; color: #FFFFFF; z-index: 99; }
.card { position: absolute; left: 3px; top: 82px; width: 206px; height: 76px; border-radius: 26px; background-color: #262626; padding: 8px 16px; flex-direction: column; }
.cardKb {}
.card2 { top: 168px; }
.label { width: 174px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.45); }
.labelKb {}
.value { width: 174px; height: 38px; line-height: 38px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.iPlace { width: 174px; height: 38px; line-height: 38px; font-size: 15px; color: rgba(255,255,255,0.3); text-overflow: ellipsis; lines: 1; }
.delta { position: absolute; left: 0px; top: 258px; width: 212px; text-align: center; font-size: 15px; color: rgba(255,255,255,0.55); }
.del { position: absolute; left: 48px; top: 330px; width: 116px; height: 34px; border-radius: 17px; background-color: rgba(255,59,48,0.14); align-items: center; justify-content: center; }
.delT { font-size: 14px; color: #FF6B6B; }
</style>

<script>
import g from '../../../utils/g'
import prompt from '@system.prompt'
import textInput from '../../../utils/textInput'
import pickState from '../pickState'
import homeEvents from '../../../utils/homeEvents'

const PATH = 'internal://files/bandbox/events.json'
const DIR = 'internal://files/bandbox/'

export default {
  protected: { id: '' },
  private: {
    _ck: null,
    clock: '--:--',
    title: '',
    date: '',
    deltaText: '保存后会显示倒计时',
    delStep: 0,
    list: [],
    loaded: false,
    kbShow: false,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.delStep = 0
    if (!this.loaded) {
      this.loaded = true
      this.date = g.time.todayKey()
      this.load()
    } else {
      this.applyPickedDate()
    }
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  load() {
    g.fs.readText(PATH, (text) => {
      let list = []
      try {
        list = text ? JSON.parse(text) : []
      } catch (e) {
        list = []
      }
      if (!Array.isArray(list)) list = []
      this.list = list
      this.loaded = true
      if (this.id) {
        const found = list.filter((it) => String(it.id) === String(this.id))[0]
        if (found) {
          this.title = found.title
          this.date = found.date
          this.refreshDelta()
        }
      }
    })
  },
  refreshDelta() {
    if (!this.date) return
    const d = g.time.parseDate(this.date)
    if (!d) return
    const h = g.time.humanDelta(this.date)
    this.deltaText = this.date + ' · ' + g.time.weekdayName(d) + ' · ' + h.text
  },
  applyPickedDate() {
    const picked = pickState.date
    if (picked) {
      this.date = picked
      pickState.date = ''
      this.refreshDelta()
    }
  },
  openKb() {
    this.kbShow = true
  },
  closeKb() {
    this.kbShow = false
  },
  onKey(e) {
    const content = e && e.detail && e.detail.content ? e.detail.content : ''
    this.title = textInput.clamp(this.title + content, 20, false)
  },
  onDel() {
    this.title = this.title.slice(0, -1)
  },
  pickDate() {
    pickState.date = ''
    g.router.push('/pages/daysmatter/inputdate', { date: this.date })
  },
  save() {
    this.kbShow = false
    const title = this.title.trim()
    if (!title) {
      prompt.showToast({ message: '请填写事件名称', duration: 1400 })
      return
    }
    if (!g.time.parseDate(this.date)) {
      prompt.showToast({ message: '日期无效', duration: 1400 })
      return
    }
    const list = this.list.slice()
    const id = this.id || String(Date.now())
    let found = false
    const next = list.map((it) => {
      if (String(it.id) === String(id)) {
        found = true
        return { id, title, date: this.date, createdAt: it.createdAt || Date.now() }
      }
      return it
    })
    if (!found) next.push({ id, title, date: this.date, createdAt: Date.now() })
    g.fs.ensureDir(DIR, () => {
      g.fs.writeText(PATH, JSON.stringify(next), (ok) => {
        if (!ok) {
          prompt.showToast({ message: '保存失败，请重试', duration: 1500 })
          return
        }
        g.haptic.short()
        homeEvents.invalidate()
        prompt.showToast({ message: '事件保存成功！', duration: 1300 })
        g.router.back()
      })
    })
  },
  del() {
    if (!this.id) {
      g.router.back()
      return
    }
    if (this.delStep === 0) {
      this.delStep = 1
      return
    }
    const next = this.list.filter((it) => String(it.id) !== String(this.id))
    g.fs.writeText(PATH, JSON.stringify(next), (ok) => {
      g.haptic.long()
      if (!ok) {
        prompt.showToast({ message: '删除失败', duration: 1400 })
        return
      }
      homeEvents.invalidate()
      prompt.showToast({ message: '已删除', duration: 1200 })
      g.router.replace('/pages/daysmatter/list')
    })
  }
}
</script>
