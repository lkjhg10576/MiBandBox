<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="目标日" clock="{{ clock }}"></pagehead>
    <list class="list" bounces="true">
      <list-item type="event" class="card" for="{{ items }}" @click="open($item)">
        <div class="cMain">
          <text class="f cTitle">{{ $item.title }}</text>
          <text class="f cSub">{{ $item.date }}</text>
        </div>
        <text class="f delta" style="color: {{ $item.color }};">{{ $item.delta }}</text>
      </list-item>
      <list-item type="empty" class="empty" if="{{ items.length === 0 }}">
        <img class="emptyImg" src="/common/empty.png" />
        <text class="f emptyT">还没有目标日</text>
        <text class="f emptyS">记下考试、纪念日或旅行</text>
      </list-item>
      <list-item type="pad" class="pad"></list-item>
    </list>

    <img class="plus" src="/common/plus.png" @click="create" />
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
/* 列表项不留横向 margin：原生 list 会把子项 margin 计入可横向滚动范围（3px 边距即产生可拖动空间，抢占右滑返回），内缩改由 list 自身 padding 提供。 */
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; padding: 0px 3px 0px 3px; }
.card { width: 206px; height: 76px; margin: 0px 0px 8px 0px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 14px 0px 16px; }
.cMain { width: 90px; height: 52px; flex-direction: column; justify-content: center; }
.cTitle { width: 90px; height: 26px; line-height: 26px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 90px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.4); }
.delta { width: 86px; text-align: right; font-size: 14px; lines: 1; }
.empty { width: 206px; height: 320px; align-items: center; justify-content: center; flex-direction: column; }
.emptyImg { width: 80px; height: 80px; margin-bottom: 12px; }
.emptyT { font-size: 17px; color: #FFFFFF; }
.emptyS { font-size: 14px; color: rgba(255,255,255,0.4); }
.pad { width: 206px; height: 110px; }
.plus { position: absolute; left: 132px; top: 396px; width: 64px; height: 64px; }
</style>

<script>

import g from '../../../utils/g'
const PATH = 'internal://files/bandbox/events.json'

export default {
  data: { clock: '--:--', items: [], timer: null },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.load()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  load() {
    g.fs.readText(PATH, (text) => {
      let list = []
      try {
        list = text ? JSON.parse(text) : []
      } catch (e) {
        list = []
      }
      if (!Array.isArray(list)) list = []
      const mapped = list
        .filter((it) => it && it.date && it.title)
        .map((it) => {
          const d = g.time.humanDelta(it.date)
          return {
            id: it.id || it.date + it.title,
            title: it.title,
            date: it.date,
            delta: d.text,
            abs: Math.abs(d.days),
            color: d.status === 'today' ? '#00C853' : d.status === 'future' ? '#0D6EFF' : 'rgba(255,255,255,0.45)'
          }
        })
        .sort((a, b) => a.abs - b.abs)
      this.items = mapped
    })
  },
  open(item) {
    g.router.push('/pages/daysmatter/edit', { id: item.id })
  },
  create() {
    g.haptic.short()
    g.router.push('/pages/daysmatter/edit', { id: '' })
  }
}
</script>
