<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="振动器" clock="{{ clock }}"></pagehead>
    <div class="modes">
      <div class="mode" style="background-color: {{ mode === 'short' ? '#0D6EFF' : 'transparent' }};" @click="setMode('short')"><text class="f modeT">短振</text></div>
      <div class="mode" style="background-color: {{ mode === 'long' ? '#0D6EFF' : 'transparent' }};" @click="setMode('long')"><text class="f modeT">长振</text></div>
      <div class="mode" style="background-color: {{ mode === 'rhythm' ? '#0D6EFF' : 'transparent' }};" @click="setMode('rhythm')"><text class="f modeT">节奏</text></div>
    </div>

    <text class="f label">脉冲间隔</text>
    <div class="chips">
      <div class="chip {{ gap === 200 ? 'on' : '' }}" @click="setGap(200)"><text class="f chipT">200ms</text></div>
      <div class="chip {{ gap === 500 ? 'on' : '' }}" @click="setGap(500)"><text class="f chipT">500ms</text></div>
      <div class="chip {{ gap === 1000 ? 'on' : '' }}" @click="setGap(1000)"><text class="f chipT">1s</text></div>
    </div>

    <div class="visual">
      <div class="wave" for="{{ bars }}" style="height: {{ $item }}px; background-color: {{ playing ? '#0D6EFF' : '#333333' }};"></div>
    </div>

    <div class="go {{ playing ? 'stop' : '' }}" @click="toggle">
      <text class="f goT">{{ playing ? '停止' : '开始振动' }}</text>
    </div>
    <text class="f hint">{{ hint }}</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.modes { position: absolute; left: 6px; top: 84px; width: 200px; height: 44px; flex-direction: row; border-radius: 22px; background-color: #1A1A1A; padding: 3px; }
.mode { flex: 1; height: 38px; border-radius: 19px; align-items: center; justify-content: center; }
.mode.on { background-color: #0D6EFF; }
.modeT { font-size: 14px; color: #FFFFFF; }
.label { position: absolute; left: 12px; top: 148px; width: 100px; font-size: 14px; color: rgba(255,255,255,0.5); }
.chips { position: absolute; left: 6px; top: 174px; width: 200px; height: 40px; flex-direction: row; justify-content: space-between; }
.chip { width: 62px; height: 36px; border-radius: 18px; background-color: #262626; align-items: center; justify-content: center; }
.chip.on { background-color: rgba(13,110,255,0.3); }
.chipT { font-size: 14px; color: #FFFFFF; }
.visual { position: absolute; left: 16px; top: 240px; width: 180px; height: 100px; flex-direction: row; align-items: center; justify-content: space-between; }
.wave { width: 8px; border-radius: 4px; }
.go { position: absolute; left: 26px; top: 378px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.go.stop { background-color: #FF3B30; }
.goT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 16px; top: 436px; width: 180px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.35); }
</style>

<script>
import time from '../../utils/time'
import haptic from '../../utils/haptic'

const BARS = [18, 34, 58, 80, 62, 40, 72, 92, 54, 30, 66, 44, 24]

export default {
  data: {
    clock: '--:--',
    mode: 'short',
    gap: 500,
    playing: false,
    bars: BARS,
    hint: '短振每隔一段时间触发一次',
    timer: null,
    clockTimer: null,
    step: 0
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    if (this.clockTimer) clearInterval(this.clockTimer)
    this.clockTimer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
  },
  onHide() {
    this.stop()
  },
  onDestroy() {
    this.stop()
    if (this.clockTimer) clearInterval(this.clockTimer)
    this.clockTimer = null
  },
  setMode(m) {
    this.mode = m
    this.hint = m === 'short' ? '短振每隔一段时间触发一次' : m === 'long' ? '长振会有明显的持续感' : '短长短的节奏循环'
    if (this.playing) {
      this.stop()
      this.start()
    }
  },
  setGap(g) {
    this.gap = g
    if (this.playing) {
      this.stop()
      this.start()
    }
  },
  toggle() {
    if (this.playing) this.stop()
    else this.start()
  },
  start() {
    this.playing = true
    this.step = 0
    const tick = () => {
      if (!this.playing) return
      this.step++
      this.animate()
      if (this.mode === 'short') haptic.short()
      else if (this.mode === 'long') haptic.long()
      else {
        if (this.step % 3 === 0) haptic.long()
        else haptic.short()
      }
    }
    tick()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(tick, this.gap)
  },
  stop() {
    this.playing = false
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    haptic.stop()
    this.bars = BARS
  },
  animate() {
    const list = []
    for (let i = 0; i < BARS.length; i++) {
      const base = BARS[(i + this.step) % BARS.length]
      list.push(base)
    }
    this.bars = list
  }
}
</script>
