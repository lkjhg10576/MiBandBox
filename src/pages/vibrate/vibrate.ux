<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="振动器" clock="{{ clock }}"></pagehead>
    <div class="modes">
      <div class="mode" style="background-color: {{ mode === 'short' ? '#0D6EFF' : 'transparent' }};" @click="setMode('short')"><text class="f modeT">短振</text></div>
      <div class="mode" style="background-color: {{ mode === 'long' ? '#0D6EFF' : 'transparent' }};" @click="setMode('long')"><text class="f modeT">长振</text></div>
      <div class="mode" style="background-color: {{ mode === 'rhythm' ? '#0D6EFF' : 'transparent' }};" @click="setMode('rhythm')"><text class="f modeT">节奏</text></div>
    </div>

    <text class="f label">脉冲间隔</text>
    <div class="gaps">
      <div class="gap" style="background-color: {{ gap === 200 ? '#0D6EFF' : 'transparent' }};" @click="setGap(200)"><text class="f gapT">200ms</text></div>
      <div class="gap" style="background-color: {{ gap === 500 ? '#0D6EFF' : 'transparent' }};" @click="setGap(500)"><text class="f gapT">500ms</text></div>
      <div class="gap" style="background-color: {{ gap === 1000 ? '#0D6EFF' : 'transparent' }};" @click="setGap(1000)"><text class="f gapT">1s</text></div>
    </div>
    <text class="f cur">当前间隔：{{ gap === 1000 ? '1 秒' : gap + ' 毫秒' }}</text>

    <div class="visual">
      <div class="wave" for="{{ bars }}" style="height: {{ $item }}px; background-color: {{ playing ? '#0D6EFF' : '#333333' }};"></div>
    </div>

    <div class="go {{ playing ? 'stop' : '' }}" @click="toggle">
      <text class="f goT">{{ playing ? '停止' : '开始振动' }}</text>
    </div>
    <text class="f hint">{{ hint }}</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.modes { position: absolute; left: 6px; top: 84px; width: 200px; height: 44px; flex-direction: row; border-radius: 22px; background-color: #1A1A1A; padding: 3px; }
.mode { flex: 1; height: 38px; border-radius: 19px; align-items: center; justify-content: center; }
.mode.on { background-color: #0D6EFF; }
.modeT { font-size: 14px; color: #FFFFFF; }
.label { position: absolute; left: 12px; top: 144px; width: 100px; font-size: 14px; color: rgba(255,255,255,0.5); }
.gaps { position: absolute; left: 6px; top: 170px; width: 200px; height: 44px; flex-direction: row; border-radius: 22px; background-color: #1A1A1A; padding: 3px; }
.gap { flex: 1; height: 38px; border-radius: 19px; align-items: center; justify-content: center; }
.gapT { font-size: 14px; color: #FFFFFF; }
.cur { position: absolute; left: 0px; top: 222px; width: 212px; text-align: center; font-size: 14px; color: #0D6EFF; }
.visual { position: absolute; left: 16px; top: 244px; width: 180px; height: 96px; flex-direction: row; align-items: center; justify-content: space-between; }
.wave { width: 8px; border-radius: 4px; }
.go { position: absolute; left: 26px; top: 378px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.go.stop { background-color: #FF3B30; }
.goT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 16px; top: 436px; width: 180px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.35); }
</style>

<script>

import g from '../../utils/g'
const BARS = [18, 34, 58, 80, 62, 40, 72, 92, 54, 30, 66, 44, 24]
// 双缓冲：animate() 原地改写备用数组再交换引用，避免每次 tick 新建数组。
// 注意：Vela 运行时不允许页面对象同时出现 data 与 private（非响应式字段请整页改用 private），
// 因此缓冲数组放在模块作用域，不进 data。
let BUF_A = BARS.slice()
let BUF_B = BARS.slice()

export default {
  data: {
    _ck: null,
    clock: '--:--',
    mode: 'short',
    gap: 500,
    playing: false,
    bars: BARS.slice(),
    hint: '短振每隔一段时间触发一次',
    timer: null,
    clockTimer: null,
    step: 0
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  setMode(m) {
    this.mode = m
    this.hint = m === 'short' ? '短振每隔一段时间触发一次' : m === 'long' ? '长振会有明显的持续感' : '短长短的节奏循环'
    if (this.playing) {
      this.stop()
      this.start()
    }
  },
  setGap(v) {
    g.haptic.short()
    this.gap = v
    if (this.playing) {
      this.stop()
      this.start()
    }
  },
  toggle() {
    if (this.playing) this.stop()
    else this.start()
  },
  start() {
    this.playing = true
    this.step = 0
    const tick = () => {
      if (!this.playing) return
      this.step++
      this.animate()
      if (this.mode === 'short') g.haptic.short()
      else if (this.mode === 'long') g.haptic.long()
      else {
        if (this.step % 3 === 0) g.haptic.long()
        else g.haptic.short()
      }
    }
    tick()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(tick, this.gap)
  },
  stop() {
    this.playing = false
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    g.haptic.stop()
    this.bars = BARS.slice()
  },
  animate() {
    // 原地更新：写进备用数组再交换引用，既不新建数组也能触发模板刷新
    const src = this.bars
    const dst = src === BUF_A ? BUF_B : BUF_A
    for (let i = 0; i < src.length; i++) {
      dst[i] = BARS[(i + this.step) % BARS.length]
    }
    this.bars = dst
  }
}
</script>
