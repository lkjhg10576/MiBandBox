<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="跑马灯" clock="{{ clock }}"></pagehead>
    <div class="preview" style="background-color: {{ bg }};">
      <marquee class="f mq" scrollamount="6" text-offset="30" style="color: {{ color }}; font-size: {{ size }}px;">{{ text }}</marquee>
    </div>

    <div class="card card2" @click="edit">
      <text class="f cTitle">编辑内容</text>
      <text class="f arrow">></text>
    </div>
    <div class="card card3" @click="play">
      <text class="f cTitle">全屏播放</text>
      <text class="f arrow">></text>
    </div>

    <div class="go" @click="play"><text class="f goT">开始播放</text></div>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.preview { position: absolute; left: 3px; top: 78px; width: 206px; height: 84px; border-radius: 26px; align-items: center; }
.mq { width: 190px; height: 60px; line-height: 60px; }
.card { position: absolute; left: 3px; width: 206px; height: 72px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 16px; }
.card2 { top: 178px; }
.card3 { top: 258px; }
.cTitle { width: 160px; font-size: 17px; color: #FFFFFF; }
.cSub { width: 70px; font-size: 14px; color: rgba(255,255,255,0.4); }
.arrow { width: 16px; text-align: right; font-size: 20px; color: rgba(255,255,255,0.4); }
.go { position: absolute; left: 26px; top: 382px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.goT { font-size: 14px; color: #FFFFFF; }
</style>

<script>
import time from '../../utils/time'
import kv from '../../utils/kv'
import router from '../../utils/router'

export default {
  data: {
    clock: '--:--',
    text: 'BandBox · 手腕上的百宝箱',
    size: 28,
    speed: 6,
    color: '#FFFFFF',
    bg: '#0D6EFF',
    timer: null
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
    kv.init(() => {
      const m = kv.get('marquee', null)
      if (m) {
        this.text = m.text || this.text
        this.size = m.size || this.size
        this.speed = m.speed || this.speed
        this.color = m.color || this.color
        this.bg = m.bg || this.bg
      }
    })
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  edit() {
    router.push('/pages/marqueeSet')
  },
  play() {
    router.push('/pages/textShow', {
      text: this.text,
      size: this.size,
      speed: this.speed,
      color: this.color,
      bg: this.bg
    })
  }
}
</script>
