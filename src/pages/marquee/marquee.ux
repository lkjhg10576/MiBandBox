<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="跑马灯" clock="{{ clock }}"></pagehead>
    <!-- 预览用静态文字（与设置页一致）：播放页用的是横向滚动实现，
         这里不滚动才不会让人误以为播放效果是静止的。 -->
    <div class="preview" style="background-color: {{ bg }};">
      <text class="f pv" style="color: {{ color }}; font-size: {{ size }}px;">{{ text }}</text>
    </div>

    <div class="card card2" @click="edit">
      <text class="f cTitle">编辑内容</text>
      <text class="f arrow">></text>
    </div>
    <div class="card card3" @click="play('v')">
      <text class="f cTitle">竖屏播放</text>
      <text class="f arrow">></text>
    </div>
    <div class="card card4" @click="play('h')">
      <text class="f cTitle">横屏播放</text>
      <text class="f arrow">></text>
    </div>

    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.preview { position: absolute; left: 3px; top: 78px; width: 206px; height: 84px; border-radius: 26px; align-items: center; justify-content: center; }
.pv { width: 190px; text-align: center; text-overflow: ellipsis; lines: 1; }
.card { position: absolute; left: 3px; width: 206px; height: 72px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 16px; }
.card2 { top: 178px; }
.card3 { top: 258px; }
.card4 { top: 338px; }
.cTitle { width: 160px; font-size: 17px; color: #FFFFFF; }
.arrow { width: 16px; text-align: right; font-size: 20px; color: rgba(255,255,255,0.4); }
</style>

<script>
import time from '../../utils/time'
import kv from '../../utils/kv'
import router from '../../utils/router'
import haptic from '../../utils/haptic'
import marqueeState from '../../utils/marqueeState'

export default {
  data: {
    clock: '--:--',
    text: 'BandBox · 手腕上的百宝箱',
    size: 28,
    speed: 6,
    color: '#FFFFFF',
    bg: '#0D6EFF',
    timer: null
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
    kv.init(() => {
      const m = kv.get('marquee', null)
      if (m) {
        this.text = m.text || this.text
        this.size = m.size || this.size
        this.speed = m.speed || this.speed
        this.color = m.color || this.color
        this.bg = m.bg || this.bg
      }
    })
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  edit() {
    haptic.short()
    router.push('/pages/marqueeSet')
  },
  play(mode) {
    haptic.short()
    const m = {
      text: this.text,
      size: this.size,
      speed: this.speed,
      color: this.color,
      bg: this.bg,
      mode: mode
    }
    // 播放内容与模式同步写进全局状态：播放页 onShow 直接读到，不受 KV 异步与残留影响
    marqueeState.cfg = m
    // KV 只负责「记住上次配置」；落盘完成后再跳转，避免页面销毁打断写入
    kv.init(() => {
      kv.set('marqueeMode', mode)
      kv.set('marquee', m)
      kv.flush()
      router.push('/pages/textShow', m)
    })
  }
}
</script>
