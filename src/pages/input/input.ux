<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <pagehead title="{{ title || '输入' }}" clock="{{ clock }}"></pagehead>

    <div class="editorCard {{ kbShow ? 'editorCardKb' : '' }}" @click="openKb">
      <text class="f eLabel {{ kbShow ? 'eLabelKb' : '' }}">{{ hintText }}</text>
      <scroll class="pvScroll {{ kbShow ? 'pvScrollKb' : '' }} {{ multi ? 'pvMulti' : '' }}" scroll-y="true">
        <text class="f pv" if="{{ value }}">{{ value }}</text>
        <text class="f pvPlace" if="{{ !value }}">点击输入</text>
      </scroll>
      <text class="f pCount">{{ value.length }}/{{ limit }}</text>
      <div class="nlBtn" if="{{ multi }}" @click="newline"><text class="f nlT">换行</text></div>
    </div>

    <div class="done" @click="done"><text class="f doneT">完成</text></div>
    <backbtn></backbtn>
    <div class="kbBar" show="{{ kbShow }}" @click="closeKb"><text class="f kbBarT">完成</text></div>
    <input-method hide="{{ !kbShow }}" keyboardtype="QWERTY" maxlength="5" vibratemode="short" screentype="pill-shaped" @complete="onKey" @delete="onDel"></input-method>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.done { position: absolute; left: 146px; top: 42px; width: 32px; height: 28px; border-radius: 14px; background-color: #0D6EFF; align-items: center; justify-content: center; z-index: 99; }
.doneT { font-size: 14px; color: #FFFFFF; }
.editorCard { position: absolute; left: 3px; top: 80px; width: 206px; height: 160px; border-radius: 26px; background-color: #262626; padding: 8px 16px; flex-direction: column; }
.editorCardKb { height: 72px; }
.eLabel { width: 174px; height: 18px; line-height: 18px; font-size: 14px; color: rgba(255,255,255,0.45); text-overflow: ellipsis; lines: 1; }
.eLabelKb {}
.pvScroll { width: 174px; height: 110px; }
.pvScrollKb { height: 44px; }
.pvMulti { width: 138px; margin-left: 36px; }
.pv { width: 100%; font-size: 16px; line-height: 21px; color: #FFFFFF; }
.pvPlace { width: 100%; height: 40px; line-height: 40px; font-size: 15px; color: rgba(255,255,255,0.3); }
.pCount { position: absolute; right: 14px; top: 8px; font-size: 14px; color: rgba(255,255,255,0.3); }
.nlBtn { position: absolute; left: 7px; top: 42px; width: 30px; height: 24px; border-radius: 12px; background-color: #333333; align-items: center; justify-content: center; }
.nlT { font-size: 11px; color: #FFFFFF; }
</style>

<script>
import g from '../../utils/g'
import inputResult from '../../utils/inputResult'
import textInput from '../../utils/textInput'
import prompt from '@system.prompt'

export default {
  protected: { field: '', inputTitle: '', text: '', max: '80', multiline: '0', hint: '' },
  private: {
    _ck: null,
    clock: '--:--',
    title: '输入',
    value: '',
    hintText: '输入内容',
    limit: 80,
    multi: false,
    saving: false,
    opened: false,
    timer: null,
    focusTimer: null,
    kbShow: false
  },
  onInit() {
    this.title = this.inputTitle || '输入'
    this.limit = parseInt(this.max, 10) || 80
    this.multi = String(this.multiline) === '1'
    this.value = textInput.clamp(this.text || '', this.limit, this.multi)
    this.hintText = this.hint || (this.multi ? '支持换行，最多 ' + this.limit + ' 字' : '最多 ' + this.limit + ' 字')
    inputResult.clear()
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    if (!this.opened) {
      this.opened = true
      this.focusTimer = setTimeout(() => {
        this.focusTimer = null
        this.kbShow = true
      }, 220)
    }
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    if (this.focusTimer) clearTimeout(this.focusTimer)
    this.focusTimer = null
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    if (this.focusTimer) clearTimeout(this.focusTimer)
    this.focusTimer = null
  },
  openKb() {
    this.kbShow = true
  },
  closeKb() {
    this.kbShow = false
  },
  onKey(e) {
    const content = e && e.detail && e.detail.content ? e.detail.content : ''
    this.value = textInput.clamp(this.value + content, this.limit, this.multi)
  },
  onDel() {
    this.value = this.value.slice(0, -1)
  },
  newline() {
    if (!this.multi) return
    this.value = textInput.clamp(this.value + '\n', this.limit, true)
  },
  done() {
    if (this.saving) return
    this.saving = true
    this.kbShow = false
    const value = textInput.clamp(this.value, this.limit, this.multi)
    inputResult.save(this.field, value, (ok) => {
      if (!ok) {
        this.saving = false
        prompt.showToast({ message: '保存失败，请重试', duration: 1500 })
        return
      }
      g.haptic.short()
      g.router.back()
    })
  }
}
</script>
