<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="节拍器" clock="{{ clock }}"></pagehead>

    <div class="bpmBox" @click="openBpmPad">
      <text class="f bpmLabel">BPM（40–240）</text>
      <text class="f val">{{ bpm }}</text>
    </div>

    <text class="f status">{{ statusText }}</text>
    <text class="f gapTxt">每拍 {{ gap }} 毫秒</text>

    <div class="beatRow">
      <div class="pulse" if="{{ meter === 'none' }}" style="background-color: {{ pulseColor }};"></div>
      <div class="beatDots" if="{{ meter !== 'none' }}">
        <div class="bDot" for="{{ dots }}" style="background-color: {{ $item }};"></div>
      </div>
    </div>

    <div class="meters">
      <div
        class="mt"
        for="{{ meters }}"
        style="background-color: {{ meter === $item.id ? '#0D6EFF' : '#262626' }};"
        @click="setMeter($item.id)"
      >
        <text class="f mtT" style="color: {{ meter === $item.id ? '#FFFFFF' : 'rgba(255,255,255,0.65)' }};">{{ $item.label }}</text>
      </div>
    </div>

    <div class="levels">
      <div class="lv" style="background-color: {{ level === 'weak' ? '#0D6EFF' : '#262626' }};" @click="setLevel('weak')">
        <text class="f lvT" style="color: {{ level === 'weak' ? '#FFFFFF' : 'rgba(255,255,255,0.6)' }};">弱</text>
      </div>
      <div class="lv" style="background-color: {{ level === 'strong' ? '#0D6EFF' : '#262626' }};" @click="setLevel('strong')">
        <text class="f lvT" style="color: {{ level === 'strong' ? '#FFFFFF' : 'rgba(255,255,255,0.6)' }};">强</text>
      </div>
    </div>

    <div class="go" if="{{ !playing }}" @click="toggle">
      <text class="f goT">开始节拍</text>
    </div>
    <div class="go stop" if="{{ playing }}" @click="toggle">
      <text class="f goT">停止</text>
    </div>

    <text class="f hint">点数字改 BPM</text>

    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.bpmBox { position: absolute; left: 3px; top: 84px; width: 206px; height: 96px; border-radius: 26px; background-color: #151515; flex-direction: column; align-items: center; justify-content: center; }
.bpmLabel { width: 190px; height: 18px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); }
.val { width: 190px; height: 50px; line-height: 50px; text-align: center; font-size: 44px; color: #0D6EFF; text-overflow: ellipsis; lines: 1; }
.status { position: absolute; left: 0px; top: 186px; width: 212px; text-align: center; font-size: 14px; color: #0D6EFF; }
.gapTxt { position: absolute; left: 0px; top: 208px; width: 212px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); }
.beatRow { position: absolute; left: 6px; top: 234px; width: 200px; height: 26px; flex-direction: row; align-items: center; justify-content: center; }
.pulse { width: 24px; height: 24px; border-radius: 12px; }
.beatDots { flex-direction: row; align-items: center; justify-content: center; }
.bDot { width: 18px; height: 18px; border-radius: 9px; margin: 0px 4px; }
.meters { position: absolute; left: 6px; top: 266px; width: 200px; height: 34px; flex-direction: row; align-items: center; justify-content: space-between; border-radius: 17px; background-color: #1A1A1A; padding: 3px; }
.mt { width: 36px; height: 28px; border-radius: 14px; align-items: center; justify-content: center; }
.mtT { font-size: 14px; lines: 1; }
.levels { position: absolute; left: 6px; top: 308px; width: 200px; height: 36px; flex-direction: row; align-items: center; border-radius: 18px; background-color: #1A1A1A; padding: 3px; }
.lv { width: 97px; height: 30px; border-radius: 15px; align-items: center; justify-content: center; }
.lvT { font-size: 14px; }
.go { position: absolute; left: 26px; top: 354px; width: 160px; height: 46px; border-radius: 23px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.go.stop { background-color: #FF3B30; }
.goT { font-size: 17px; color: #FFFFFF; font-weight: bold; }
.hint { position: absolute; left: 16px; top: 408px; width: 180px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.55); }
</style>

<script>
import g from '../../utils/g'
import numInputSession from '../../utils/numInputSession'
import inputResult from '../../utils/inputResult'
import metronomeMeter from '../../utils/metronomeMeter'

const BPM_MIN = 40
const BPM_MAX = 240

function buildDots(meterId, activeIndex, activeColor) {
  const m = metronomeMeter.getMeter(meterId)
  const out = []
  for (let i = 0; i < m.beats; i++) {
    out.push(i === activeIndex ? activeColor : '#333333')
  }
  return out
}

function buildStatus(playing, bpm, meterId, lvLabel) {
  const head = playing ? '运行中' : '已就绪'
  const tail = meterId !== 'none' ? meterId + ' 拍' : lvLabel
  return head + ' · ' + bpm + ' BPM · ' + tail
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    bpm: 120,
    gap: 500,
    playing: false,
    timer: null,
    beatCount: 0,
    pulseOn: false,
    pulseColor: '#333333',
    meter: 'none',
    meters: metronomeMeter.METERS,
    dots: [],
    level: 'strong',
    lvLabel: '强',
    statusText: '已就绪 · 120 BPM · 强',
    resumeAfterPad: false
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.updateStatus()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)

    const syncRes = numInputSession.take('bpm')
    if (syncRes) {
      this.applyBpmInput(syncRes.value)
      inputResult.clear()
    } else {
      inputResult.take((r) => {
        if (r && r.field === 'bpm' && page.$valid) page.applyBpmInput(r.value)
      })
    }

    if (this.resumeAfterPad) {
      this.resumeAfterPad = false
      if (!this.playing) this.start()
    }
  },
  onHide() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  updateStatus() {
    this.statusText = buildStatus(this.playing, this.bpm, this.meter, this.lvLabel)
  },
  beat() {
    if (!this.playing) return
    const meta = metronomeMeter.beatMeta(this.meter, this.beatCount, this.level)
    this.beatCount++
    this.pulseOn = !this.pulseOn
    if (meta.totalBeats === 0) {
      this.pulseColor = this.pulseOn ? '#0D6EFF' : '#333333'
    } else {
      const hex = meta.isAccent ? '#FF9500' : '#0D6EFF'
      this.pulseColor = hex
      this.dots = buildDots(this.meter, meta.dotIndex, hex)
    }
    g.haptic.beat(meta.level)
  },
  setMeter(mId) {
    const m = metronomeMeter.getMeter(mId)
    this.meter = m.id
    this.beatCount = 0
    this.dots = buildDots(m.id, -1, '')
    this.pulseColor = '#333333'
    this.updateStatus()
    g.haptic.short()
    if (this.playing) {
      this.beat()
      this.restartTimer()
    }
  },
  setLevel(l) {
    if (!l || l === this.level) {
      g.haptic.beat(l || this.level)
      return
    }
    this.level = l
    this.lvLabel = g.haptic.label(l)
    this.updateStatus()
    g.haptic.beat(l)
  },
  start() {
    this.playing = true
    this.beatCount = 0
    this.updateStatus()
    g.screen.enter({ bright: false, keepOn: true })
    this.beat()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.beat(), this.gap)
  },
  stop() {
    this.playing = false
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    g.haptic.stop()
    this.pulseOn = false
    this.pulseColor = '#333333'
    this.dots = buildDots(this.meter, -1, '')
    this.updateStatus()
    g.screen.leave()
  },
  toggle() {
    if (this.playing) this.stop()
    else this.start()
  },
  openBpmPad() {
    this.resumeAfterPad = this.playing
    g.haptic.short()
    g.router.push('/pages/numinput', {
      field: 'bpm',
      title: 'BPM',
      value: '',
      type: 'int',
      allowNegative: '0',
      allowDecimal: '0',
      min: BPM_MIN,
      max: BPM_MAX,
      maxLen: '3',
      hint: BPM_MIN + ' ~ ' + BPM_MAX + '（当前 ' + this.bpm + '）'
    })
  },
  applyBpmInput(val) {
    const v = parseInt(val, 10)
    if (isNaN(v)) return
    const n = Math.max(BPM_MIN, Math.min(BPM_MAX, v))
    if (n === this.bpm) return
    this.applyBpm(n)
  },
  applyBpm(n) {
    this.bpm = n
    this.gap = Math.round(60000 / n)
    this.updateStatus()
    if (this.playing) this.restartTimer()
  },
  restartTimer() {
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.beat(), this.gap)
  }
}
</script>
