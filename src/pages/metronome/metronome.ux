<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="节拍器" clock="{{ clock }}"></pagehead>

    <!-- BPM 原位步进：调 BPM 是高频即时操作，弹键盘会遮住大卡片、跳页再回来更慢，
         所以直接在 BPM 卡里放四颗 chip（−5 / −1 / +1 / +5），点一下当场改、当场生效。
         卡内纵向三段：标题行 + 大数值 + 步进行，总高仍是 112px。 -->
    <div class="bpmBox">
      <text class="f bpmLabel">BPM（40–240）</text>
      <text class="f val">{{ bpm }}</text>
      <div class="stepRow">
        <div class="chip" @click="stepBpm(-5)"><text class="f chipT">−5</text></div>
        <div class="chip" @click="stepBpm(-1)"><text class="f chipT">−1</text></div>
        <div class="chip" @click="stepBpm(1)"><text class="f chipT">+1</text></div>
        <div class="chip" @click="stepBpm(5)"><text class="f chipT">+5</text></div>
      </div>
    </div>

    <text class="f status">{{ playing ? '运行中 · ' + bpm + ' BPM · ' + lvLabel : '已就绪 · ' + bpm + ' BPM · ' + lvLabel }}</text>
    <text class="f gapTxt">每拍 {{ gap }} 毫秒</text>

    <div class="pulse" style="background-color: {{ pulseOn ? '#0D6EFF' : '#333333' }};"></div>

    <!-- 力度选择：弱（短振）/ 强（长振），默认强。摆在开始键正上方，点一下立刻按新档位振一记，方便直接比手感 -->
    <div class="levels">
      <text class="f lvLabel">力度</text>
      <div class="lv" style="background-color: {{ level === 'weak' ? '#0D6EFF' : 'transparent' }};" @click="setLevel('weak')">
        <text class="f lvT">弱</text>
      </div>
      <div class="lv" style="background-color: {{ level === 'strong' ? '#0D6EFF' : 'transparent' }};" @click="setLevel('strong')">
        <text class="f lvT">强</text>
      </div>
    </div>

    <div class="go" if="{{ !playing }}" @click="toggle">
      <text class="f goT">开始</text>
    </div>
    <div class="go goStop" if="{{ playing }}" @click="toggle">
      <text class="f goT">结束</text>
    </div>
    <text class="f hint" style="color: {{ hintAlert ? '#FF3B30' : 'rgba(255,255,255,0.35)' }};">{{ hint }}</text>

    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.bpmBox { position: absolute; left: 3px; top: 96px; width: 206px; height: 112px; border-radius: 26px; background-color: #151515; flex-direction: column; align-items: center; justify-content: center; }
.bpmLabel { width: 190px; height: 16px; line-height: 16px; text-align: center; font-size: 13px; color: rgba(255,255,255,0.45); }
/* 大数值：16（标题行）+ 54（数值）+ 32（步进行）= 102，卡高 112，上下各留 5px */
.val { width: 190px; height: 54px; line-height: 54px; text-align: center; font-size: 46px; color: #0D6EFF; text-overflow: ellipsis; lines: 1; }
/* 步进行：四颗 chip 均分整行宽度（flex:1），卡宽随机型变，chip 自动跟着变宽。
   行宽取 152px（卡内左右各留 27px）：chip 是带底色的方块，不能顶到卡片 26px 圆角外，
   否则角上会露出卡片外的方块 —— 窄一点更稳。 */
.stepRow { width: 152px; height: 32px; flex-direction: row; align-items: center; }
.chip { flex: 1; height: 32px; margin-right: 4px; border-radius: 16px; background-color: #262626; align-items: center; justify-content: center; }
.chipT { font-size: 15px; color: #FFFFFF; }
.status { position: absolute; left: 0px; top: 218px; width: 212px; text-align: center; font-size: 14px; color: #0D6EFF; }
.gapTxt { position: absolute; left: 0px; top: 242px; width: 212px; text-align: center; font-size: 13px; color: rgba(255,255,255,0.4); }
.pulse { position: absolute; left: 91px; top: 278px; width: 30px; height: 30px; border-radius: 15px; }
.levels { position: absolute; left: 6px; top: 318px; width: 200px; height: 38px; flex-direction: row; align-items: center; border-radius: 19px; background-color: #1A1A1A; padding: 3px; }
.lvLabel { width: 32px; height: 32px; line-height: 32px; text-align: center; font-size: 13px; color: rgba(255,255,255,0.45); }
.lv { flex: 1; height: 32px; margin-right: 4px; border-radius: 16px; align-items: center; justify-content: center; }
.lvT { font-size: 14px; color: #FFFFFF; }
.go { position: absolute; left: 26px; top: 378px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.goStop { background-color: #FF3B30; }
.goT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 16px; top: 436px; width: 180px; text-align: center; font-size: 13px; line-height: 20px; color: rgba(255,255,255,0.35); }
</style>

<script>
import g from '../../utils/g'

const BPM_MIN = 40
const BPM_MAX = 240
const HINT_IDLE = '点 −/+ 调 BPM'

export default {
  data: {
    _ck: null,
    clock: '--:--',
    bpm: 120,
    gap: 500,
    playing: false,
    timer: null,
    beatCount: 0,
    pulseOn: false,
    // 底部提示行：平时是操作提示，撞到上下限时临时显示夹紧说明
    hint: HINT_IDLE,
    hintAlert: false,
    hintTimer: null,
    // 振动力度档位：弱（短振）/ 强（长振），默认强
    level: 'strong',
    lvLabel: '强'
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    this.stop()
    this.clearHint()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.stop()
    this.clearHint()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  clearHint() {
    if (this.hintTimer) { clearTimeout(this.hintTimer); this.hintTimer = null }
    this.hint = HINT_IDLE
    this.hintAlert = false
  },
  beat() {
    if (!this.playing) return
    this.beatCount++
    this.pulseOn = !this.pulseOn
    // 按所选力度振：弱=短振，强=长振
    g.haptic.beat(this.level)
  },
  setLevel(l) {
    if (!l || l === this.level) {
      // 重复点当前档位也振一记，方便反复对比同一力度
      g.haptic.beat(l || this.level)
      return
    }
    this.level = l
    this.lvLabel = g.haptic.label(l)
    // 立刻按新档位振一记，当场比手感
    g.haptic.beat(l)
  },
  start() {
    this.playing = true
    this.beatCount = 0
    // 常亮绑定运行时：bright:false 时 enter 完全同步，必须留在同步路径上
    g.screen.enter({ bright: false, keepOn: true })
    this.beat()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.beat(), this.gap)
  },
  stop() {
    this.playing = false
    if (this.timer) clearInterval(this.timer)
    this.timer = null
    g.haptic.stop()
    this.pulseOn = false
    g.screen.leave()
  },
  toggle() {
    if (this.playing) this.stop()
    else this.start()
  },
  /**
   * BPM 步进：chip 点一下按 ±1 / ±5 改 BPM 并立即生效（40..240 之间夹紧）。
   * 运行中改 BPM 只重建 interval（restartTimer），不停节拍、不关常亮 ——
   * 步进是调参数，不是切视图，不该打断正在跑的节拍。
   */
  stepBpm(d) {
    const delta = parseInt(d, 10) || 0
    if (!delta) return
    let v = this.bpm + delta
    if (v > BPM_MAX) {
      v = BPM_MAX
      this.flashHint('最快 240 BPM')
      g.haptic.long()
    } else if (v < BPM_MIN) {
      v = BPM_MIN
      this.flashHint('最慢 40 BPM')
      g.haptic.long()
    } else if (!this.playing) {
      g.haptic.short()
    }
    if (v === this.bpm) return
    this.applyBpm(v)
  },
  /**
   * 撞到上下限时的提示：写在页面自己的提示行里，不用系统 toast ——
   * 212px 宽的跑道屏上 toast 气泡是贴着屏幕右缘画的，长句会被切掉大半（模拟器实测）。
   * 提示行是页面自己的元素，文字多长都完整可见。
   */
  flashHint(msg) {
    this.hint = msg
    this.hintAlert = true
    if (this.hintTimer) clearTimeout(this.hintTimer)
    const page = this
    this.hintTimer = setTimeout(() => {
      page.hintTimer = null
      if (page.$valid) page.clearHint()
    }, 1500)
  },
  applyBpm(n) {
    this.bpm = n
    this.gap = Math.round(60000 / n)
    if (this.playing) this.restartTimer()
  },
  // 只重建 interval，不走 stop();start()，避免 setKeepScreenOn 异步乱序关掉常亮
  restartTimer() {
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.beat(), this.gap)
  }
}
</script>
