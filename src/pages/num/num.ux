<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="数字滚动" clock="{{ clock }}"></pagehead>
    <div class="display" @click="toggle">
      <text class="f num {{ display.length >= 6 ? 'small' : '' }}">{{ display }}</text>
      <text class="f dLabel">轻触{{ running ? '暂停' : '开始' }}</text>
    </div>

    <text class="f label">滚动间隔</text>
    <div class="chips">
      <div class="chip" style="background-color: {{ interval === 100 ? '#0D6EFF' : '#262626' }};" @click="pickInterval(100)"><text class="f chipT">100ms</text></div>
      <div class="chip" style="background-color: {{ interval === 250 ? '#0D6EFF' : '#262626' }};" @click="pickInterval(250)"><text class="f chipT">250ms</text></div>
      <div class="chip" style="background-color: {{ interval === 500 ? '#0D6EFF' : '#262626' }};" @click="pickInterval(500)"><text class="f chipT">500ms</text></div>
      <div class="chip" style="background-color: {{ interval === 1000 ? '#0D6EFF' : '#262626' }};" @click="pickInterval(1000)"><text class="f chipT">1s</text></div>
    </div>

    <div class="go" @click="toggle"><text class="f goT">{{ running ? '暂停' : '开始滚动' }}</text></div>
    <div class="reset" @click="reset"><text class="f resetT">归零</text></div>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.display { position: absolute; left: 3px; top: 80px; width: 206px; height: 150px; border-radius: 26px; background-color: #262626; align-items: center; justify-content: center; flex-direction: column; }
.num { width: 206px; height: 86px; line-height: 86px; text-align: center; font-size: 62px; color: #0D6EFF; letter-spacing: 2px; }
.num.small { font-size: 44px; }
.dLabel { font-size: 14px; color: rgba(255,255,255,0.35); }
.label { position: absolute; left: 12px; top: 250px; font-size: 14px; color: rgba(255,255,255,0.45); }
.chips { position: absolute; left: 6px; top: 276px; width: 200px; height: 64px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
/* 选中态走内联 style：本渲染器不支持 .chip.on 复合类选择器，会把复合规则套到所有 .chip */
.chip { width: 96px; height: 28px; margin-bottom: 6px; border-radius: 14px; background-color: #262626; align-items: center; justify-content: center; }
.chipT { font-size: 14px; color: #FFFFFF; }
.go { position: absolute; left: 26px; top: 370px; width: 160px; height: 46px; border-radius: 23px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.goT { font-size: 14px; color: #FFFFFF; }
.reset { position: absolute; left: 71px; top: 430px; width: 70px; height: 30px; border-radius: 15px; background-color: #262626; align-items: center; justify-content: center; }
.resetT { font-size: 14px; color: rgba(255,255,255,0.65); }
</style>

<script>

import g from '../../utils/g'
function pad(n) {
  let s = String(n)
  while (s.length < 5) s = '0' + s
  return s
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    value: 0,
    display: '00000',
    interval: 250,
    dirty: false,
    running: false,
    timer: null,
    clockTimer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    g.kv.init(() => {
      // kv.js 读成功会整份替换 data，读盘窗口内的点按会被吞掉，故用 dirty 挡住旧值回写
      if (!this.$valid || this.dirty) return
      const v = g.kv.get('numInterval', 250)
      if (v === 100 || v === 250 || v === 500 || v === 1000) this.interval = v
    })
  },
  onHide() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.stop()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  // 不能叫 setInterval：模板编译器对撞上 Node 全局的标识符不加 _vm_. 前缀（TemplateUtil.js:232）
  pickInterval(v) {
    this.dirty = true
    this.interval = v
    g.kv.set('numInterval', v)
    if (this.running) {
      this.stop()
      this.start()
    }
    g.haptic.short()
  },
  toggle() {
    if (this.running) this.stop()
    else this.start()
  },
  start() {
    this.running = true
    g.haptic.short()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.value = this.value + 1
      this.display = pad(this.value)
    }, this.interval)
  },
  stop() {
    this.running = false
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  reset() {
    g.haptic.long()
    this.stop()
    this.value = 0
    this.display = '00000'
  }
}
</script>
