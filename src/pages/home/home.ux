<import name="pagehead" src="../../components/PageHead.ux"></import>

<template>
  <div class="page">
    <pagehead title="BandBox" clock="{{ clock }}" noback="{{ true }}"></pagehead>

    <!-- 不常驻模式（设置页开关）下没有目标日时整张卡不渲染，让出空间给工具列表：
         同「容器型 show 的动态翻转不可靠」的坑，这里用 if 而不是 show -->
    <div class="today" if="{{ showToday }}" @click="openDays">
      <div class="todayTop">
        <text class="f date">{{ dateText }}</text>
        <text class="f go">目标日 ></text>
      </div>
      <text class="f event">{{ eventTitle }}</text>
      <text class="f delta" style="color: {{ eventColor }};">{{ eventDelta }}</text>
    </div>

    <!-- 网格必须用 if：本渲染器对容器型 show 的动态翻转不可靠（Pro 真机首启网格不出现，
         逛一次目标日回来才显示）；if 在 layoutReady 翻转时全新建节点，规避该坑 -->
    <scroll class="apps {{ showToday ? '' : 'appsUp' }}" if="{{ layoutReady && layout === 'grid' }}" scroll-y="true" bounces="true">
      <div class="grid" style="height: {{ gridHeight }}px;">
        <div class="f cell" for="{{ cells }}" @click="open($item)" @longpress="onLong($item)">
          <img class="icon" src="{{ $item.icon }}" />
          <text class="f name">{{ $item.name }}</text>
        </div>
      </div>
    </scroll>

    <!-- 双栏网格（grid2）：Pro 专属的第二种网格形态（HOME.cols !== 2 时样式页才出该选项），
         band10/band9 的网格本就是两列、不会出现此模式。与 grid 分支同构，仅卡片用 .cell2（更宽）、
         内容高用 gridHeight2（固定两列）；if 而非 show（同上：容器型 show 的动态翻转不可靠） -->
    <scroll class="apps {{ showToday ? '' : 'appsUp' }}" if="{{ layoutReady && layout === 'grid2' }}" scroll-y="true" bounces="true">
      <div class="grid" style="height: {{ gridHeight2 }}px;">
        <div class="f cell2" for="{{ cells }}" @click="open($item)" @longpress="onLong($item)">
          <img class="icon" src="{{ $item.icon }}" />
          <text class="f name">{{ $item.name }}</text>
        </div>
      </div>
    </scroll>

    <list class="apps listApps {{ showToday ? '' : 'appsUp' }}" if="{{ layoutReady && layout === 'list' }}" bounces="true">
      <list-item type="app" class="rowCell" for="{{ cells }}" @click="open($item)" @longpress="onLong($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

    <!-- 分类单栏：与上面 list 分支逐字同构，只把 for 的数据源换成 catCells。
         用 if 不用 show（同上：Pro 真机容器型 show 翻转不可靠）；listPad 必须保留。 -->
    <list class="apps listApps {{ showToday ? '' : 'appsUp' }}" if="{{ layoutReady && layout === 'cat' }}" bounces="true">
      <list-item type="cat" class="rowCell" for="{{ catCells }}" @click="open($item)" @longpress="onLong($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.today {
  position: absolute;
  left: 3px;
  top: 92px;
  width: 206px;
  height: 88px;
  border-radius: 26px;
  background-color: #262626;
  padding: 8px 16px;
  flex-direction: column;
}
.todayTop {
  width: 174px;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.date {
  width: 108px;
  height: 24px;
  line-height: 24px;
  font-size: 15px;
  color: rgba(255,255,255,0.72);
  lines: 1;
  text-overflow: ellipsis;
}
.go {
  width: 66px;
  height: 24px;
  line-height: 24px;
  text-align: right;
  font-size: 15px;
  color: rgba(255,255,255,0.55);
  lines: 1;
}
.event {
  width: 174px;
  height: 26px;
  line-height: 26px;
  font-size: 18px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.delta {
  width: 174px;
  height: 22px;
  line-height: 22px;
  font-size: 16px;
  lines: 1;
}
.apps {
  position: absolute;
  left: 0px;
  top: 182px;
  width: 212px;
  height: 304px;
}
/* 不常驻模式且没有目标日：目标日卡不渲染，列表顶到卡片原位（top 92），高度补上卡片
   占用的 90px（88 高 + 2px 间距），底部与常驻态相同（band10 486 / Pro 440）。
   Pro 的 348 由 profiles/pro336.json 的替换对给出，勿在 JS 里另写一份。 */
.appsUp {
  top: 92px;
  height: 394px;
}
.listApps {
  background-color: #000000;
  padding: 0px 6px 0px 6px;
}
.grid {
  width: 212px;
  padding: 0px 3px 40px 3px;
  flex-direction: row;
  flex-wrap: wrap;
}
.cell {
  width: 97px;
  height: 70px;
  margin: 3px;
  border-radius: 26px;
  background-color: #1A1A1A;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  padding-top: 6px;
}
/* 双栏网格卡片：仅 grid2 分支渲染。宽度 96 是 band10 基线占位（该机型不出此模式），
   Pro 由 profiles/pro336.json 替换为 159（(336-6-12)/2，flex-wrap 每行恰好两格）；
   高度沿用 .cell 的 70→76 替换对，行距 = 76+6 与 HOME.rowH 保持一致 */
.cell2 {
  width: 96px;
  height: 70px;
  margin: 3px;
  border-radius: 26px;
  background-color: #1A1A1A;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  padding-top: 6px;
}
.icon {
  width: 32px;
  height: 32px;
}
.name {
  width: 93px;
  height: 24px;
  line-height: 24px;
  text-align: center;
  font-size: 18px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowCell {
  width: 200px;
  height: 68px;
  margin: 0px 0px 8px 0px;
  border-radius: 26px;
  background-color: #1A1A1A;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0px 12px;
}
.rowIcon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
}
.rowMeta {
  width: 128px;
  height: 52px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.rowName {
  width: 128px;
  height: 28px;
  line-height: 28px;
  text-align: left;
  font-size: 19px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowDesc {
  width: 128px;
  height: 21px;
  line-height: 21px;
  text-align: left;
  font-size: 15px;
  color: rgba(255,255,255,0.6);
  text-overflow: ellipsis;
  lines: 1;
}
/* pad 不得宽于 list 内容盒（listApps 内容盒 200px）：原生 list 会把超宽子项计入横向
   可滚动范围（212px pad 即产生 12px 拖动空间，抢占右滑返回），同 lyrics/transfer 的 margin 坑 */
.listPad {
  width: 200px;
  height: 40px;
}
</style>

<script>
import g from '../../utils/g'
import apps from '../../data/apps'
import catData from '../../data/cats'
import layoutApi from '../../utils/homeLayout'
import homeEvents from '../../utils/homeEvents'
import homeToday from '../../utils/homeToday'
import homeTools from '../../utils/homeTools'
import { gridHeight, HOME } from '../../common/layout.js'

const SETTINGS_TILE = {
  id: '__settings__',
  name: '设置',
  desc: '首页样式 · 关于',
  route: '/pages/set',
  icon: '/common/icons/settings.png'
}

const CELLS = apps.concat([SETTINGS_TILE])

// 分类模式的行：9 个类别 + 末尾设置行（设置行走 route 分支，不进类别页）
const CAT_CELLS = catData.rows.concat([SETTINGS_TILE])

// 双栏网格（grid2）的内容高：固定两列；行高/底部留白仍取本 profile 的 HOME
// （band10 76/60，Pro 82/48），列数不随 profile 变化。
// 注意：函数名避开 g-r-i-d-H-e-i-g-h-t 前缀（test-profile 会拦 home.ux 里的本地定义）
function dualGridHeight(count) {
  return Math.ceil(count / 2) * HOME.rowH + HOME.padBottom
}

let layoutWatcher = null
let lastLongAt = 0

export default {
  data: {
    clock: '--:--',
    dateText: '',
    eventTitle: '记录一个目标日',
    eventDelta: '把重要的日子放在心上',
    eventColor: 'rgba(255,255,255,0.4)',
    // 目标日卡片：showToday 是渲染开关；todayAuto = 设置页「目标日不常驻」，
    // hasToday 由目标日数据刷新。常驻模式恒显示，不常驻模式仅在有目标日时显示。
    showToday: true,
    todayAuto: false,
    hasToday: true,
    layout: 'grid',
    layoutReady: false,
    cells: CELLS,
    catCells: CAT_CELLS,
    gridHeight: gridHeight(CELLS.length),
    gridHeight2: dualGridHeight(CELLS.length),
    timer: null,
    _ck: null
  },
  onInit() {
    this.refreshClock()
    this.refreshDate()
  },
  onShow() {
    this.watchLayout()
    this.syncLayout()
    this.readTodayMode()
    this.rebuildCells()
    this.refresh()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.unwatchLayout()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  watchLayout() {
    if (layoutWatcher) return
    const app = layoutApi.api(this)
    if (!app || !app.watchHomeLayout) return
    const page = this
    layoutWatcher = function (mode) {
      if (!page.$valid) return
      page.applyLayout(mode)
    }
    app.watchHomeLayout(layoutWatcher)
  },
  unwatchLayout() {
    if (!layoutWatcher) return
    const app = layoutApi.api(this)
    if (app && app.unwatchHomeLayout) app.unwatchHomeLayout(layoutWatcher)
    layoutWatcher = null
  },
  syncLayout() {
    const app = layoutApi.api(this)
    if (app && app.getHomeLayout && app.isHomeLayoutReady && app.isHomeLayoutReady()) {
      this.applyLayout(app.getHomeLayout())
      return
    }
    if (app && app.watchHomeLayout) {
      // watchLayout 已注册，应用级数据就绪时会回调
      return
    }
    g.kv.init(() => {
      this.applyLayout(g.kv.get('home', 'grid'))
    })
  },
  applyLayout(mode) {
    const next = mode === 'list' ? 'list' : mode === 'cat' ? 'cat' : mode === 'grid2' ? 'grid2' : 'grid'
    if (this.layout !== next) this.layout = next
    if (!this.layoutReady) this.layoutReady = true
  },
  /** 读「目标日不常驻」开关（设置页写，回到首页时生效） */
  readTodayMode() {
    const page = this
    homeToday.read((on) => {
      if (!page.$valid || page.todayAuto === on) return
      page.todayAuto = on
      page.applyToday()
    })
  },
  /** 目标日卡是否显示：常驻模式恒显示；不常驻模式仅在有目标日时显示 */
  applyToday() {
    const show = !this.todayAuto || this.hasToday
    if (this.showToday !== show) this.showToday = show
  },
  refresh() {
    this.refreshClock()
    this.refreshDate()
    // 目标日数据带 60 秒缓存：回到首页不必每次读盘 + 解析 + 全表遍历。
    // 首页只显示开着「在主页显示」开关的那条（bestHome）；旧数据的双开迁移在数据层完成。
    homeEvents.load((r) => {
      const bestHome = r && r.bestHome
      // 没有开着主页开关的目标日（空列表 / 全部没开 / 日期全部非法）都算「没有目标日」：
      // 不常驻模式下据此收起顶部卡片，常驻模式下显示占位文案
      this.hasToday = !!bestHome
      this.applyToday()
      if (!bestHome) {
        // 没有目标日时回到占位文案（常驻模式下卡片仍显示「记录一个目标日」）
        this.eventTitle = '记录一个目标日'
        this.eventDelta = '把重要的日子放在心上'
        this.eventColor = 'rgba(255,255,255,0.4)'
        return
      }
      this.eventTitle = bestHome.item.title || bestHome.item.display_name || '目标日'
      this.eventDelta = bestHome.d.text
      this.eventColor = bestHome.d.status === 'today' ? '#00C853' : '#0D6EFF'
    })
  },
  refreshDate() {
    const now = new Date()
    if (g.time && g.time.weekdayName) {
      this.dateText = now.getMonth() + 1 + '月' + now.getDate() + '日 ' + g.time.weekdayName(now)
    }
  },
  refreshClock() {
    if (g.time && g.time.formatClock) {
      this.clock = g.time.formatClock(new Date())
    }
  },
  /** 读偏好设置并重构主要布局与分类布局的工具列表 */
  rebuildCells() {
    const page = this
    homeTools.read((prefs) => {
      if (!page.$valid) return
      const nextCells = homeTools.buildMain(apps, prefs)
      const nextCatCells = homeTools.buildCatRows(catData.CATS, apps, prefs)

      let cellsKey = ''
      for (let i = 0; i < nextCells.length; i++) {
        cellsKey += nextCells[i].id + ':' + (nextCells[i].desc || '') + ','
      }
      let curCellsKey = ''
      for (let i = 0; i < page.cells.length; i++) {
        curCellsKey += page.cells[i].id + ':' + (page.cells[i].desc || '') + ','
      }

      if (cellsKey !== curCellsKey) {
        page.cells = nextCells
        page.gridHeight = gridHeight(nextCells.length)
        page.gridHeight2 = dualGridHeight(nextCells.length)
      }

      let catKey = ''
      for (let i = 0; i < nextCatCells.length; i++) {
        catKey += nextCatCells[i].id + ':' + nextCatCells[i].desc + ','
      }
      let curCatKey = ''
      for (let i = 0; i < page.catCells.length; i++) {
        curCatKey += page.catCells[i].id + ':' + page.catCells[i].desc + ','
      }

      if (catKey !== curCatKey) {
        page.catCells = nextCatCells
      }
    })
  },
  open(item) {
    if (!item) return
    if (Date.now() - lastLongAt < 800) return
    // 分类行带 cat（无 route）：进类别页；普通工具行与设置行带 route：直接进工具
    if (item.cat) {
      g.haptic.short()
      g.router.push('/pages/toolcat', { cat: item.cat })
      return
    }
    if (!item.route) return
    g.router.push(item.route)
  },
  onLong(item) {
    if (!item || !item.id || item.cat || item.id.indexOf('__') === 0) return
    lastLongAt = Date.now()
    g.haptic.short()
    g.router.push('/pages/toolact', { id: item.id })
  },
  openDays() {
    g.router.push('/pages/daysmatter/list')
  }
}
</script>
