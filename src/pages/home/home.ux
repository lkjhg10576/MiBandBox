<import name="pagehead" src="../../components/PageHead.ux"></import>

<template>
  <div class="page">
    <pagehead title="BandBox" clock="{{ clock }}"></pagehead>

    <div class="today" @click="openDays">
      <div class="todayTop">
        <text class="f date">{{ dateText }}</text>
        <text class="f go">目标日 ></text>
      </div>
      <text class="f event">{{ eventTitle }}</text>
      <text class="f delta" style="color: {{ eventColor }};">{{ eventDelta }}</text>
    </div>

    <scroll class="apps" show="{{ layoutReady && layout === 'grid' }}" scroll-y="true" bounces="true">
      <div class="grid" style="height: {{ gridHeight }}px;">
        <div class="f cell" for="{{ cells }}" @click="open($item)">
          <img class="icon" src="{{ $item.icon }}" />
          <text class="f name">{{ $item.name }}</text>
        </div>
      </div>
    </scroll>

    <list class="apps listApps" if="{{ layoutReady && layout === 'list' }}" bounces="true">
      <list-item type="app" class="rowCell" for="{{ cells }}" @click="open($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.page { width: 212px; height: 520px; background-color: #000000; }
.today {
  position: absolute;
  left: 3px;
  top: 92px;
  width: 206px;
  height: 100px;
  border-radius: 26px;
  background-color: #262626;
  padding: 11px 16px;
  flex-direction: column;
}
.todayTop {
  width: 174px;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.date {
  width: 118px;
  font-size: 14px;
  color: rgba(255,255,255,0.6);
}
.go {
  width: 54px;
  text-align: right;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
}
.event {
  width: 174px;
  height: 26px;
  line-height: 26px;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.delta {
  width: 174px;
  height: 22px;
  line-height: 22px;
  font-size: 15px;
}
.apps {
  position: absolute;
  left: 0px;
  top: 200px;
  width: 212px;
  height: 258px;
}
.listApps {
  background-color: #000000;
}
.grid {
  width: 212px;
  padding: 0px 3px 20px 3px;
  flex-direction: row;
  flex-wrap: wrap;
}
.cell {
  width: 97px;
  height: 80px;
  margin: 3px;
  border-radius: 26px;
  background-color: #1A1A1A;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  padding-top: 8px;
}
.icon {
  width: 32px;
  height: 32px;
}
.name {
  width: 93px;
  height: 22px;
  line-height: 22px;
  text-align: center;
  font-size: 16px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowCell {
  width: 200px;
  height: 72px;
  margin: 3px 6px 8px 6px;
  border-radius: 26px;
  background-color: #1A1A1A;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0px 12px;
}
.rowIcon {
  width: 36px;
  height: 36px;
  margin-right: 10px;
}
.rowMeta {
  width: 128px;
  height: 52px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.rowName {
  width: 128px;
  height: 26px;
  line-height: 26px;
  text-align: left;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowDesc {
  width: 128px;
  height: 20px;
  line-height: 20px;
  text-align: left;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
  text-overflow: ellipsis;
  lines: 1;
}
.listPad {
  width: 212px;
  height: 20px;
}
</style>

<script>
import apps from '../../data/apps'
import kv from '../../utils/kv'
import layoutApi from '../../utils/homeLayout'
import router from '../../utils/router'
import time from '../../utils/time'
import fs from '../../utils/fs'

const EVENTS_PATH = 'internal://files/bandbox/events.json'

const SETTINGS_TILE = {
  id: '__settings__',
  name: '设置',
  desc: '首页样式 · 关于',
  route: '/pages/set',
  icon: '/common/icons/settings.png'
}

const CELLS = apps.concat([SETTINGS_TILE])

function gridHeight(count) {
  return Math.ceil(count / 2) * 86 + 20
}

let layoutWatcher = null

export default {
  data: {
    clock: '--:--',
    dateText: '',
    eventTitle: '记录一个目标日',
    eventDelta: '把重要的日子放在心上',
    eventColor: 'rgba(255,255,255,0.4)',
    layout: 'grid',
    layoutReady: false,
    cells: CELLS,
    gridHeight: gridHeight(CELLS.length),
    timer: null
  },
  onShow() {
    this.watchLayout()
    this.syncLayout()
    this.refresh()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => this.refreshClock(), 20000)
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    this.unwatchLayout()
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  watchLayout() {
    if (layoutWatcher) return
    const app = layoutApi.api(this)
    if (!app || !app.watchHomeLayout) return
    const page = this
    layoutWatcher = function (mode) {
      if (!page.$valid) return
      page.applyLayout(mode)
    }
    app.watchHomeLayout(layoutWatcher)
  },
  unwatchLayout() {
    if (!layoutWatcher) return
    const app = layoutApi.api(this)
    if (app && app.unwatchHomeLayout) app.unwatchHomeLayout(layoutWatcher)
    layoutWatcher = null
  },
  syncLayout() {
    const app = layoutApi.api(this)
    if (app && app.getHomeLayout && app.isHomeLayoutReady && app.isHomeLayoutReady()) {
      this.applyLayout(app.getHomeLayout())
      return
    }
    if (app && app.watchHomeLayout) {
      // watchLayout 已注册，应用级数据就绪时会回调
      return
    }
    kv.init(() => {
      this.applyLayout(kv.get('home', 'grid'))
    })
  },
  applyLayout(mode) {
    const next = mode === 'list' ? 'list' : 'grid'
    if (this.layout !== next) this.layout = next
    if (!this.layoutReady) this.layoutReady = true
  },
  refresh() {
    this.refreshClock()
    const now = new Date()
    this.dateText = now.getMonth() + 1 + '月' + now.getDate() + '日 ' + time.weekdayName(now)
    fs.readText(EVENTS_PATH, (text) => {
      if (!text) return
      let list = []
      try {
        list = JSON.parse(text)
      } catch (e) {
        list = []
      }
      if (!Array.isArray(list) || !list.length) return
      let best = null
      let bestAbs = 1e9
      list.forEach((item) => {
        if (!item || !item.date) return
        const d = time.humanDelta(item.date)
        if (d.status === 'invalid') return
        const abs = Math.abs(d.days)
        if (abs < bestAbs) {
          bestAbs = abs
          best = { item, d }
        }
      })
      if (best) {
        this.eventTitle = best.item.title || best.item.display_name || '目标日'
        this.eventDelta = best.d.text
        this.eventColor = best.d.status === 'today' ? '#00C853' : '#0D6EFF'
      }
    })
  },
  refreshClock() {
    this.clock = time.formatClock(new Date())
  },
  open(item) {
    router.push(item.route)
  },
  openDays() {
    router.push('/pages/daysmatter/list')
  }
}
</script>
