<import name="pagehead" src="../../components/PageHead.ux"></import>

<template>
  <div class="page">
    <pagehead title="BandBox" clock="{{ clock }}" noback="{{ true }}"></pagehead>

    <div class="today" @click="openDays">
      <div class="todayTop">
        <text class="f date">{{ dateText }}</text>
        <text class="f go">目标日 ></text>
      </div>
      <text class="f event">{{ eventTitle }}</text>
      <text class="f delta" style="color: {{ eventColor }};">{{ eventDelta }}</text>
    </div>

    <!-- 网格必须用 if：本渲染器对容器型 show 的动态翻转不可靠（Pro 真机首启网格不出现，
         逛一次目标日回来才显示）；if 在 layoutReady 翻转时全新建节点，规避该坑 -->
    <scroll class="apps" if="{{ layoutReady && layout === 'grid' }}" scroll-y="true" bounces="true">
      <div class="grid" style="height: {{ gridHeight }}px;">
        <div class="f cell" for="{{ cells }}" @click="open($item)">
          <img class="icon" src="{{ $item.icon }}" />
          <text class="f name">{{ $item.name }}</text>
        </div>
      </div>
    </scroll>

    <list class="apps listApps" if="{{ layoutReady && layout === 'list' }}" bounces="true">
      <list-item type="app" class="rowCell" for="{{ cells }}" @click="open($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

    <!-- 分类单栏：与上面 list 分支逐字同构，只把 for 的数据源换成 catCells。
         用 if 不用 show（同上：Pro 真机容器型 show 翻转不可靠）；listPad 必须保留。 -->
    <list class="apps listApps" if="{{ layoutReady && layout === 'cat' }}" bounces="true">
      <list-item type="cat" class="rowCell" for="{{ catCells }}" @click="open($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.today {
  position: absolute;
  left: 3px;
  top: 92px;
  width: 206px;
  height: 88px;
  border-radius: 26px;
  background-color: #262626;
  padding: 8px 16px;
  flex-direction: column;
}
.todayTop {
  width: 174px;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.date {
  width: 108px;
  height: 24px;
  line-height: 24px;
  font-size: 14px;
  color: rgba(255,255,255,0.6);
  lines: 1;
  text-overflow: ellipsis;
}
.go {
  width: 66px;
  height: 24px;
  line-height: 24px;
  text-align: right;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
  lines: 1;
}
.event {
  width: 174px;
  height: 26px;
  line-height: 26px;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.delta {
  width: 174px;
  height: 22px;
  line-height: 22px;
  font-size: 15px;
  lines: 1;
}
.apps {
  position: absolute;
  left: 0px;
  top: 182px;
  width: 212px;
  height: 304px;
}
.listApps {
  background-color: #000000;
  padding: 0px 6px 0px 6px;
}
.grid {
  width: 212px;
  padding: 0px 3px 40px 3px;
  flex-direction: row;
  flex-wrap: wrap;
}
.cell {
  width: 97px;
  height: 70px;
  margin: 3px;
  border-radius: 26px;
  background-color: #1A1A1A;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  padding-top: 4px;
}
.icon {
  width: 28px;
  height: 28px;
}
.name {
  width: 93px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  font-size: 16px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowCell {
  width: 200px;
  height: 68px;
  margin: 0px 0px 8px 0px;
  border-radius: 26px;
  background-color: #1A1A1A;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0px 12px;
}
.rowIcon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
}
.rowMeta {
  width: 128px;
  height: 52px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.rowName {
  width: 128px;
  height: 26px;
  line-height: 26px;
  text-align: left;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowDesc {
  width: 128px;
  height: 20px;
  line-height: 20px;
  text-align: left;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
  text-overflow: ellipsis;
  lines: 1;
}
/* pad 不得宽于 list 内容盒（listApps 内容盒 200px）：原生 list 会把超宽子项计入横向
   可滚动范围（212px pad 即产生 12px 拖动空间，抢占右滑返回），同 lyrics/transfer 的 margin 坑 */
.listPad {
  width: 200px;
  height: 40px;
}
</style>

<script>
import g from '../../utils/g'
import apps from '../../data/apps'
import catData from '../../data/cats'
import layoutApi from '../../utils/homeLayout'
import homeEvents from '../../utils/homeEvents'
import { gridHeight } from '../../common/layout.js'

const SETTINGS_TILE = {
  id: '__settings__',
  name: '设置',
  desc: '首页样式 · 关于',
  route: '/pages/set',
  icon: '/common/icons/settings.png'
}

const CELLS = apps.concat([SETTINGS_TILE])

// 分类模式的行：9 个类别 + 末尾设置行（设置行走 route 分支，不进类别页）
const CAT_CELLS = catData.rows.concat([SETTINGS_TILE])

let layoutWatcher = null

export default {
  data: {
    clock: '--:--',
    dateText: '',
    eventTitle: '记录一个目标日',
    eventDelta: '把重要的日子放在心上',
    eventColor: 'rgba(255,255,255,0.4)',
    layout: 'grid',
    layoutReady: false,
    cells: CELLS,
    catCells: CAT_CELLS,
    gridHeight: gridHeight(CELLS.length),
    timer: null,
    _ck: null
  },
  onInit() {
    this.refreshClock()
    this.refreshDate()
  },
  onShow() {
    this.watchLayout()
    this.syncLayout()
    this.refresh()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.unwatchLayout()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  watchLayout() {
    if (layoutWatcher) return
    const app = layoutApi.api(this)
    if (!app || !app.watchHomeLayout) return
    const page = this
    layoutWatcher = function (mode) {
      if (!page.$valid) return
      page.applyLayout(mode)
    }
    app.watchHomeLayout(layoutWatcher)
  },
  unwatchLayout() {
    if (!layoutWatcher) return
    const app = layoutApi.api(this)
    if (app && app.unwatchHomeLayout) app.unwatchHomeLayout(layoutWatcher)
    layoutWatcher = null
  },
  syncLayout() {
    const app = layoutApi.api(this)
    if (app && app.getHomeLayout && app.isHomeLayoutReady && app.isHomeLayoutReady()) {
      this.applyLayout(app.getHomeLayout())
      return
    }
    if (app && app.watchHomeLayout) {
      // watchLayout 已注册，应用级数据就绪时会回调
      return
    }
    g.kv.init(() => {
      this.applyLayout(g.kv.get('home', 'grid'))
    })
  },
  applyLayout(mode) {
    const next = mode === 'list' ? 'list' : mode === 'cat' ? 'cat' : 'grid'
    if (this.layout !== next) this.layout = next
    if (!this.layoutReady) this.layoutReady = true
  },
  refresh() {
    this.refreshClock()
    this.refreshDate()
    // 目标日数据带 60 秒缓存：回到首页不必每次读盘 + 解析 + 全表遍历
    homeEvents.load((r) => {
      if (!r || !r.best) return
      const best = r.best
      this.eventTitle = best.item.title || best.item.display_name || '目标日'
      this.eventDelta = best.d.text
      this.eventColor = best.d.status === 'today' ? '#00C853' : '#0D6EFF'
    })
  },
  refreshDate() {
    const now = new Date()
    if (g.time && g.time.weekdayName) {
      this.dateText = now.getMonth() + 1 + '月' + now.getDate() + '日 ' + g.time.weekdayName(now)
    }
  },
  refreshClock() {
    if (g.time && g.time.formatClock) {
      this.clock = g.time.formatClock(new Date())
    }
  },
  open(item) {
    if (!item) return
    // 分类行带 cat（无 route）：进类别页；普通工具行与设置行带 route：直接进工具
    if (item.cat) {
      g.haptic.short()
      g.router.push('/pages/toolcat', { cat: item.cat })
      return
    }
    if (!item.route) return
    g.router.push(item.route)
  },
  openDays() {
    g.router.push('/pages/daysmatter/list')
  }
}
</script>
