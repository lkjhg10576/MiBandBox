<import name="pagehead" src="../../components/PageHead.ux"></import>

<template>
  <div class="page">
    <pagehead title="BandBox" clock="{{ clock }}"></pagehead>

    <div class="today" id="today" @click="openDays">
      <div class="todayTop">
        <text class="f date">{{ dateText }}</text>
        <text class="f go">目标日 ></text>
      </div>
      <text class="f event">{{ eventTitle }}</text>
      <text class="f delta" style="color: {{ eventColor }};">{{ eventDelta }}</text>
    </div>

    <!-- 网格模式：<list> 虚拟化（原来是一个 scroll 里铺满 30 个 cell），
         常驻节点从 ~100 降到 ~20，常驻图片从 29 降到 8。
         每行两个 cell；奇数个时最后一行用占位 cell 补齐（list-item 结构必须一致）。 -->
    <list class="apps" if="{{ layoutReady && layout === 'grid' }}" bounces="true">
      <list-item type="gridrow" class="gridRow" for="{{ rows }}" tid="id">
        <div class="f cell" @click="open($item.a)">
          <img class="icon" src="{{ $item.a.icon }}" />
          <text class="f name">{{ $item.a.name }}</text>
        </div>
        <div class="f cell" @click="open($item.b)">
          <img class="icon" src="{{ $item.b.icon }}" />
          <text class="f name">{{ $item.b.name }}</text>
        </div>
      </list-item>
    </list>

    <list class="apps listApps" if="{{ layoutReady && layout === 'list' }}" bounces="true">
      <list-item type="app" class="rowCell" for="{{ cells }}" @click="open($item)">
        <img class="rowIcon" src="{{ $item.icon }}" />
        <div class="rowMeta">
          <text class="f rowName">{{ $item.name }}</text>
          <text class="f rowDesc">{{ $item.desc }}</text>
        </div>
      </list-item>
      <list-item type="pad" class="listPad"></list-item>
    </list>

  </div>
</template>

<style>
@import '../../common/styles/theme.css';

.today {
  position: absolute;
  left: 3px;
  top: 92px;
  width: 206px;
  height: 88px;
  border-radius: 26px;
  background-color: #262626;
  padding: 8px 16px;
  flex-direction: column;
}
.todayTop {
  width: 174px;
  height: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}
.date {
  width: 118px;
  font-size: 14px;
  color: rgba(255,255,255,0.6);
}
.go {
  width: 54px;
  text-align: right;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
}
.event {
  width: 174px;
  height: 26px;
  line-height: 26px;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.delta {
  width: 174px;
  height: 22px;
  line-height: 22px;
  font-size: 15px;
}
.apps {
  position: absolute;
  left: 0px;
  top: 182px;
  width: 212px;
  height: 304px;
}
.listApps {
  background-color: #000000;
  padding: 0px 6px 0px 6px;
}
.gridRow {
  width: 206px;
  height: 76px;
  flex-direction: row;
  justify-content: space-between;
  margin: 0px 3px;
}
.cell {
  /* 必须显式写：list-item 是 flex 容器，缺省会把它压扁（textShow 已踩过同一个坑） */
  flex-shrink: 0;
  width: 97px;
  height: 70px;
  margin: 3px;
  border-radius: 26px;
  background-color: #1A1A1A;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  padding-top: 4px;
}
.icon {
  width: 28px;
  height: 28px;
}
.name {
  width: 93px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  font-size: 16px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowCell {
  width: 200px;
  height: 68px;
  margin: 0px 0px 8px 0px;
  border-radius: 26px;
  background-color: #1A1A1A;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 0px 12px;
}
.rowIcon {
  width: 34px;
  height: 34px;
  margin-right: 10px;
}
.rowMeta {
  width: 128px;
  height: 52px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.rowName {
  width: 128px;
  height: 26px;
  line-height: 26px;
  text-align: left;
  font-size: 17px;
  color: #FFFFFF;
  text-overflow: ellipsis;
  lines: 1;
}
.rowDesc {
  width: 128px;
  height: 20px;
  line-height: 20px;
  text-align: left;
  font-size: 14px;
  color: rgba(255,255,255,0.4);
  text-overflow: ellipsis;
  lines: 1;
}
.listPad {
  width: 212px;
  height: 40px;
}
</style>

<script>
import g from '../../utils/g'
import apps from '../../data/apps'
import layoutApi from '../../utils/homeLayout'
import perf from '../../utils/perf'
import homeEvents from '../../utils/homeEvents'

const SETTINGS_TILE = {
  id: '__settings__',
  name: '设置',
  desc: '首页样式 · 关于',
  route: '/pages/set',
  icon: '/common/icons/settings.png'
}

const CELLS = apps.concat([SETTINGS_TILE])

// 奇数个磁贴时用于补齐最后一行的占位（1×1 透明图，不可点）
const PAD_TILE = { id: '__pad__', name: '', route: '', icon: '/common/blank.png', desc: '' }

// 每行两个磁贴；<list> 的 list-item 结构必须完全一致，故用占位而不是 if
const ROWS = []
for (let i = 0; i < CELLS.length; i += 2) {
  ROWS.push({ id: 'r' + i, a: CELLS[i], b: CELLS[i + 1] || PAD_TILE })
}

let layoutWatcher = null

export default {
  data: {
    clock: '--:--',
    dateText: '',
    eventTitle: '记录一个目标日',
    eventDelta: '把重要的日子放在心上',
    eventColor: 'rgba(255,255,255,0.4)',
    layout: 'grid',
    layoutReady: false,
    cells: CELLS,
    rows: ROWS,
    timer: null,
    _ck: null
  },
  onShow() {
    perf.mark('home.show')
    this.watchLayout()
    this.syncLayout()
    this.refresh()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onReady() {
    perf.mark('home.ready')
    // 首屏渲染完成点（≈FMP）：布局测量回调能触发就用它，否则直接取 onReady 末尾
    const el = this.$element ? this.$element('today') : null
    if (el && el.getBoundingClientRect) {
      el.getBoundingClientRect(() => {
        perf.mark('home.layout')
        perf.summary()
      })
    }
    perf.mark('home.layout')
    perf.summary()
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    this.unwatchLayout()
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  watchLayout() {
    if (layoutWatcher) return
    const app = layoutApi.api(this)
    if (!app || !app.watchHomeLayout) return
    const page = this
    layoutWatcher = function (mode) {
      if (!page.$valid) return
      page.applyLayout(mode)
    }
    app.watchHomeLayout(layoutWatcher)
  },
  unwatchLayout() {
    if (!layoutWatcher) return
    const app = layoutApi.api(this)
    if (app && app.unwatchHomeLayout) app.unwatchHomeLayout(layoutWatcher)
    layoutWatcher = null
  },
  syncLayout() {
    const app = layoutApi.api(this)
    if (app && app.getHomeLayout && app.isHomeLayoutReady && app.isHomeLayoutReady()) {
      this.applyLayout(app.getHomeLayout())
      return
    }
    if (app && app.watchHomeLayout) {
      // watchLayout 已注册，应用级数据就绪时会回调
      return
    }
    g.kv.init(() => {
      this.applyLayout(g.kv.get('home', 'grid'))
    })
  },
  applyLayout(mode) {
    const next = mode === 'list' ? 'list' : 'grid'
    if (this.layout !== next) this.layout = next
    if (!this.layoutReady) this.layoutReady = true
  },
  refresh() {
    this.refreshClock()
    const now = new Date()
    this.dateText = now.getMonth() + 1 + '月' + now.getDate() + '日 ' + g.time.weekdayName(now)
    // 目标日数据带 60 秒缓存：回到首页不必每次读盘 + 解析 + 全表遍历
    homeEvents.load((r) => {
      perf.mark('home.events')
      if (!r || !r.best) return
      const best = r.best
      this.eventTitle = best.item.title || best.item.display_name || '目标日'
      this.eventDelta = best.d.text
      this.eventColor = best.d.status === 'today' ? '#00C853' : '#0D6EFF'
    })
  },
  refreshClock() {
    this.clock = g.time.formatClock(new Date())
  },
  open(item) {
    if (!item || !item.route) return
    g.router.push(item.route)
  },
  openDays() {
    g.router.push('/pages/daysmatter/list')
  }
}
</script>
