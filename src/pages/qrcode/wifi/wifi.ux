<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ awake }}">
    <pagehead title="WiFi 二维码" clock="{{ clock }}"></pagehead>

    <scroll class="formScroll" scroll-y="true" bounces="true">
      <div class="inner">
        <!-- SSID 与密码都跳通用输入页（/pages/input），本页不再挂输入法组件 -->
        <div class="field" @click="pickSsid">
          <text class="f fLabel">WiFi 名称（SSID）</text>
          <text class="f fValue" if="{{ ssid }}">{{ ssid }}</text>
          <text class="f fPlace" if="{{ !ssid }}">点击输入 WiFi 名称</text>
        </div>

        <div class="field" style="background-color: {{ auth === 'nopass' ? '#1E1E1E' : '#262626' }};" @click="pickPass">
          <text class="f fLabel">密码</text>
          <text class="f fValue" if="{{ pass }}">{{ pass }}</text>
          <text class="f fPlace" if="{{ !pass }}">{{ auth === 'nopass' ? '开放网络无需密码' : '点击输入密码' }}</text>
        </div>

        <div class="chips">
          <div class="chip" style="background-color: {{ auth === 'WPA' ? '#0D6EFF' : '#1E1E1E' }};" @click="pickAuth('WPA')"><text class="f chipT">WPA</text></div>
          <div class="chip" style="background-color: {{ auth === 'WEP' ? '#0D6EFF' : '#1E1E1E' }};" @click="pickAuth('WEP')"><text class="f chipT">WEP</text></div>
          <div class="chip" style="background-color: {{ auth === 'nopass' ? '#0D6EFF' : '#1E1E1E' }};" @click="pickAuth('nopass')"><text class="f chipT">开放</text></div>
        </div>

        <div class="hidCard" @click="toggleHidden">
          <text class="f hidLabel">隐藏网络</text>
          <text class="f hidVal" style="color: {{ hidden ? '#0D6EFF' : 'rgba(255,255,255,0.4)' }};">{{ hidden ? '已开启' : '未开启' }}</text>
        </div>

        <div class="go" @click="onGen"><text class="f goT">生成二维码</text></div>
      </div>
    </scroll>

    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../../common/styles/theme.css';
/* 表单整体放 scroll 里：一屏放不下往下翻（参照 notebook/edit 的滚动习惯） */
.formScroll { position: absolute; left: 0px; top: 78px; width: 212px; height: 442px; }
.inner { width: 212px; height: 268px; flex-direction: column; }
.field { width: 206px; margin: 0px 3px 8px 3px; height: 40px; border-radius: 20px; background-color: #262626; padding: 4px 16px; flex-direction: column; border-width: 1px; border-style: solid; border-color: transparent; flex-shrink: 0; }
.fLabel { width: 174px; height: 16px; line-height: 16px; font-size: 14px; color: rgba(255,255,255,0.55); }
.fValue { width: 174px; height: 20px; line-height: 20px; font-size: 15px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.fPlace { width: 174px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.45); }
.chips { margin: 4px 6px 0px 6px; height: 32px; flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.chip { width: 62px; height: 32px; border-radius: 16px; background-color: #1E1E1E; align-items: center; justify-content: center; }
.chipT { font-size: 14px; color: #FFFFFF; }
.hidCard { width: 206px; margin: 8px 3px 0px 3px; height: 44px; border-radius: 20px; background-color: #262626; padding: 0px 16px; flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.hidLabel { font-size: 14px; color: rgba(255,255,255,0.7); }
.hidVal { font-size: 14px; }
.go { width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; margin: 12px 26px 0px 26px; flex-shrink: 0; }
.goT { font-size: 14px; color: #FFFFFF; }
</style>

<script>
import g from '../../../utils/g'
import prompt from '@system.prompt'
import wifi from '../../../utils/wifi'
import inputResult from '../../../utils/inputResult'
import life from '../../../utils/pageLife'

export default life({
  data: {
    _ck: null,
    clock: '--:--',
    ssid: '',
    pass: '',
    auth: 'WPA',
    hidden: false,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    // 通用输入页（/pages/input）的结果是一次性文件，take 后即删除：
    // ① 必须在任何初始化之外 —— 从输入页返回时 onShow 会再跑一次，这时才取得到结果；
    // ② 一次只能 take 一份结果，所以 SSID 与密码两个字段分支并进同一次 take。
    // 本页没有 KV/文件重载、也没有 protected 参数赋值，故不存在会在返回时覆盖刚取回值的初始化。
    inputResult.take((r) => {
      if (!r || !r.field) return
      // 长度由 /pages/input 按 max 裁剪（multiline=0 会把换行归一为空格）
      if (r.field === 'wifiSsid') this.ssid = String(r.value || '')
      else if (r.field === 'wifiPass') this.pass = String(r.value || '')
    })
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  pickSsid() {
    g.haptic.short()
    g.router.push('/pages/input', {
      field: 'wifiSsid',
      inputTitle: 'WiFi 名称',
      text: this.ssid,
      max: 32,
      multiline: 0,
      hint: '最多 32 字'
    })
  },
  pickPass() {
    if (this.auth === 'nopass') {
      prompt.showToast({ message: '开放网络无需密码', duration: 1200 })
      return
    }
    g.haptic.short()
    g.router.push('/pages/input', {
      field: 'wifiPass',
      inputTitle: 'WiFi 密码',
      text: this.pass,
      max: 64,
      multiline: 0,
      hint: '最多 64 字'
    })
  },
  pickAuth(name) {
    g.haptic.short()
    this.auth = name
  },
  toggleHidden() {
    g.haptic.short()
    this.hidden = !this.hidden
  },
  /**
   * 生成：buildWifi → 校验总长（字节 <= 600 且字符 <= 200，超了 toast）
   * → show 页现场生成（fav='1' 带收藏按钮）。
   * 不经过 qrcode.ux 的 80 字符 clamp（不动它的计数器与替换对）。
   */
  onGen() {
    if (!this.ssid) {
      prompt.showToast({ message: '请先输入 WiFi 名称', duration: 1500 })
      return
    }
    if (this.auth !== 'nopass' && !this.pass) {
      prompt.showToast({ message: '请先输入密码', duration: 1500 })
      return
    }
    const str = wifi.buildWifi({ ssid: this.ssid, pass: this.pass, auth: this.auth, hidden: this.hidden })
    if (str.length > 200 || wifi.byteLength(str) > 600) {
      prompt.showToast({ message: 'SSID 或密码过长', duration: 1500 })
      return
    }
    g.haptic.short()
    g.router.push('/pages/qrcode/show', { qr: str, fav: '1' })
  }
})
</script>
