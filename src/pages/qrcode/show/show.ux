<import name="pagehead" src="../../../components/PageHead.ux"></import>

<template>
  <div class="page">
    <pagehead if="{{ !isBar }}" title="扫码查看" clock="{{ clock }}"></pagehead>

    <!-- 每个可显示元素各自带 if + 完整几何类：不再用无几何的包装 div（Vela 不为其绝对定位
         子元素布局，会整页空白），也不让包装层盖住页头返回命中区。 -->
    <div class="qrCard" if="{{ !isBar }}" @click="back">
      <qrcode class="qr" value="{{ qr }}"></qrcode>
    </div>
    <text class="f text" if="{{ !isBar }}" @click="back">{{ qr }}</text>
    <div class="barBtn" if="{{ !isBar && canBar }}" @click="toggleBar">
      <text class="f barBtnT">切为横屏条形码</text>
    </div>
    <text class="f hint" if="{{ !isBar && fav !== '1' }}" @click="back">轻触屏幕返回</text>
    <div class="favBtn" if="{{ !isBar && fav === '1' }}" @click="onFavTap">
      <text class="f favT">{{ faved ? '已收藏' : '收藏' }}</text>
    </div>

    <div class="landWrap" if="{{ isBar }}">
      <div class="barBox">
        <div class="barCard" @click="toggleBar">
          <barcode class="barcode" value="{{ qr }}" style="color: #000000; background-color: #FFFFFF;"></barcode>
        </div>
        <text class="f barText">{{ qr }}</text>
        <div class="barActs">
          <div class="barActBtn" @click="toggleBar">
            <text class="f barActT">切回二维码</text>
          </div>
          <div class="barActBtn" style="background-color: #262626;" @click="back">
            <text class="f barActT">返回</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.qrCard { position: absolute; left: 26px; top: 90px; width: 160px; height: 160px; border-radius: 26px; background-color: #FFFFFF; padding: 12px; align-items: center; justify-content: center; }
.qr { width: 136px; height: 136px; background-color: #FFFFFF; }
.text { position: absolute; left: 20px; top: 258px; width: 172px; font-size: 15px; line-height: 21px; color: rgba(255,255,255,0.75); text-align: center; lines: 4; text-overflow: ellipsis; }
.barBtn { position: absolute; left: 26px; top: 396px; width: 160px; height: 36px; border-radius: 18px; background-color: #14324F; align-items: center; justify-content: center; }
.barBtnT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.55); }
.favBtn { position: absolute; left: 26px; top: 434px; width: 160px; height: 32px; border-radius: 16px; background-color: #262626; align-items: center; justify-content: center; }
.favT { font-size: 14px; color: #4E87FF; }

.landWrap { position: absolute; left: 212px; top: 0px; width: 520px; height: 212px; transform-origin: 0 0; transform: rotate(90deg); padding: 12px 54px 12px 24px; align-items: center; justify-content: center; background-color: #000000; }
.barBox { width: 420px; height: 184px; flex-direction: column; align-items: center; justify-content: space-between; }
.barCard { width: 380px; height: 92px; border-radius: 16px; background-color: #FFFFFF; padding: 10px 14px; align-items: center; justify-content: center; }
.barcode { width: 352px; height: 72px; background-color: #FFFFFF; }
.barText { width: 400px; height: 22px; line-height: 22px; font-size: 16px; color: rgba(255,255,255,0.85); text-align: center; lines: 1; text-overflow: ellipsis; }
.barActs { width: 280px; height: 36px; flex-direction: row; justify-content: space-between; align-items: center; }
.barActBtn { width: 132px; height: 36px; border-radius: 18px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.barActT { font-size: 14px; color: #FFFFFF; }
</style>

<script>
import g from '../../../utils/g'
import brightness from '@system.brightness'
import prompt from '@system.prompt'
import qrFavStore from '../../../utils/qrFavStore'

export default {
  protected: { qr: '', fav: '', favId: '', kind: '' },
  private: { clock: '--:--', timer: null, faved: false, canBar: false, isBar: false, activeFavId: '' },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })

    const eligible = qrFavStore.canEncodeBarcode(this.qr)
    this.canBar = eligible && (this.fav === '1' || this.fav === '0')
    this.isBar = this.canBar && this.kind === 'barcode'
    this.activeFavId = this.favId || ''

    if (this.fav === '1') {
      g.kv.init(() => {
        if (!page.$valid) return
        page.faved = qrFavStore.has(page.qr)
      })
    }
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  toggleBar() {
    if (!this.canBar) return
    g.haptic.short()
    this.isBar = !this.isBar
    const nextKind = this.isBar ? 'barcode' : 'qr'
    if (this.activeFavId) {
      qrFavStore.updateMeta(this.activeFavId, { kind: nextKind }, () => {})
    }
  },
  onFavTap() {
    if (this.faved) {
      prompt.showToast({ message: '已在收藏中', duration: 1200 })
      return
    }
    const page = this
    const curKind = this.isBar ? 'barcode' : 'qr'
    qrFavStore.add(this.qr, 'local', (r) => {
      if (!page.$valid) return
      if (r && r.ok) {
        page.faved = true
        if (r.item && r.item.id) page.activeFavId = r.item.id
        prompt.showToast({ message: r.duplicate ? '已在收藏中' : '已收藏', duration: 1200 })
      } else {
        prompt.showToast({
          message: r && r.reason === 'too-large' ? '内容过长，无法收藏' : '收藏失败，请重试',
          duration: 1500
        })
      }
    }, { kind: curKind })
  },
  back() {
    g.router.back()
  }
}
</script>
