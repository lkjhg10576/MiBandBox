<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ !awake }}"><text class="napLoadT">加载中…</text></div><div class="napWrap" if="{{ awake }}">
    <pagehead title="{{ title }}" clock="{{ clock }}"></pagehead>

    <scroll class="body" scroll-y="true" bounces="true" if="{{ !detail }}">
      <div class="inner" style="height: {{ listInnerH }}px;">
        <div class="itemWrap" for="{{ items }}">
          <div class="favCard" @click="tapItem($item)">
            <text class="f favText">{{ $item.short }}</text>
            <text class="f favMeta">{{ $item.meta }}</text>
          </div>
          <div class="favOps" @click="tapDetail($item)">
            <text class="f favOpsT">备注 / 详情 / 删除</text>
          </div>
        </div>
        <div class="empty" if="{{ items.length === 0 }}">
          <text class="f emptyT">还没有收藏</text>
          <text class="f emptyS">生成或从手机导入后点「收藏」</text>
        </div>
        <div class="pad"></div>
      </div>
    </scroll>

    <div class="dWrap" if="{{ detail }}">
      <scroll class="dBody" scroll-y="true" bounces="true">
        <text class="f full" style="height: {{ detailTextH }}px;">{{ detailText }}</text>
        <div class="dPad"></div>
      </scroll>
      <div class="aliasBtn" @click="editAlias">
        <text class="f aliasT">{{ detailLabel ? '备注：' + detailLabel : '设置备注名' }}</text>
      </div>
      <div class="genBtn" @click="onRegen"><text class="f genT">{{ detailKind === 'barcode' ? '以条形码查看' : '重新生成二维码' }}</text></div>
      <div class="delBtn" style="background-color: {{ armed ? '#FF3B30' : '#262626' }};" @click="tapDelete">
        <text class="f delT">{{ armed ? '再次点击以取消' : '取消收藏' }}</text>
      </div>
      <div class="listBtn" @click="backToList"><text class="f listT">返回列表</text></div>
    </div>

    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../../common/styles/theme.css';
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 438px; }
.inner { width: 212px; flex-direction: column; }
.itemWrap { width: 212px; flex-direction: column; flex-shrink: 0; }
.favCard { width: 206px; height: 64px; margin: 0px 3px 6px 3px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; flex-shrink: 0; }
.favText { width: 174px; height: 24px; line-height: 24px; font-size: 16px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.favMeta { width: 174px; height: 18px; line-height: 18px; font-size: 14px; color: rgba(255,255,255,0.55); text-overflow: ellipsis; lines: 1; }
.favOps { width: 206px; margin: 0px 3px 8px 3px; height: 30px; border-radius: 15px; background-color: #1E1E1E; align-items: center; justify-content: center; flex-shrink: 0; }
.favOpsT { font-size: 14px; color: rgba(255,255,255,0.55); }
.empty { width: 212px; height: 200px; align-items: center; justify-content: center; flex-direction: column; flex-shrink: 0; }
.emptyT { font-size: 16px; color: rgba(255,255,255,0.6); }
.emptyS { margin-top: 10px; font-size: 14px; color: rgba(255,255,255,0.55); }
.pad { width: 212px; height: 48px; flex-shrink: 0; }

.dWrap { position: absolute; left: 0px; top: 0px; width: 212px; height: 466px; }
.dBody { position: absolute; left: 0px; top: 82px; width: 212px; height: 146px; }
.full { width: 174px; margin: 12px 19px 0px 19px; font-size: 15px; line-height: 22px; color: rgba(255,255,255,0.85); }
.dPad { width: 174px; height: 16px; }
.aliasBtn { position: absolute; left: 3px; top: 236px; width: 206px; height: 42px; border-radius: 21px; background-color: #1A1A1A; padding: 0px 14px; align-items: center; justify-content: center; }
.aliasT { width: 178px; font-size: 14px; color: #4E87FF; text-align: center; lines: 1; text-overflow: ellipsis; }
.genBtn { position: absolute; left: 3px; top: 286px; width: 206px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.genT { font-size: 14px; color: #FFFFFF; }
.delBtn { position: absolute; left: 3px; top: 342px; width: 206px; height: 40px; border-radius: 20px; background-color: #262626; align-items: center; justify-content: center; }
.delT { font-size: 14px; color: #FFFFFF; }
.listBtn { position: absolute; left: 3px; top: 390px; width: 206px; height: 40px; border-radius: 20px; background-color: #262626; align-items: center; justify-content: center; }
.listT { font-size: 14px; color: rgba(255,255,255,0.75); }
</style>

<script>
import g from '../../../utils/g'
import prompt from '@system.prompt'
import qrFavStore from '../../../utils/qrFavStore'
import qrBridge from '../../../utils/qrBridge'
import inputResult from '../../../utils/inputResult'
import textMetrics from '../../../utils/textMetrics'
import { TEXT } from '../../../common/layout'
import life from '../../../utils/pageLife'

const ITEM_ROW_H = 108
const LIST_PAD_H = 48

function fmtTime(ms) {
  if (!ms) return ''
  const d = new Date(ms)
  return (
    d.getFullYear() + '-' + g.time.pad2(d.getMonth() + 1) + '-' + g.time.pad2(d.getDate()) +
    ' ' + g.time.formatClock(d)
  )
}

export default life({
  data: {
    _ck: null,
    _unsub: null,
    clock: '--:--',
    title: '二维码收藏',
    items: [],
    listInnerH: 260,
    timer: null,
    detail: false,
    detailId: '',
    detailText: '',
    detailLabel: '',
    detailKind: 'qr',
    detailTextH: 48,
    armed: false
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    this._unsub = qrFavStore.subscribe(() => {
      if (page.$valid) page.loadItems()
    })
    this.armed = false
    inputResult.take((r) => {
      if (!r || r.field !== 'qrFavLabel' || !page.detailId) return
      qrFavStore.updateMeta(page.detailId, { label: r.value }, (res) => {
        if (!page.$valid) return
        if (res && res.ok) {
          page.detailLabel = res.item.label || ''
          page.loadItems()
          prompt.showToast({ message: page.detailLabel ? '备注名已保存' : '已清除备注名', duration: 1200 })
        }
      })
    })
    this.loadItems()
    qrBridge.init()
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    if (this._unsub) { this._unsub(); this._unsub = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    if (this._unsub) { this._unsub(); this._unsub = null }
  },
  loadItems() {
    g.kv.init(() => {
      if (!this.$valid) return
      const all = qrFavStore.list()
      this.items = all.map((it) => ({
        id: it.id,
        text: it.text,
        label: it.label || '',
        kind: it.kind || 'qr',
        short: it.label || it.text.slice(0, 20),
        meta:
          (it.source === 'plugin' ? '来自手机' : '手环生成') +
          (it.kind === 'barcode' ? ' · 条码' : '') +
          ' · ' + fmtTime(it.createdAt)
      }))
      this.listInnerH = this.items.length > 0 ? this.items.length * ITEM_ROW_H + LIST_PAD_H : 260
      if (this.detail && this.detailId) {
        const latest = qrFavStore.getById(this.detailId)
        if (latest) {
          this.detailLabel = latest.label || ''
          this.detailKind = latest.kind || 'qr'
          this.detailText = latest.text || this.detailText
          this.updateDetailHeight()
        }
      }
    })
  },
  updateDetailHeight() {
    const h = textMetrics.textHeight(this.detailText, TEXT.inputW, 15, 22)
    this.detailTextH = Math.max(24, h || 24)
  },
  tapItem(item) {
    g.haptic.short()
    g.router.push('/pages/qrcode/show', {
      qr: item.text,
      fav: '0',
      favId: item.id,
      kind: item.kind || 'qr'
    })
  },
  tapDetail(item) {
    g.haptic.short()
    this.detailId = item.id
    this.detailText = item.text
    this.detailLabel = item.label || ''
    this.detailKind = item.kind || 'qr'
    this.updateDetailHeight()
    this.armed = false
    this.detail = true
    this.title = '收藏详情'
  },
  closeDetail() {
    this.detail = false
    this.armed = false
    this.title = '二维码收藏'
  },
  backToList() {
    g.haptic.short()
    this.closeDetail()
  },
  editAlias() {
    if (!this.detailId) return
    g.haptic.short()
    g.router.push('/pages/input', {
      field: 'qrFavLabel',
      inputTitle: '收藏备注名',
      text: this.detailLabel || '',
      max: qrFavStore.MAX_LABEL_LEN,
      multiline: 0,
      hint: '最多 ' + qrFavStore.MAX_LABEL_LEN + ' 字，留空则显示原文'
    })
  },
  onRegen() {
    if (!this.detailText) {
      prompt.showToast({ message: '收藏内容缺失，可能已被删除', duration: 1500 })
      return
    }
    g.haptic.short()
    g.router.push('/pages/qrcode/show', {
      qr: this.detailText,
      fav: '0',
      favId: this.detailId,
      kind: this.detailKind || 'qr'
    })
  },
  tapDelete() {
    if (!this.armed) {
      g.haptic.short()
      this.armed = true
      return
    }
    g.haptic.long()
    const page = this
    qrFavStore.remove(this.detailId, (found) => {
      if (!page.$valid) return
      prompt.showToast({ message: found ? '已取消收藏' : '收藏不存在', duration: 1200 })
      page.closeDetail()
      page.loadItems()
    })
  }
})
</script>
