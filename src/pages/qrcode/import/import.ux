<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="从手机导入" clock="{{ clock }}"></pagehead>

    <list class="list" bounces="true">
      <list-item type="row" class="card" for="{{ rows }}" @click="onRow($item)">
        <div class="cMain">
          <text class="f cTitle">{{ $item.title }}</text>
          <text class="f cSub">{{ $item.sub }}</text>
        </div>
        <text class="f arrow" if="{{ $item.arrow }}">{{ $item.arrow }}</text>
      </list-item>
      <list-item type="pad" class="pad"></list-item>
    </list>

    <text class="f tip">保持本页打开，在手机插件的「二维码」页粘贴文本并发送</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; overflow: hidden; }
/* 列表项不留横向 margin：原生 list 会把子项 margin 计入可横向滚动范围（3px 边距即产生可拖动空间，抢占右滑返回），内缩改由 list 自身 padding 提供。 */
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; padding: 0px 3px 0px 3px; }
.card { width: 206px; height: 72px; margin: 0px 0px 8px 0px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 14px 0px 16px; }
.cMain { width: 140px; height: 54px; flex-direction: column; justify-content: center; }
.cTitle { width: 140px; height: 28px; line-height: 28px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 140px; height: 20px; line-height: 20px; font-size: 14px; color: rgba(255,255,255,0.6); }
.arrow { width: 26px; height: 24px; line-height: 24px; text-align: right; font-size: 20px; color: rgba(255,255,255,0.4); }
.pad { width: 206px; height: 60px; }
.tip { position: absolute; left: 21px; top: 410px; width: 170px; height: 54px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.35); background-color: #000000; }
</style>

<script>
import g from '../../../utils/g'
import interconnectUtil from '../../../utils/interconnect'
import otpProtocol from '../../../utils/otpProtocol'
import qrProtocol from '../../../utils/qrProtocol'
import qrFavStore from '../../../utils/qrFavStore'
import qrBridge from '../../../utils/qrBridge'
import prompt from '@system.prompt'
import brightness from '@system.brightness'

/**
 * 二维码「从手机导入」接收页：UI 骨架与 otp/sync、lyrics/transfer 同一套。
 *
 * 分工：qrBridge 负责收 qr_import 并落库收藏（协议栈不在启动路径，
 * 由本页进入时认领 pushInbox 缓冲、接手推送），
 * 本页只做「看得见」的部分 —— 连接状态、接收结果展示、跳转收藏。
 * bandbox-qr 协议消息集只有 qr_import/qr_ack/qr_err 三条、没有心跳消息，
 * 连接检测复用同一插件的心跳链路：插件每 5 秒无条件下发 bandbox-otp hello，
 * 本页与 otp/sync 页同一套 probe/tick 逻辑（ping → pong / 收到任何 OTP 消息
 * 都算插件在线），qr_import 本身更是直接的在线证据。
 *
 * 页面内部状态：定时器、订阅句柄、心跳与计数基线。
 * 这些值放在模块闭包里，不进入 data 的响应式代理（与 otp/sync 同一思路）。
 */
const state = {
  timer: null,
  subscriber: null,
  statusSubscriber: null,
  storeSubscriber: null,
  pingId: '',
  pingSeq: 0,
  lastProbeAt: 0,
  lastHeardAt: 0,
  connected: false,
  timeoutReported: false,
  diagnosing: false,
  base: 0,
  baseReady: false,
  lastTotal: 0
}

function newId(prefix) {
  return prefix + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 6)
}

export default {
  data: {
    clock: '--:--',
    rows: [],
    connText: '检测中',
    stateText: '等待手机心跳',
    lastText: '',
    totalCount: 0
  },

  onShow() {
    this.clock = g.time.formatClock(new Date())
    state.connected = false
    // 从进入页面开始给手机插件 12 秒心跳宽限
    state.lastHeardAt = Date.now()
    state.lastProbeAt = 0
    state.pingId = ''
    state.timeoutReported = false
    state.diagnosing = false

    this.connText = '检测中'
    this.stateText = '等待手机心跳'
    this.lastText = ''

    // 进页时的收藏总数是「本次导入」的计数基线；
    // 落库全部由常驻 qrBridge 完成，本页只观察 qrFavStore 的变化
    state.baseReady = false
    const page = this
    g.kv.init(() => {
      if (!page.$valid) return
      const total = qrFavStore.list().length
      state.base = total
      state.lastTotal = total
      state.baseReady = true
      page.totalCount = total
      page.refreshRows()
    })
    this.refreshRows()

    this.arm()
    // 认领启动期间缓冲的二维码推送（协议栈不在启动路径，进入本页时才接手）。
    // 放在 arm() 之后：回放落库会 notify qrFavStore，本页要先挂上监听。
    qrBridge.init()
    this.probe()

    brightness.setKeepScreenOn({ keepScreenOn: true, success: () => {}, fail: () => {} })

    if (state.timer) clearInterval(state.timer)
    state.timer = setInterval(() => {
      this.clock = g.time.formatClock(new Date())
      this.tick()
    }, 5000)
  },

  onHide() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  onDestroy() {
    this.disarm()
    if (state.timer) {
      clearInterval(state.timer)
      state.timer = null
    }
    brightness.setKeepScreenOn({ keepScreenOn: false, success: () => {}, fail: () => {} })
  },

  /**
   * 重建列表内容。
   */
  refreshRows() {
    const rows = []
    rows.push({
      title: this.connText,
      sub: this.stateText,
      act: ''
    })
    if (this.lastText) {
      rows.push({
        title: '已接收：' + this.lastText.slice(0, 10),
        sub: '已存入收藏，共 ' + this.totalCount + ' 条',
        act: ''
      })
    }
    rows.push({
      title: '打开我的收藏',
      sub: '查看与现场生成二维码',
      act: 'favs',
      arrow: '>'
    })
    rows.push({
      title: '重新检测连接',
      sub: '检测手机插件的连接',
      act: 'recheck',
      arrow: '>'
    })
    rows.push({
      title: '返回快捷生码',
      sub: '回到生码主页',
      act: 'back',
      arrow: '>'
    })
    this.rows = rows
  },

  /**
   * 订阅手机消息、连接状态与收藏落库事件。
   * 不调 clearLastMessage()：缓存里可能有歌词等其它协议的消息，
   * 由各协议自己的页面决定怎么用（与 otp/sync 同一口径）。
   */
  arm() {
    if (state.subscriber) return
    state.subscriber = interconnectUtil.onMessage((text) => {
      this.handle(text)
    })
    state.statusSubscriber = interconnectUtil.onStatus((status) => {
      if (
        status === 1 &&
        !state.connected &&
        state.lastProbeAt > 0 &&
        Date.now() - state.lastProbeAt > 1000
      ) {
        this.probe()
      }
    })
    state.storeSubscriber = qrFavStore.subscribe(() => {
      this.onStoreChanged()
    })
  },

  disarm() {
    if (state.subscriber) {
      try { state.subscriber() } catch (e) {}
      state.subscriber = null
    }
    if (state.statusSubscriber) {
      try { state.statusSubscriber() } catch (e) {}
      state.statusSubscriber = null
    }
    if (state.storeSubscriber) {
      try { state.storeSubscriber() } catch (e) {}
      state.storeSubscriber = null
    }
  },

  /**
   * 收藏落库后的界面更新（qrBridge 写库成功会 notify；重复文本不 notify）。
   */
  onStoreChanged() {
    if (!this.$valid) return
    const total = qrFavStore.list().length
    this.totalCount = total
    if (state.baseReady && total > state.lastTotal) {
      g.haptic.short()
      prompt.showToast({ message: '已存入「我的收藏」', duration: 1500 })
    }
    state.lastTotal = total
    this.refreshRows()
  },

  /**
   * 发一次 ping（best-effort）：bandbox-otp 的 ping，插件会回 pong。
   * 部分固件下手环→手机方向不可用，发送失败不判死；
   * 真正的连接状态以插件每 5 秒下发的 hello 心跳为准。
   */
  probe() {
    state.lastProbeAt = Date.now()
    if (!interconnectUtil.isReady()) interconnectUtil.init()
    if (!interconnectUtil.isReady()) return

    state.pingSeq++
    const id = newId('qp')
    state.pingId = id
    const sent = interconnectUtil.send(otpProtocol.pingMessage(id), () => {}, () => {})
    if (!sent) {
      state.pingId = ''
    }
  },

  /**
   * 5 秒一次的定时心跳任务：未连接时继续探测，已连接时检查心跳是否超时。
   */
  tick() {
    const now = Date.now()
    if (state.connected) {
      if (now - state.lastHeardAt > 20000) {
        this.markDisconnected('未收到插件心跳')
        this.diagnose()
      }
      return
    }

    // 进页面后给手机插件 12 秒心跳宽限；超时只提示一次
    if (now - state.lastHeardAt > 12000 && !state.timeoutReported) {
      state.timeoutReported = true
      this.markDisconnected('未收到插件心跳')
      this.diagnose()
    }

    if (now - state.lastProbeAt >= 5000) {
      this.probe()
    }
  },

  /**
   * 标记已连接手机插件。
   */
  markConnected() {
    const was = state.connected
    state.connected = true
    state.lastHeardAt = Date.now()
    state.timeoutReported = false
    state.pingId = ''
    if (!was) {
      this.connText = '已连接手机'
      this.stateText = '插件在线，在手机上发送即可'
      this.refreshRows()
      g.haptic.short()
    }
  },

  /**
   * 标记未连接，并保留具体原因。
   */
  markDisconnected(reason) {
    const was = state.connected
    state.connected = false
    this.connText = '未连接手机'
    this.stateText = reason || '请打开手机插件'
    this.refreshRows()
    if (was) g.haptic.short()
  },

  /**
   * 诊断对端连接状态（getReadyState/diagnosis 只作提示，以心跳为准）。
   */
  diagnose() {
    if (state.diagnosing) return
    state.diagnosing = true
    interconnectUtil.diagnosis(3000, (code) => {
      state.diagnosing = false
      if (state.connected) return
      if (code === 0) {
        this.stateText = '蓝牙已连，插件未响应'
      } else if (code === 1001) {
        this.stateText = '未启用手机插件'
      } else if (code === 204) {
        this.stateText = '连接超时，请检查蓝牙'
      } else if (code) {
        this.stateText = '诊断码 ' + code
      } else {
        this.stateText = '请打开手机插件'
      }
      this.refreshRows()
    })
  },

  /**
   * 处理一条来自手机的原始消息。
   * bandbox-qr 的 qr_import 是接收本体；其余消息里 bandbox-otp 的
   * hello/pong 心跳是「插件在线」的证据（歌词等其它协议静默忽略）。
   */
  handle(raw) {
    const parsed = qrProtocol.parse(raw)
    if (parsed.ok) {
      if (parsed.msg.type === 'qr_import') this.onImport(parsed.msg)
      return
    }
    const o = otpProtocol.parse(raw)
    if (o.ok) this.markConnected()
  },

  /**
   * 收到一条二维码文本：展示结果。落库与回执由常驻 qrBridge 完成
   * （重复文本不触发 qrFavStore notify，本页计数不变但内容行照常展示）。
   */
  onImport(msg) {
    this.markConnected()
    const t = typeof msg.text === 'string' ? msg.text : ''
    if (!t) return
    this.lastText = t
    this.connText = '已接收'
    this.stateText = '已存入「我的收藏」'
    this.refreshRows()
  },

  onRow(item) {
    if (item.act === 'favs') {
      g.haptic.short()
      g.router.push('/pages/qrcode/fav')
      return
    }
    if (item.act === 'recheck') {
      g.haptic.short()
      state.connected = false
      state.lastHeardAt = Date.now()
      state.timeoutReported = false
      this.connText = '检测中'
      this.stateText = '等待手机心跳'
      this.refreshRows()
      state.lastProbeAt = 0
      this.probe()
      return
    }
    if (item.act === 'back') {
      g.haptic.short()
      g.router.back()
    }
  }
}
</script>
