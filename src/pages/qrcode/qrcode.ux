<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <pagehead title="快捷生码" clock="{{ clock }}"></pagehead>
    <div class="inputCard {{ kbShow ? 'inputCardKb' : '' }}" @click="openKb">
      <text class="f iLabel">文本内容</text>
      <text class="f iText" if="{{ text }}">{{ text }}</text>
      <text class="f iPlace" if="{{ !text }}">点击输入文字或网址</text>
      <text class="f counter">{{ text.length }}/80</text>
    </div>

    <div class="quick">
      <div class="chip" for="{{ presets }}" @click="usePreset($item)"><text class="f chipT">{{ $item }}</text></div>
    </div>

    <div class="go {{ text ? '' : 'off' }}" @click="generate"><text class="f goT">生成二维码</text></div>
    <text class="f hint">二维码仅在本机生成</text>

    <div class="favEntry" @click="openFavs"><text class="f favEntryT">我的收藏</text></div>

    <backbtn></backbtn>
    <div class="kbBar" show="{{ kbShow }}" @click="closeKb"><text class="f kbBarT">完成</text></div>
    <input-method hide="{{ !kbShow }}" keyboardtype="QWERTY" maxlength="5" vibratemode="short" screentype="pill-shaped" @complete="onKey" @delete="onDel"></input-method>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.inputCard { position: absolute; left: 3px; top: 78px; width: 206px; height: 108px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; }
.inputCardKb { top: 44px; }
.iLabel { width: 174px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.5); }
.iText { width: 150px; height: 52px; font-size: 17px; line-height: 22px; color: #FFFFFF; text-overflow: ellipsis; lines: 2; }
.iPlace { width: 150px; height: 52px; font-size: 15px; line-height: 22px; color: rgba(255,255,255,0.35); text-overflow: ellipsis; lines: 2; }
.counter { position: absolute; right: 14px; top: 84px; font-size: 14px; color: rgba(255,255,255,0.3); }
.quick { position: absolute; left: 6px; top: 200px; width: 200px; height: 36px; flex-direction: row; justify-content: space-between; }
.chip { width: 62px; height: 32px; border-radius: 16px; background-color: #1E1E1E; align-items: center; justify-content: center; }
.chipT { font-size: 14px; color: rgba(255,255,255,0.7); }
.go { position: absolute; left: 26px; top: 264px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.go.off { background-color: #2A2A2A; }
.goT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 16px; top: 330px; width: 180px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.3); }
.favEntry { position: absolute; left: 26px; top: 372px; width: 160px; height: 40px; border-radius: 20px; background-color: #1E1E1E; align-items: center; justify-content: center; }
.favEntryT { font-size: 14px; color: rgba(255,255,255,0.7); }
</style>

<script>
import g from '../../utils/g'
import prompt from '@system.prompt'
import textInput from '../../utils/textInput'

export default {
  data: {
    _ck: null,
    clock: '--:--',
    text: '',
    presets: ['网址', 'WiFi', '名片'],
    kbShow: false,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  openKb() {
    this.kbShow = true
  },
  closeKb() {
    this.kbShow = false
  },
  onKey(e) {
    const content = e && e.detail && e.detail.content ? e.detail.content : ''
    this.text = textInput.clamp(this.text + content, 80, false)
  },
  onDel() {
    this.text = this.text.slice(0, -1)
  },
  usePreset(name) {
    g.haptic.short()
    if (name === '网址') this.text = 'https://iot.mi.com/vela'
    else if (name === 'WiFi') {
      // WiFi 走专门表单页（SSID/密码/加密方式/隐藏网络），不再塞示例串
      this.kbShow = false
      g.router.push('/pages/qrcode/wifi')
    } else this.text = 'BandBox · 手腕上的百宝箱'
  },
  openFavs() {
    g.haptic.short()
    g.router.push('/pages/qrcode/fav')
  },
  generate() {
    if (!this.text) {
      prompt.showToast({ message: '请先输入内容', duration: 1500 })
      return
    }
    this.kbShow = false
    g.haptic.short()
    // fav='1'：本次生成的二维码在 show 页带收藏按钮；其余 4 个复用来源不带
    g.router.push('/pages/qrcode/show', { qr: this.text, fav: '1' })
  }
}
</script>
