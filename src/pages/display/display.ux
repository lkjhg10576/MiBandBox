<template>
  <div class="page" style="background-color: {{ color }};">
    <div class="top">
      <text class="f exit" @click="exit">退出</text>
      <text class="f name" style="color: {{ fg }};">{{ name }}</text>
      <text class="f count" style="color: {{ fg }};">{{ index + 1 }}/{{ total }}</text>
    </div>
    <div class="zoneL" @click="prev">
      <text class="f arrow" style="color: {{ fg }};"><</text>
    </div>
    <div class="zoneR" @click="next">
      <text class="f arrow" style="color: {{ fg }};">></text>
    </div>
    <text class="f tip" style="color: {{ fg }};">点击左右区域切换颜色</text>
  </div>
</template>

<style>
.page { width: 212px; height: 520px; }
.top { position: absolute; left: 30px; top: 42px; width: 152px; height: 28px; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px; }
.exit { width: 40px; height: 28px; line-height: 28px; text-align: center; font-size: 14px; color: #FFFFFF; background-color: rgba(0,0,0,0.35); border-radius: 14px; }
.name { width: 68px; text-align: center; font-size: 15px; }
.count { width: 36px; text-align: right; font-size: 14px; opacity: 0.7; }
.zoneL { position: absolute; left: 0px; top: 80px; width: 106px; height: 396px; align-items: center; justify-content: center; }
.zoneR { position: absolute; left: 106px; top: 80px; width: 106px; height: 396px; align-items: center; justify-content: center; }
.arrow { font-size: 44px; opacity: 0.5; }
.tip { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; opacity: 0.55; }
</style>

<script>
import colors from '../../data/colors'
import haptic from '../../utils/haptic'
import router from '../../utils/router'

function fgFor(hex) {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return r * 0.299 + g * 0.587 + b * 0.114 > 150 ? '#111111' : '#FFFFFF'
}

export default {
  data: {
    index: 0,
    color: colors[0].hex,
    name: colors[0].name,
    fg: '#111111',
    total: colors.length
  },
  onShow() {
    this.apply(0)
  },
  apply(i) {
    const n = colors.length
    this.index = (i + n) % n
    this.color = colors[this.index].hex
    this.name = colors[this.index].name
    this.fg = fgFor(this.color)
    haptic.short()
  },
  next() {
    this.apply(this.index + 1)
  },
  prev() {
    this.apply(this.index - 1)
  },
  exit() {
    haptic.short()
    router.back()
  }
}
</script>
