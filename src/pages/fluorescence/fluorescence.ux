<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="荧光棒" clock="{{ clock }}"></pagehead>

    <text class="f label l1">变色速度</text>
    <div class="segs s1">
      <div class="seg" style="background-color: {{ interval === 240 ? '#0D6EFF' : 'transparent' }};" @click="setSpeed(240)"><text class="f segT">慢</text></div>
      <div class="seg" style="background-color: {{ interval === 120 ? '#0D6EFF' : 'transparent' }};" @click="setSpeed(120)"><text class="f segT">中</text></div>
      <div class="seg" style="background-color: {{ interval === 60 ? '#0D6EFF' : 'transparent' }};" @click="setSpeed(60)"><text class="f segT">快</text></div>
    </div>

    <text class="f label l2">高亮屏幕</text>
    <div class="segs s2">
      <div class="seg" style="background-color: {{ bright ? '#0D6EFF' : 'transparent' }};" @click="setBright(true)"><text class="f segT">开</text></div>
      <div class="seg" style="background-color: {{ bright ? 'transparent' : '#0D6EFF' }};" @click="setBright(false)"><text class="f segT">关</text></div>
    </div>

    <text class="f label l3">阻止熄屏</text>
    <div class="segs s3">
      <div class="seg" style="background-color: {{ keepOn ? '#0D6EFF' : 'transparent' }};" @click="setKeepOn(true)"><text class="f segT">开</text></div>
      <div class="seg" style="background-color: {{ keepOn ? 'transparent' : '#0D6EFF' }};" @click="setKeepOn(false)"><text class="f segT">关</text></div>
    </div>

    <div class="go" @click="start"><text class="f goT">启动</text></div>
    <text class="f hint">选择参数后点启动进入荧光棒</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.label { position: absolute; left: 12px; width: 100px; height: 22px; line-height: 22px; font-size: 14px; color: rgba(255,255,255,0.5); }
.l1 { top: 92px; }
.l2 { top: 176px; }
.l3 { top: 260px; }
.segs { position: absolute; left: 6px; width: 200px; height: 44px; flex-direction: row; border-radius: 22px; background-color: #1A1A1A; padding: 3px; }
.s1 { top: 118px; }
.s2 { top: 202px; }
.s3 { top: 286px; }
.seg { flex: 1; height: 38px; border-radius: 19px; align-items: center; justify-content: center; }
.segT { font-size: 14px; color: #FFFFFF; }
.go { position: absolute; left: 26px; top: 368px; width: 160px; height: 48px; border-radius: 24px; background-color: #0D6EFF; align-items: center; justify-content: center; }
.goT { font-size: 14px; color: #FFFFFF; }
.hint { position: absolute; left: 16px; top: 436px; width: 180px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.35); }
</style>

<script>
import time from '../../utils/time'
import kv from '../../utils/kv'
import haptic from '../../utils/haptic'
import router from '../../utils/router'

export default {
  data: {
    clock: '--:--',
    interval: 120,
    bright: true,
    keepOn: true,
    clockTimer: null
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    if (this.clockTimer) clearInterval(this.clockTimer)
    this.clockTimer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
    // 记住上次的选择
    kv.init(() => {
      const cfg = kv.get('fluoroCfg', null)
      if (cfg && typeof cfg === 'object') {
        if (cfg.interval === 240 || cfg.interval === 120 || cfg.interval === 60) this.interval = cfg.interval
        if (typeof cfg.bright === 'boolean') this.bright = cfg.bright
        if (typeof cfg.keepOn === 'boolean') this.keepOn = cfg.keepOn
      }
    })
  },
  onHide() {
    if (this.clockTimer) clearInterval(this.clockTimer)
    this.clockTimer = null
  },
  onDestroy() {
    if (this.clockTimer) clearInterval(this.clockTimer)
    this.clockTimer = null
  },
  setSpeed(v) {
    haptic.short()
    this.interval = v
  },
  setBright(v) {
    haptic.short()
    this.bright = v
  },
  setKeepOn(v) {
    haptic.short()
    this.keepOn = v
  },
  start() {
    haptic.short()
    // 配置走 KV 一次性传递（路由参数在当前 Vela 上绑定不稳定），push 前立即落盘
    kv.init(() => {
      kv.set('fluoroCfg', { interval: this.interval, bright: this.bright, keepOn: this.keepOn })
      kv.flush()
      router.push('/pages/fluorescence/play')
    })
  }
}
</script>
