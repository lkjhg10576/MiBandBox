<template>
  <div class="page" style="background-color: {{ color }};">
    <div class="tap" @click="toggle"></div>
    <div class="top">
      <div class="btn" @click="exit"><text class="f btnT">退出</text></div>
      <text class="f title">荧光棒</text>
      <div class="btn" @click="toggle"><text class="f btnT">{{ paused ? '继续' : '暂停' }}</text></div>
    </div>
    <text class="f hint">{{ paused ? '已暂停 · 轻触继续' : '轻触暂停' }}</text>
  </div>
</template>

<style>
.page { width: 212px; height: 520px; background-color: #000000; overflow: hidden; }
.tap { position: absolute; left: 0px; top: 0px; width: 212px; height: 520px; }
.top { position: absolute; left: 32px; top: 44px; width: 148px; height: 28px; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px; z-index: 2; }
.btn { width: 44px; height: 28px; border-radius: 14px; background-color: rgba(0,0,0,0.35); align-items: center; justify-content: center; }
.btnT { font-size: 14px; color: #FFFFFF; }
.title { width: 60px; text-align: center; font-size: 17px; color: #FFFFFF; }
.hint { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.75); z-index: 2; }
</style>

<script>
import kv from '../../../utils/kv'
import haptic from '../../../utils/haptic'
import router from '../../../utils/router'
import screen from '../../../utils/screen'
import fluoroState from '../fluoroState'

function hsl(h, s, l) {
  const c = (1 - Math.abs(2 * l - 1)) * s
  const x = c * (1 - Math.abs(((h / 60) % 2) - 1))
  const m = l - c / 2
  let r = 0
  let g = 0
  let b = 0
  if (h < 60) { r = c; g = x }
  else if (h < 120) { r = x; g = c }
  else if (h < 180) { g = c; b = x }
  else if (h < 240) { g = x; b = c }
  else if (h < 300) { r = x; b = c }
  else { r = c; b = x }
  const to = (v) => {
    const n = Math.round((v + m) * 255)
    return (n < 16 ? '0' : '') + n.toString(16)
  }
  return '#' + to(r) + to(g) + to(b)
}

const PALETTE = []
for (let i = 0; i < 36; i++) PALETTE.push(hsl((i * 10) % 360, 0.92, 0.56))

export default {
  data: {
    color: PALETTE[0],
    paused: false,
    offset: 0,
    timer: null,
    interval: 120,
    ready: false
  },
  onShow() {
    // 配置由设置页 push 前写入 fluoroState（globalThis，同步读），规避 KV 异步竞态。
    // 亮度/常亮必须在 onShow 同步路径上立即执行，不能塞进异步回调（会被时序吞掉）。
    this.ready = true
    const cfg = fluoroState.cfg
    if (cfg && typeof cfg === 'object') {
      this.applyCfg(cfg)
    } else {
      // 兜底：绕过设置页直接进入（正常流程不会发生）时退回 KV 读取
      kv.init(() => {
        if (!this.ready) return
        this.applyCfg(kv.get('fluoroCfg', null) || {})
      })
    }
  },
  applyCfg(cfg) {
    if (cfg.interval === 240 || cfg.interval === 120 || cfg.interval === 60) this.interval = cfg.interval
    screen.enter({ bright: cfg.bright !== false, keepOn: cfg.keepOn !== false })
    this.start()
  },
  onHide() {
    this.ready = false
    this.stop()
    screen.leave()
  },
  onDestroy() {
    this.ready = false
    this.stop()
    screen.leave()
  },
  start() {
    this.stop()
    this.timer = setInterval(() => {
      this.offset = (this.offset + 1) % PALETTE.length
      this.color = PALETTE[this.offset % PALETTE.length]
    }, this.interval)
  },
  stop() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  toggle() {
    haptic.short()
    this.paused = !this.paused
    if (this.paused) this.stop()
    else this.start()
  },
  exit() {
    haptic.short()
    router.back()
  }
}
</script>
