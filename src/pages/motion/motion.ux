<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <pagehead title="{{ pageTitle }}" clock="{{ clock }}"></pagehead>

    <div class="card cardGun" if="{{ !showStats }}" @click="openGun">
      <div class="xh"></div>
      <div class="xhDot"></div>
      <text class="f cTitle1">体感手枪</text>
      <text class="f cDesc1">举枪稳住→抖腕开枪</text>
      <text class="f cDesc2">5发弹匣·可关换弹</text>
    </div>

    <div class="card cardHoop" if="{{ !showStats }}" @click="openHoop">
      <div class="board"></div>
      <div class="rim"></div>
      <div class="ball"></div>
      <text class="f cTitle2">空气投篮</text>
      <text class="f cDesc3">翻腕准备→向上投出</text>
      <text class="f cDesc4">投进一球+1分</text>
    </div>

    <text class="f hint" if="{{ !showStats }}">进游戏后摆好姿势稳住，长振提示就绪。两个游戏全程屏幕常亮。</text>

    <!-- 灵敏度：决定准备姿势的标准程度与触发所需的动作幅度，选完即存盘 -->
    <div class="sensRow" if="{{ !showStats }}">
      <text class="f sensLabel">灵敏度</text>
      <div class="sn" style="background-color: {{ sensLevel === 'low' ? '#0D6EFF' : 'transparent' }};" @click="setSens('low')">
        <text class="f snT">低</text>
      </div>
      <div class="sn" style="background-color: {{ sensLevel === 'mid' ? '#0D6EFF' : 'transparent' }};" @click="setSens('mid')">
        <text class="f snT">中</text>
      </div>
      <div class="sn" style="background-color: {{ sensLevel === 'high' ? '#0D6EFF' : 'transparent' }};" @click="setSens('high')">
        <text class="f snT">高</text>
      </div>
    </div>

    <!-- 统计页：与游戏卡片同位，翻页时卡片不跳动；今日数跨天自动清零 -->
    <div class="card statCard1" if="{{ showStats }}">
      <text class="f stTitle">体感手枪</text>
      <text class="f stLabel stL1">今日已射击</text>
      <text class="f stVal stV1">{{ gunToday }}</text>
      <text class="f stLabel stL2">总计已射击</text>
      <text class="f stVal stV2">{{ gunTotal }}</text>
    </div>
    <div class="card statCard2" if="{{ showStats }}">
      <text class="f stTitle">空气投篮</text>
      <text class="f stLabel stL1">今日已投进</text>
      <text class="f stVal stV1">{{ hoopToday }}</text>
      <text class="f stLabel stL2">总计已投进</text>
      <text class="f stVal stV2">{{ hoopTotal }}</text>
    </div>

    <!-- 翻页指示点：上点=游戏列表，下点=统计数据，页面上下滑动切换（横向留给系统返回手势） -->
    <div class="dots">
      <div class="dot" style="background-color: {{ showStats ? '#333333' : '#0D6EFF' }};"></div>
      <div class="dot" style="background-color: {{ showStats ? '#0D6EFF' : '#333333' }};"></div>
    </div>

    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
/* 卡片是绝对定位 → 卡片里的绝对定位子元素以「卡片」为基准，不是页面 */
.card { position: absolute; left: 3px; width: 196px; height: 108px; border-radius: 26px; background-color: #1A1A1A; }
.cardGun { top: 90px; }
.cardHoop { top: 206px; }
.xh { position: absolute; left: 20px; top: 28px; width: 48px; height: 48px; border-radius: 24px; border-width: 2px; border-style: solid; border-color: #0D6EFF; }
.xhDot { position: absolute; left: 41px; top: 49px; width: 6px; height: 6px; border-radius: 3px; background-color: #0D6EFF; }
.board { position: absolute; left: 20px; top: 20px; width: 56px; height: 44px; border-radius: 6px; background-color: #222222; border-width: 2px; border-style: solid; border-color: #3A3A3A; }
.rim { position: absolute; left: 22px; top: 60px; width: 52px; height: 15px; border-radius: 8px; border-width: 3px; border-style: solid; border-color: #FF9500; }
.ball { position: absolute; left: 41px; top: 84px; width: 16px; height: 16px; border-radius: 8px; background-color: #FF9500; }
.cTitle1 { position: absolute; left: 84px; top: 18px; width: 114px; height: 26px; line-height: 26px; font-size: 18px; color: #FFFFFF; }
.cDesc1 { position: absolute; left: 84px; top: 48px; width: 114px; height: 20px; line-height: 20px; font-size: 12px; color: rgba(255,255,255,0.6); }
.cDesc2 { position: absolute; left: 84px; top: 70px; width: 114px; height: 20px; line-height: 20px; font-size: 12px; color: rgba(255,255,255,0.35); }
.cTitle2 { position: absolute; left: 84px; top: 18px; width: 114px; height: 26px; line-height: 26px; font-size: 18px; color: #FFFFFF; }
.cDesc3 { position: absolute; left: 84px; top: 48px; width: 114px; height: 20px; line-height: 20px; font-size: 12px; color: rgba(255,255,255,0.6); }
.cDesc4 { position: absolute; left: 84px; top: 70px; width: 114px; height: 20px; line-height: 20px; font-size: 12px; color: rgba(255,255,255,0.35); }
.hint { position: absolute; left: 6px; top: 322px; width: 200px; height: 60px; line-height: 20px; font-size: 12px; color: rgba(255,255,255,0.35); }
/* 灵敏度三档：低 / 中 / 高 */
.sensRow { position: absolute; left: 6px; top: 386px; width: 200px; height: 32px; flex-direction: row; align-items: center; border-radius: 16px; background-color: #1A1A1A; padding: 3px; }
.sensLabel { width: 44px; height: 26px; line-height: 26px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.45); }
.sn { flex: 1; height: 26px; margin-right: 4px; border-radius: 13px; align-items: center; justify-content: center; }
.snT { font-size: 14px; color: #FFFFFF; }
/* 统计卡：标题与两行数字，标签靠左、数值靠右 */
.statCard1 { top: 90px; }
.statCard2 { top: 206px; }
.stTitle { position: absolute; left: 20px; top: 18px; width: 166px; height: 26px; line-height: 26px; font-size: 18px; color: #FFFFFF; }
.stLabel { position: absolute; left: 20px; width: 120px; height: 20px; line-height: 20px; font-size: 13px; color: rgba(255,255,255,0.6); }
.stL1 { top: 48px; }
.stL2 { top: 70px; }
.stVal { position: absolute; left: 120px; width: 66px; height: 20px; line-height: 20px; font-size: 16px; text-align: right; color: #FFFFFF; }
.stV1 { top: 48px; }
.stV2 { top: 70px; }
/* 翻页指示点：竖排在屏幕右侧（避开横向滑动，别抢系统返回手势），纵向对齐两张卡片的中线 */
.dots { position: absolute; left: 203px; top: 190px; width: 6px; height: 24px; flex-direction: column; align-items: center; }
.dot { width: 6px; height: 6px; border-radius: 3px; margin-top: 3px; margin-bottom: 3px; }
</style>

<script>
import g from '../../utils/g'
import motionSensitivity from '../../utils/motionSensitivity'
import motionStats from '../../utils/motionStats'

export default {
  data: {
    clock: '--:--',
    pageTitle: '体感游戏',
    showStats: false,
    gunToday: 0,
    gunTotal: 0,
    hoopToday: 0,
    hoopTotal: 0,
    sensLevel: motionSensitivity.DEFAULT_LEVEL,
    _ck: null,
    _sx: null,
    _sy: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    // 每次进页都从游戏列表这页开始
    this.showStats = false
    this.pageTitle = '体感游戏'
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)

    // 读回灵敏度与体感统计（没存过就是默认值/全零）
    g.kv.init(() => {
      const lv = motionSensitivity.normalize(g.kv.get(motionSensitivity.KV_KEY, motionSensitivity.DEFAULT_LEVEL))
      if (!page.$valid) return
      page.sensLevel = lv
      page.applyStats(motionStats.load(g.kv.get(motionStats.KV_KEY, null)))
    })
  },
  onHide() {
    this.unsub()
  },
  onDestroy() {
    this.unsub()
  },
  unsub() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  // 选灵敏度：立刻存盘，进游戏时按这档的阈值判定
  setSens(level) {
    const lv = motionSensitivity.normalize(level)
    g.haptic.short()
    this.sensLevel = lv
    g.kv.set(motionSensitivity.KV_KEY, lv)
  },
  applyStats(s) {
    this.gunToday = s.gunToday
    this.gunTotal = s.gunTotal
    this.hoopToday = s.hoopToday
    this.hoopTotal = s.hoopTotal
  },
  onTouchStart(e) {
    const t = e && e.changedTouches && e.changedTouches[0]
    if (!t) return
    this._sx = typeof t.pageX === 'number' ? t.pageX : t.clientX
    this._sy = typeof t.pageY === 'number' ? t.pageY : t.clientY
  },
  onTouchEnd(e) {
    if (this._sx === null || this._sx === undefined) return
    const t = e && e.changedTouches && e.changedTouches[0]
    const dx = t ? (typeof t.pageX === 'number' ? t.pageX : t.clientX) - this._sx : 0
    const dy = t ? (typeof t.pageY === 'number' ? t.pageY : t.clientY) - this._sy : 0
    this._sx = null
    this._sy = null
    // 纵向明显位移且远大于横向才算翻页：点卡片、点灵敏度不受影响；方向不区分，小屏好命中
    if (Math.abs(dy) < 60 || Math.abs(dy) < Math.abs(dx) * 1.5) return
    this.toggleStats()
  },
  // 翻到统计页时现读一次存档：刚在游戏里打出的数立刻反映
  toggleStats() {
    g.haptic.short()
    this.showStats = !this.showStats
    this.pageTitle = this.showStats ? '统计数据' : '体感游戏'
    if (this.showStats) {
      const page = this
      g.kv.init(() => {
        if (!page.$valid) return
        page.applyStats(motionStats.load(g.kv.get(motionStats.KV_KEY, null)))
      })
    }
  },
  openGun() {
    g.haptic.short()
    g.router.push('/pages/motion/gun')
  },
  openHoop() {
    g.haptic.short()
    g.router.push('/pages/motion/hoop')
  }
}
</script>
