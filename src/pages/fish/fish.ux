<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="木鱼" clock="{{ clock }}"></pagehead>

    <div class="fishBox" @click="knock">
      <img class="fishImg" src="/common/images/muyu.png" />
      <div class="pressRing" if="{{ pressed }}"></div>
    </div>
    <text class="f plusOne1" if="{{ plusStep === 1 }}">功德 +1</text>
    <text class="f plusOne2" if="{{ plusStep === 2 }}">功德 +1</text>
    <text class="f plusOne3" if="{{ plusStep === 3 }}">功德 +1</text>

    <div class="statCard"></div>
    <text class="f statLabelL">今日</text>
    <text class="f statNumL">{{ dayCount }}</text>
    <text class="f statLabelR">累计</text>
    <text class="f statNumR">{{ total }}</text>

    <text class="f autoLabel">自动敲击</text>
    <div class="chip chipOff" style="background-color: {{ autoMode === 'off' ? '#0D6EFF' : '#262626' }};" @click="setAuto('off')"><text class="f chipT">关</text></div>
    <div class="chip chipSlow" style="background-color: {{ autoMode === 'slow' ? '#0D6EFF' : '#262626' }};" @click="setAuto('slow')"><text class="f chipT">慢</text></div>
    <div class="chip chipMid" style="background-color: {{ autoMode === 'mid' ? '#0D6EFF' : '#262626' }};" @click="setAuto('mid')"><text class="f chipT">中</text></div>
    <div class="chip chipFast" style="background-color: {{ autoMode === 'fast' ? '#0D6EFF' : '#262626' }};" @click="setAuto('fast')"><text class="f chipT">快</text></div>

    <div class="reset" @click="reset"><text class="f resetT">{{ delStep === 0 ? '功德归零' : '再次点击确认' }}</text></div>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.fishBox { position: absolute; left: 31px; top: 96px; width: 150px; height: 150px; align-items: center; justify-content: center; }
.fishImg { width: 150px; height: 150px; }
.pressRing { position: absolute; left: 36px; top: 101px; width: 140px; height: 140px; border-radius: 70px; border-width: 2px; border-style: solid; border-color: #C8A24F; }
.plusOne1 { position: absolute; left: 0px; top: 104px; width: 212px; height: 24px; line-height: 24px; text-align: center; font-size: 18px; color: #FFD166; }
.plusOne2 { position: absolute; left: 0px; top: 88px; width: 212px; height: 24px; line-height: 24px; text-align: center; font-size: 18px; color: #C8A24F; }
.plusOne3 { position: absolute; left: 0px; top: 76px; width: 212px; height: 24px; line-height: 24px; text-align: center; font-size: 18px; color: #8A6E33; }
.statCard { position: absolute; left: 3px; top: 268px; width: 206px; height: 84px; border-radius: 26px; background-color: #262626; }
.statLabelL { position: absolute; left: 24px; top: 286px; width: 60px; height: 18px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.45); }
.statNumL { position: absolute; left: 24px; top: 308px; width: 60px; height: 32px; line-height: 32px; text-align: center; font-size: 24px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.statLabelR { position: absolute; left: 128px; top: 286px; width: 60px; height: 18px; line-height: 18px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.45); }
.statNumR { position: absolute; left: 128px; top: 308px; width: 60px; height: 32px; line-height: 32px; text-align: center; font-size: 24px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.autoLabel { position: absolute; left: 4px; top: 366px; width: 56px; height: 30px; line-height: 30px; font-size: 14px; color: rgba(255,255,255,0.45); }
.chip { position: absolute; top: 366px; width: 35px; height: 30px; border-radius: 15px; background-color: #262626; align-items: center; justify-content: center; }
.chipOff { left: 60px; }
.chipSlow { left: 97px; }
.chipMid { left: 134px; }
.chipFast { left: 171px; }
.chipT { font-size: 13px; color: #FFFFFF; }
.reset { position: absolute; left: 62px; top: 424px; width: 88px; height: 30px; border-radius: 15px; background-color: #262626; align-items: center; justify-content: center; }
.resetT { font-size: 14px; color: rgba(255,255,255,0.55); }
</style>

<script>

import g from '../../utils/g'
export default {
  data: {
    _ck: null,
    clock: '--:--',
    dayCount: 0,
    total: 0,
    pressed: false,
    plusStep: 0,
    animTimers: [],
    delStep: 0,
    autoMode: 'off',
    autoSpeed: 800,
    timer: null,
    autoTimer: null,
    saveTimer: null,
    pendingSave: false
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.delStep = 0
    this.clearAnim()
    this.pressed = false
    this.plusStep = 0
    g.kv.init(() => {
      const today = g.time.todayKey()
      const raw = g.kv.get('fishMerit', null)
      let dayCount = 0
      let total = 0
      if (raw && typeof raw === 'object') {
        // 新结构：{ d: 日期, c: 当日计数, t: 总数 }
        dayCount = raw.c || 0
        total = raw.t || 0
        if ((raw.d || '') !== today) dayCount = 0
      } else {
        // 旧结构兼容：fishMeritDay / fishMeritDayCount / fishMeritTotal
        // （更早的版本把总数存在 fishMerit 里，是个数字）
        const oldDay = g.kv.get('fishMeritDay', '')
        const oldCount = g.kv.get('fishMeritDayCount', 0) || 0
        let oldTotal = g.kv.get('fishMeritTotal', null)
        if (oldTotal === null || oldTotal === undefined) {
          oldTotal = (typeof raw === 'number' ? raw : 0) || 0
        }
        total = oldTotal || 0
        dayCount = oldDay === today ? oldCount : 0
        // 迁移成新键，删掉旧键
        g.kv.set('fishMerit', { d: today, c: dayCount, t: total })
        g.kv.remove('fishMeritDay')
        g.kv.remove('fishMeritDayCount')
        g.kv.remove('fishMeritTotal')
      }
      this.dayCount = dayCount
      this.total = total
    })
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    if (this.autoMode !== 'off') {
      this.stopAuto()
      this.autoTimer = setInterval(() => {
        this.knock()
      }, this.autoSpeed)
    }
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    this.stopAuto()
    this.clearAnim()
    this.flushSave()
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
    this.stopAuto()
    this.clearAnim()
    this.flushSave()
  },
  knock() {
    this.dayCount = this.dayCount + 1
    this.total = this.total + 1
    // 单键写入：一次 g.kv.set 代替三次（每次落盘只序列化一次）
    this.queueSave()
    g.haptic.short()
    this.playAnim()
  },
  /**
   * 节流落盘：自动敲击 500ms/次，若每次都写，整份 store.json 每秒被重写 2 次，
   * 手环上的 littlefs 要一直做 GC。改成 2s 合并一次，离开页面时 flushSave() 强制落盘。
   */
  queueSave() {
    this.pendingSave = true
    if (this.saveTimer) return
    this.saveTimer = setTimeout(() => {
      this.saveTimer = null
      this.writeMerit()
    }, 2000)
  },
  writeMerit() {
    if (!this.pendingSave) return
    this.pendingSave = false
    g.kv.set('fishMerit', { d: g.time.todayKey(), c: this.dayCount, t: this.total })
    // 跳过 kv 的 120ms 防抖：这一笔本来就是攒过的，直接落盘，
    // 避免刚离开页面就被杀进程时丢掉最后一次计数。
    g.kv.flush()
  },
  flushSave() {
    if (this.saveTimer) {
      clearTimeout(this.saveTimer)
      this.saveTimer = null
    }
    this.writeMerit()
  },
  playAnim() {
    this.clearAnim()
    this.pressed = true
    this.plusStep = 1
    this.pushAnim(() => { this.pressed = false }, 140)
    this.pushAnim(() => { this.plusStep = 2 }, 120)
    this.pushAnim(() => { this.plusStep = 3 }, 240)
    this.pushAnim(() => { this.plusStep = 0 }, 360)
  },
  pushAnim(fn, ms) {
    this.animTimers.push(setTimeout(fn, ms))
  },
  clearAnim() {
    this.animTimers.forEach((t) => clearTimeout(t))
    this.animTimers = []
  },
  setAuto(mode) {
    this.autoMode = mode
    this.autoSpeed = mode === 'slow' ? 1200 : (mode === 'fast' ? 500 : 800)
    g.haptic.short()
    this.stopAuto()
    if (mode === 'off') return
    this.autoTimer = setInterval(() => {
      this.knock()
    }, this.autoSpeed)
  },
  stopAuto() {
    if (this.autoTimer) clearInterval(this.autoTimer)
    this.autoTimer = null
  },
  reset() {
    if (this.delStep === 0) {
      this.delStep = 1
      return
    }
    this.dayCount = 0
    this.total = 0
    // 必须写回 onShow/knock 实际读取的那个键（fishMerit 对象）。
    // 0.4.0 这里还在写 fishMeritDay / fishMeritDayCount / fishMeritTotal 三个旧键，
    // 下次进页面读到的仍是旧对象，归零等于没做。
    g.kv.set('fishMerit', { d: g.time.todayKey(), c: 0, t: 0 })
    this.delStep = 0
    g.haptic.long()
  }
}
</script>
