<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="每日一言" clock="{{ clock }}"></pagehead>
    <scroll class="body" scroll-y="true" bounces="true">
      <div class="inner">
        <div class="card">
          <text class="f quoteMark">“</text>
          <text class="f quote">{{ quote }}</text>
          <text class="f idx">第 {{ index + 1 }} / {{ total }} 条</text>
        </div>
        <div class="actions">
          <div class="btn" @click="next"><text class="f btnT">换一条</text></div>
          <div class="btn fav" @click="favorite"><text class="f btnT">{{ faved ? '已收藏' : '收藏' }}</text></div>
        </div>
        <text class="f favCount">已收藏 {{ favCount }} 条 · 保存在本机</text>
        <div class="favEntry" @click="openFavs"><text class="f favEntryT">我的收藏 ({{ favCount }})</text></div>
        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 438px; }
.inner { width: 212px; height: 414px; flex-direction: column; }
.card { width: 206px; height: 250px; margin: 0px 3px; border-radius: 26px; background-color: #262626; padding: 14px 18px; flex-direction: column; flex-shrink: 0; }
.quoteMark { width: 170px; height: 36px; line-height: 36px; font-size: 44px; color: #4E87FF; }
.quote { width: 170px; height: 150px; font-size: 23px; line-height: 34px; color: #FFFFFF; }
.idx { width: 170px; height: 20px; line-height: 20px; text-align: right; font-size: 14px; color: rgba(255,255,255,0.3); }
.actions { margin: 20px 18px 0px 18px; height: 46px; flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.btn { width: 84px; height: 46px; border-radius: 23px; background-color: #0D6EFF; align-items: center; justify-content: center; flex-shrink: 0; }
.fav { background-color: #262626; }
.btnT { font-size: 14px; color: #FFFFFF; }
.favCount { margin-top: 8px; width: 212px; height: 20px; line-height: 20px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); flex-shrink: 0; }
.favEntry { margin: 14px 26px 0px 26px; width: 160px; height: 48px; border-radius: 24px; background-color: #262626; align-items: center; justify-content: center; flex-shrink: 0; }
.favEntryT { font-size: 15px; color: #FFFFFF; }
.pad { width: 212px; height: 8px; flex-shrink: 0; }
</style>

<script>
import g from '../../utils/g'
import quotesData from '../../utils/quotesData'
import { shuffledDeck } from '../../utils/seedRandom'
import prompt from '@system.prompt'
import crypto from '@system.crypto'

function randInt(max) {
  try {
    if (crypto && typeof crypto.getRandomValues === 'function') {
      const arr = new Uint8Array(2)
      crypto.getRandomValues(arr)
      return (arr[0] * 256 + arr[1]) % max
    }
  } catch (e) {}
  return Math.floor(Math.random() * max)
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    quote: '',
    index: 0,
    total: 0,
    quotes: [],
    faved: false,
    favCount: 0,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    quotesData.load((list) => {
      this.quotes = list
      this.total = list.length
      if (!this.quote && list.length) this.quote = list[0]
      g.kv.init(() => {
        this.draw()
        this.refreshFav()
      })
    })
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  /**
   * 洗牌队列：把全部索引随机排序后依次抽用，抽完再重洗。
   * 保证连续多次进入/换一条几乎不会重复，直到一轮耗尽。
   */
  draw() {
    const list = this.quotes || []
    if (!list.length) return
    // 只存「种子 + 位置」两个数（约 30 字节），队列由种子现场重建
    let st = g.kv.get('quoteDeckState', null)
    if (!st || typeof st.p !== 'number' || typeof st.s !== 'number' || st.p >= list.length) {
      st = { s: randInt(233280) + 1, p: 0 }
    }
    const deck = shuffledDeck(list.length, st.s)
    const idx = deck[st.p]
    this.index = idx
    this.quote = list[idx]
    g.kv.set('quoteDeckState', { s: st.s, p: st.p + 1 })
    // 旧版遗留的两个大键（洗牌队列 1000 个索引）用完即删
    if (g.kv.get('quoteDeck', null)) g.kv.remove('quoteDeck')
    if (g.kv.get('quoteDeckPos', null) !== null) g.kv.remove('quoteDeckPos')
  },
  refreshFav() {
    const list = g.kv.get('quoteFavs', [])
    this.favCount = Array.isArray(list) ? list.length : 0
    this.faved = Array.isArray(list) && list.indexOf(this.quote) >= 0
  },
  openFavs() {
    g.haptic.short()
    g.router.push('/pages/sentence/fav')
  },
  next() {
    g.haptic.short()
    this.draw()
    this.refreshFav()
  },
  favorite() {
    g.haptic.short()
    const list = g.kv.get('quoteFavs', [])
    const arr = Array.isArray(list) ? list.slice() : []
    const pos = arr.indexOf(this.quote)
    if (pos >= 0) {
      arr.splice(pos, 1)
      prompt.showToast({ message: '已取消收藏', duration: 1200 })
    } else {
      arr.unshift(this.quote)
      prompt.showToast({ message: '已收藏', duration: 1200 })
    }
    if (arr.length > 50) arr.length = 50
    g.kv.set('quoteFavs', arr)
    this.favCount = arr.length
    this.faved = arr.indexOf(this.quote) >= 0
  }
}
</script>
