<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ awake }}">
    <pagehead title="我的收藏" clock="{{ clock }}"></pagehead>
    <div class="pager pagerTop">
      <div class="pgBtn" @click="prevPage"><text class="f pgArr" style="color: {{ page > 1 ? '#4E87FF' : 'rgba(255,255,255,0.3)' }};">‹</text></div>
      <text class="f pgNum">{{ page }}/{{ pageCount }}</text>
      <div class="pgBtn" @click="nextPage"><text class="f pgArr" style="color: {{ page < pageCount ? '#4E87FF' : 'rgba(255,255,255,0.3)' }};">›</text></div>
    </div>
    <scroll id="favScroll" class="body" scroll-y="true" bounces="true">
      <div class="inner" style="height: {{ innerHeight }}px;">
        <div class="favCard" for="{{ items }}" @click="tapItem($item)">
          <text class="f favText">{{ $item.text }}</text>
        </div>
        <div class="empty" if="{{ items.length === 0 }}">
          <text class="f emptyT">还没有收藏</text>
          <text class="f emptyS">在每日一言页点「收藏」句子</text>
        </div>
      </div>
    </scroll>
    <div class="pager pagerBot">
      <div class="pgBtn" @click="prevPage"><text class="f pgArr" style="color: {{ page > 1 ? '#4E87FF' : 'rgba(255,255,255,0.3)' }};">‹</text></div>
      <text class="f pgNum">{{ page }}/{{ pageCount }}</text>
      <div class="pgBtn" @click="nextPage"><text class="f pgArr" style="color: {{ page < pageCount ? '#4E87FF' : 'rgba(255,255,255,0.3)' }};">›</text></div>
    </div>
    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../../common/styles/theme.css';
/* 分页：每页固定 5 项，只给当前页建节点（收藏上百条时一次性渲染会把首帧拖到十几秒）。
   翻页条在正文上下各一条，左 ‹ 上一页 / 中 x/y / 右 › 下一页。 */
.body { position: absolute; left: 0px; top: 128px; width: 212px; height: 290px; }
.inner { width: 212px; flex-direction: column; flex-shrink: 0; }
.favCard { width: 206px; margin: 0px 3px 6px 3px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; flex-shrink: 0; }
.favText { width: 174px; font-size: 18px; line-height: 26px; color: #FFFFFF; flex-shrink: 0; }
.empty { width: 212px; height: 200px; align-items: center; justify-content: center; flex-direction: column; flex-shrink: 0; }
.emptyT { font-size: 16px; color: rgba(255,255,255,0.6); }
.emptyS { margin-top: 10px; font-size: 14px; color: rgba(255,255,255,0.55); }
.pager { position: absolute; left: 3px; width: 206px; height: 36px; flex-direction: row; align-items: center; justify-content: space-between; }
.pagerTop { top: 88px; }
.pagerBot { top: 422px; }
.pgBtn { width: 44px; height: 36px; border-radius: 18px; background-color: #1A1A1A; align-items: center; justify-content: center; }
.pgArr { width: 44px; height: 36px; line-height: 36px; text-align: center; font-size: 22px; }
.pgNum { width: 90px; height: 22px; line-height: 22px; text-align: center; font-size: 15px; color: rgba(255,255,255,0.72); }
</style>

<script>
import g from '../../../utils/g'
import favState from '../favState'
import pager from '../../../utils/pager'
import life from '../../../utils/pageLife'

function estimateInnerHeight(texts) {
  if (!texts || texts.length === 0) return 300
  let total = 0
  for (let i = 0; i < texts.length; i++) {
    const text = texts[i] ? String(texts[i]) : ''
    // padding 20 + margin-bottom 6 = 26
    let cardH = 26
    // 估算行数：按换行符拆分，每行在 174px 宽、18px 字体下可容纳约 8-9 个中文字符
    // 中文/全角算 1 单元，ASCII 算 0.55 单元；除以 8.5 保守偏大估算，保证不被截断
    const paras = text.split('\n')
    let lines = 0
    for (let p = 0; p < paras.length; p++) {
      const para = paras[p]
      if (!para.length) {
        lines += 1
        continue
      }
      let units = 0
      for (let c = 0; c < para.length; c++) {
        units += para.charCodeAt(c) > 127 ? 1 : 0.55
      }
      lines += Math.max(1, Math.ceil(units / 8.5))
    }
    cardH += lines * 26
    total += cardH
  }
  return total
}

export default life({
  data: {
    _ck: null,
    clock: '--:--',
    all: [],
    items: [],
    page: 1,
    pageCount: 1,
    innerHeight: 300,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    this.loadItems()
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  loadItems() {
    g.kv.init(() => {
      if (!this.$valid) return
      const list = g.kv.get('quoteFavs', [])
      this.all = Array.isArray(list) ? list : []
      this.pageCount = pager.count(this.all.length)
      this.page = pager.clamp(this.page, this.pageCount)
      this.renderPage()
    })
  },
  /** 只物化当前页：整份收藏留在 data 里，翻页时切片重建 5 张卡 */
  renderPage() {
    const start = pager.start(this.page)
    const texts = this.all.slice(start, start + pager.SIZE)
    this.items = texts.map((t) => ({ text: t }))
    this.innerHeight = estimateInnerHeight(texts)
  },
  prevPage() {
    this.turn(-1)
  },
  nextPage() {
    this.turn(1)
  },
  turn(delta) {
    const next = this.page + delta
    if (next < 1 || next > this.pageCount) return
    g.haptic.short()
    this.page = next
    this.renderPage()
  },
  /**
   * 点击条目进入全览页：句子居中完整展示，取消收藏在全览页二次确认完成。
   */
  tapItem(item) {
    g.haptic.short()
    // scroll+for 里 $index 不可靠，用文本值定位（收藏按文本去重，必然唯一）
    const index = this.all.indexOf(item.text)
    if (index < 0) return
    favState.item = { index, text: item.text }
    g.router.push('/pages/sentence/favdetail')
  }
})
</script>