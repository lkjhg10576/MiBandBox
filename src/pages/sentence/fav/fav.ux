<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="我的收藏" clock="{{ clock }}"></pagehead>
    <scroll id="favScroll" class="body" scroll-y="true" bounces="true">
      <div class="inner" style="height: {{ innerHeight }}px;">
        <div class="favCard" for="{{ items }}" @click="tapItem($item)">
          <text class="f favText">{{ $item.text }}</text>
        </div>
        <div class="empty" if="{{ items.length === 0 }}">
          <text class="f emptyT">还没有收藏</text>
          <text class="f emptyS">在每日一言页点「收藏」句子</text>
        </div>
        <div class="pad"></div>
      </div>
    </scroll>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../../common/styles/theme.css';
.body { position: absolute; left: 0px; top: 82px; width: 212px; height: 438px; }
.inner { width: 212px; flex-direction: column; flex-shrink: 0; }
.favCard { width: 206px; margin: 0px 3px 8px 3px; border-radius: 26px; background-color: #262626; padding: 14px 16px; flex-direction: column; flex-shrink: 0; }
.favText { width: 174px; font-size: 18px; line-height: 26px; color: #FFFFFF; flex-shrink: 0; }
.empty { width: 212px; height: 200px; align-items: center; justify-content: center; flex-direction: column; flex-shrink: 0; }
.emptyT { font-size: 16px; color: rgba(255,255,255,0.5); }
.emptyS { margin-top: 10px; font-size: 13px; color: rgba(255,255,255,0.3); }
.pad { width: 212px; height: 24px; flex-shrink: 0; }
</style>

<script>
import g from '../../../utils/g'
import favState from '../favState'

function estimateInnerHeight(items) {
  if (!items || items.length === 0) return 438
  let total = 0
  for (let i = 0; i < items.length; i++) {
    const text = items[i] && items[i].text ? items[i].text : ''
    // padding 28 + margin-bottom 8 = 36
    let cardH = 36
    // 估算行数：按换行符拆分，每行在 174px 宽、18px 字体下可容纳约 8-9 个中文字符
    // 中文/全角算 1 单元，ASCII 算 0.55 单元；除以 8.5 保守偏大估算，保证不被截断
    const paras = String(text).split('\n')
    let lines = 0
    for (let p = 0; p < paras.length; p++) {
      const para = paras[p]
      if (!para.length) {
        lines += 1
        continue
      }
      let units = 0
      for (let c = 0; c < para.length; c++) {
        units += para.charCodeAt(c) > 127 ? 1 : 0.55
      }
      lines += Math.max(1, Math.ceil(units / 8.5))
    }
    cardH += lines * 26
    total += cardH
  }
  // 底部留白 pad(24px)
  total += 24
  return Math.max(438, total)
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    items: [],
    innerHeight: 438,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    this.loadItems()
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  loadItems() {
    g.kv.init(() => {
      if (!this.$valid) return
      const list = g.kv.get('quoteFavs', [])
      const arr = Array.isArray(list) ? list : []
      this.items = arr.map((t) => ({ text: t }))
      this.innerHeight = estimateInnerHeight(this.items)
    })
  },
  /**
   * 点击条目进入全览页：句子居中完整展示，取消收藏在全览页二次确认完成。
   */
  tapItem(item) {
    g.haptic.short()
    // scroll+for 里 $index 不可靠，用文本值定位（收藏按文本去重，必然唯一）
    const index = this.items.findIndex((it) => it.text === item.text)
    if (index < 0) return
    favState.item = { index, text: item.text }
    g.router.push('/pages/sentence/favdetail')
  }
}
</script>
