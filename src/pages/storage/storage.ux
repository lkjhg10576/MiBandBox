<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<import name="ring" src="../../components/Ring.ux"></import>

<template>
  <div class="page">
    <pagehead title="存储空间" clock="{{ clock }}"></pagehead>
    <div class="ringWrap">
      <ring percent="{{ percent }}" color="{{ color }}" size="{{ 168 }}" label="{{ percentText }}"></ring>
    </div>
    <text class="f sub">已使用 {{ usedText }}</text>

    <div class="card">
      <div class="line">
        <text class="f lLabel">总容量</text>
        <text class="f lVal">{{ totalText }}</text>
      </div>
      <div class="line">
        <text class="f lLabel">已使用</text>
        <text class="f lVal">{{ usedText }}</text>
      </div>
      <div class="line">
        <text class="f lLabel">可用</text>
        <text class="f lVal" style="color: #00C853;">{{ freeText }}</text>
      </div>
    </div>

    <text class="f hint">{{ hint }}</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.ringWrap { position: absolute; left: 22px; top: 86px; width: 168px; height: 168px; }
.sub { position: absolute; left: 0px; top: 258px; width: 212px; text-align: center; font-size: 15px; color: rgba(255,255,255,0.55); }
.card { position: absolute; left: 3px; top: 292px; width: 206px; height: 146px; border-radius: 26px; background-color: #262626; padding: 10px 16px; flex-direction: column; }
.line { width: 174px; height: 42px; flex-direction: row; align-items: center; justify-content: space-between; }
.lLabel { font-size: 16px; color: rgba(255,255,255,0.55); }
.lVal { font-size: 18px; color: #FFFFFF; }
.hint { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import g from '../../utils/g'
import device from '@system.device'

function gb(n) {
  if (!n && n !== 0) return '—'
  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let v = n
  let i = 0
  while (v >= 1024 && i < units.length - 1) {
    v = v / 1024
    i++
  }
  return (Math.round(v * 10) / 10) + ' ' + units[i]
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    percent: 0,
    percentText: '—',
    color: '#0D6EFF',
    usedText: '—',
    freeText: '—',
    totalText: '—',
    hint: '正在读取存储信息',
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    this.load()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  load() {
    if (typeof device.getTotalStorage !== 'function') {
      this.hint = '当前设备不支持存储查询'
      return
    }
    try {
      device.getTotalStorage({
        success: (t) => {
          const total = (t && t.totalStorage) || 0
          // 不在原生回调里直接发起下一次原生调用，避免桥接重入
          setTimeout(() => {
            this.loadAvailable(total)
          }, 0)
        },
        fail: () => {
          this.hint = '当前设备不支持存储查询'
        }
      })
    } catch (e) {
      this.hint = '当前设备不支持存储查询'
    }
  },
  loadAvailable(total) {
    if (typeof device.getAvailableStorage !== 'function') {
      this.totalText = gb(total)
      this.hint = '暂时无法读取可用空间'
      return
    }
    try {
      device.getAvailableStorage({
        success: (a) => {
          const free = (a && a.availableStorage) || 0
          const used = Math.max(0, total - free)
          const pct = total > 0 ? Math.round((used / total) * 100) : 0
          this.totalText = gb(total)
          this.usedText = gb(used)
          this.freeText = gb(free)
          this.percentText = pct + '%'
          this.percent = pct
          this.color = pct >= 90 ? '#FF3B30' : pct >= 70 ? '#FF9500' : '#0D6EFF'
          this.hint = '全部保存在私有目录'
        },
        fail: () => {
          this.totalText = gb(total)
          this.hint = '暂时无法读取可用空间'
        }
      })
    } catch (e) {
      this.totalText = gb(total)
      this.hint = '暂时无法读取可用空间'
    }
  }
}
</script>
