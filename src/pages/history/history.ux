<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="史载今日" clock="{{ clock }}"></pagehead>
    <div class="dateRow">
      <div class="arrowBtn" @click="prevDay"><text class="f arrowT"><</text></div>
      <text class="f dateText">{{ dateText }}</text>
      <div class="arrowBtn" @click="nextDay"><text class="f arrowT">></text></div>
    </div>

    <!-- 当天内容改成可滚动的多条列表：史实条目 + 小知识兜底 -->
    <scroll class="listScroll" scroll-y="true" bounces="true">
      <div class="inner">
        <div class="item" for="{{ items }}">
          <text class="f meta">{{ $item.meta }}</text>
          <text class="f title">{{ $item.title }}</text>
          <text class="f body">{{ $item.body }}</text>
        </div>
        <div class="empty" if="{{ items.length === 0 }}">
          <text class="f emptyT">今日小知识</text>
        </div>
        <div class="pad"></div>
      </div>
    </scroll>

    <text class="f foot">公共领域历史与科技事实</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.page { width: 212px; height: 520px; background-color: #000000; }
.dateRow { position: absolute; left: 3px; top: 78px; width: 206px; height: 52px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 8px; }
.arrowBtn { width: 40px; height: 40px; border-radius: 20px; background-color: #333333; align-items: center; justify-content: center; }
.arrowT { font-size: 24px; color: #FFFFFF; }
.dateText { width: 110px; text-align: center; font-size: 17px; color: #FFFFFF; }
.listScroll { position: absolute; left: 0px; top: 146px; width: 212px; height: 268px; }
.inner { width: 212px; flex-direction: column; }
/* 条目高度随正文行数自适应，正文完整可读，不做省略号截断 */
.item { width: 206px; margin: 0px 3px 10px 3px; border-radius: 26px; background-color: #262626; padding: 12px 16px; flex-direction: column; }
.meta { width: 174px; height: 18px; line-height: 18px; font-size: 13px; color: #4E87FF; }
.title { width: 174px; height: 22px; line-height: 22px; font-size: 16px; color: #FFFFFF; }
.body { width: 174px; font-size: 15px; line-height: 22px; color: rgba(255,255,255,0.82); }
.empty { width: 212px; height: 200px; align-items: center; justify-content: center; flex-direction: column; }
.emptyT { font-size: 16px; color: rgba(255,255,255,0.5); }
.pad { width: 212px; height: 12px; }
.foot { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import time from '../../utils/time'
import history from '../../data/history'
import haptic from '../../utils/haptic'

export default {
  data: {
    clock: '--:--',
    y: 2026,
    m: 1,
    d: 1,
    dateText: '',
    items: [],
    timer: null
  },
  onShow() {
    this.clock = time.formatClock(new Date())
    const now = new Date()
    this.y = now.getFullYear()
    this.m = now.getMonth() + 1
    this.d = now.getDate()
    this.refresh()
    if (this.timer) clearInterval(this.timer)
    this.timer = setInterval(() => {
      this.clock = time.formatClock(new Date())
    }, 20000)
  },
  onHide() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  onDestroy() {
    if (this.timer) clearInterval(this.timer)
    this.timer = null
  },
  refresh() {
    const dt = new Date(this.y, this.m - 1, this.d)
    this.dateText = this.m + '月' + this.d + '日 ' + time.weekdayName(dt)
    const items = []
    // 1) 当天的史实条目
    const events = history.getByDate(this.m, this.d)
    for (let i = 0; i < events.length; i++) {
      const e = events[i]
      const meta = (e.year ? e.year + ' · ' : '') + (e.tag || '史实')
      items.push({ meta: meta, title: e.title || '历史上的今天', body: e.text })
    }
    // 2) 小知识兜底，保证每天至少有两条可读内容
    const tips = history.tipOfDay(this.m, this.d)
    for (let i = 0; i < tips.length; i++) {
      items.push({ meta: '小知识', title: '随手一读', body: tips[i] })
    }
    this.items = items
  },
  shift(delta) {
    haptic.short()
    const dt = new Date(this.y, this.m - 1, this.d + delta)
    this.y = dt.getFullYear()
    this.m = dt.getMonth() + 1
    this.d = dt.getDate()
    this.refresh()
  },
  prevDay() {
    this.shift(-1)
  },
  nextDay() {
    this.shift(1)
  }
}
</script>
