<import name="pagehead" src="../../components/PageHead.ux"></import>
<import name="backbtn" src="../../components/BackBtn.ux"></import>

<template>
  <div class="page">
    <pagehead title="史载今日" clock="{{ clock }}"></pagehead>
    <div class="dateRow">
      <div class="arrowBtn" @click="prevDay"><text class="f arrowT"><</text></div>
      <text class="f dateText">{{ dateText }}</text>
      <div class="arrowBtn" @click="nextDay"><text class="f arrowT">></text></div>
    </div>

    <!-- 当天内容：史实条目列表，无史实时才显示一条小知识兜底 -->
    <scroll id="listScroll" class="listScroll" scroll-y="true" bounces="true">
      <div class="inner" style="height: {{ innerHeight }}px;">
        <div class="item" for="{{ items }}">
          <text class="f itemMeta">{{ $item.meta }}</text>
          <text class="f itemTitle">{{ $item.title }}</text>
          <text class="f itemBody">{{ $item.body }}</text>
        </div>
        <div class="empty" if="{{ items.length === 0 }}">
          <text class="f emptyT">今日小知识</text>
        </div>
        <div class="pad"></div>
      </div>
    </scroll>

    <text class="f foot">公共领域历史与科技事实</text>
    <backbtn></backbtn>
  </div>
</template>

<style>
@import '../../common/styles/theme.css';
.dateRow { position: absolute; left: 3px; top: 78px; width: 206px; height: 52px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; justify-content: space-between; padding: 0px 8px; }
.arrowBtn { width: 40px; height: 40px; border-radius: 20px; background-color: #333333; align-items: center; justify-content: center; }
.arrowT { font-size: 24px; color: #FFFFFF; }
.dateText { width: 110px; text-align: center; font-size: 17px; color: #FFFFFF; }
.listScroll { position: absolute; left: 0px; top: 140px; width: 212px; height: 300px; }
.inner { width: 212px; flex-direction: column; flex-shrink: 0; }
/* 条目高度随正文行数自适应，正文完整可读，不做省略号截断 */
.item { width: 206px; margin: 0px 3px 10px 3px; border-radius: 26px; background-color: #262626; padding: 12px 16px 14px 16px; flex-direction: column; flex-shrink: 0; }
.itemMeta { width: 174px; height: 18px; line-height: 18px; font-size: 13px; color: #4E87FF; flex-shrink: 0; margin-bottom: 2px; }
.itemTitle { width: 174px; font-size: 16px; line-height: 22px; color: #FFFFFF; font-weight: bold; flex-shrink: 0; margin-bottom: 6px; }
.itemBody { width: 174px; font-size: 14px; line-height: 21px; color: rgba(255,255,255,0.85); flex-shrink: 0; }
.empty { width: 212px; height: 200px; align-items: center; justify-content: center; flex-direction: column; }
.emptyT { font-size: 16px; color: rgba(255,255,255,0.5); }
.pad { width: 212px; height: 24px; flex-shrink: 0; }
.foot { position: absolute; left: 21px; top: 448px; width: 170px; text-align: center; font-size: 14px; color: rgba(255,255,255,0.3); }
</style>

<script>
import g from '../../utils/g'
import historyData from '../../utils/historyData'

function estimateInnerHeight(items) {
  if (!items || items.length === 0) return 300
  let total = 0
  for (let i = 0; i < items.length; i++) {
    const it = items[i]
    // padding 26 + margin 10 = 36
    let h = 36
    // meta 18 + margin 2 = 20
    h += 20
    // title
    const tLen = (it.title || '').length
    const tLines = tLen > 10 ? 2 : 1
    h += tLines * 22 + 6
    // body: 中文字符约 11-12 字一行
    const bLen = (it.body || '').length
    const bLines = Math.max(1, Math.ceil(bLen / 11))
    h += bLines * 21
    total += h
  }
  // 底部留白 pad(24px)
  total += 24
  return Math.max(300, total)
}

export default {
  data: {
    _ck: null,
    clock: '--:--',
    y: 2026,
    m: 1,
    d: 1,
    dateText: '',
    items: [],
    innerHeight: 300,
    timer: null
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    const now = new Date()
    this.y = now.getFullYear()
    this.m = now.getMonth() + 1
    this.d = now.getDate()
    this.refresh()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
  },
  onHide() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  onDestroy() {
    if (this._ck) { g.clock.unsub(this._ck); this._ck = null }
  },
  refresh() {
    const dt = new Date(this.y, this.m - 1, this.d)
    this.dateText = this.m + '月' + this.d + '日 ' + g.time.weekdayName(dt)
    // 按月读盘：只取当月的数据（约 8 KB），不再整份物化 366 天
    historyData.getByDate(this.m, this.d, (events) => {
      const items = []
      // 1) 当天的史实条目
      for (let i = 0; i < events.length; i++) {
        const e = events[i]
        const meta = (e.year ? e.year + ' · ' : '') + (e.tag || '史实')
        items.push({ meta: meta, title: e.title || '历史上的今天', body: e.text })
      }
      // 2) 当天没有史实条目时，才用一条小知识兜底；小知识主体在「每日新知」页
      if (events.length === 0) {
        historyData.tipOfDay(this.m, this.d, (tips) => {
          if (tips.length) items.push({ meta: '小知识', title: '随手一读', body: tips[0] })
          if (!this.$valid) return
          this.items = items
          this.innerHeight = estimateInnerHeight(items)
        })
        return
      }
      if (!this.$valid) return
      this.items = items
      this.innerHeight = estimateInnerHeight(items)
    })
  },
  shift(delta) {
    g.haptic.short()
    const dt = new Date(this.y, this.m - 1, this.d + delta)
    this.y = dt.getFullYear()
    this.m = dt.getMonth() + 1
    this.d = dt.getDate()
    this.refresh()
    try {
      this.$element('listScroll').scrollTo({ top: 0, left: 0, behavior: 'instant' })
    } catch (e) {}
  },
  prevDay() {
    this.shift(-1)
  },
  nextDay() {
    this.shift(1)
  }
}
</script>
