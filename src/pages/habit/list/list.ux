<import name="pagehead" src="../../../components/PageHead.ux"></import>
<import name="backbtn" src="../../../components/BackBtn.ux"></import>

<template>
  <div class="page"><div class="napWrap" if="{{ awake }}">
    <pagehead title="日常打卡" clock="{{ clock }}"></pagehead>

    <list class="list" bounces="true">
      <list-item
        type="habit"
        class="card"
        style="background-color: {{ $item.done ? '#142C1E' : '#262626' }};"
        for="{{ items }}"
        @click="onTap($item)"
        @longpress="onLong($item)"
      >
        <div class="bar" style="background-color: {{ $item.barColor }};"></div>
        <div class="cMain">
          <text class="f cTitle">{{ $item.name }}</text>
          <text class="f cSub">{{ $item.sub }}</text>
        </div>
        <div class="cStat">
          <text class="f cCount" style="color: {{ $item.countColor }};">{{ $item.countText }}</text>
          <text class="f cTag" style="color: {{ $item.done ? '#00C853' : 'rgba(255,255,255,0.55)' }};">{{ $item.done ? '已达标' : '点 +1' }}</text>
        </div>
      </list-item>

      <list-item type="empty" class="empty" if="{{ items.length === 0 }}">
        <img class="emptyImg" src="/common/empty.png" />
        <text class="f emptyT">还没有打卡项</text>
        <text class="f emptyS">点右下角新建习惯</text>
      </list-item>

      <list-item type="pad" class="pad">
        <text class="f padTip" if="{{ items.length > 0 }}">轻触卡片 +1 · 长按编辑（最多 12 项）</text>
      </list-item>
    </list>

    <img class="plus" src="/common/plus.png" @click="create" />
    <backbtn></backbtn>
  </div></div>
</template>

<style>
@import '../../../common/styles/theme.css';
.list { position: absolute; left: 0px; top: 82px; width: 212px; height: 408px; padding: 0px 3px 0px 3px; }
.card { width: 206px; height: 76px; margin: 0px 0px 8px 0px; border-radius: 26px; background-color: #262626; flex-direction: row; align-items: center; padding: 0px 12px 0px 12px; }
.bar { width: 4px; height: 42px; border-radius: 2px; margin-right: 10px; flex-shrink: 0; }
/* 副标题用两行展示「连续 N 天 · 累计 N 天」：单行 108px 只放得下 7 个汉字，
   两位数连击时必被截断；两行后 3 位数累计也能完整显示。 */
.cMain { width: 108px; height: 60px; flex-direction: column; justify-content: center; }
.cTitle { width: 108px; height: 24px; line-height: 24px; font-size: 17px; color: #FFFFFF; text-overflow: ellipsis; lines: 1; }
.cSub { width: 108px; height: 36px; line-height: 18px; font-size: 14px; color: rgba(255,255,255,0.55); text-overflow: ellipsis; lines: 2; }
.cStat { width: 60px; height: 50px; flex-direction: column; align-items: flex-end; justify-content: center; flex-shrink: 0; }
.cCount { width: 60px; height: 26px; line-height: 26px; font-size: 18px; text-align: right; lines: 1; }
.cTag { width: 60px; height: 18px; line-height: 18px; font-size: 14px; text-align: right; lines: 1; }
.empty { width: 206px; height: 320px; align-items: center; justify-content: center; flex-direction: column; }
.emptyImg { width: 80px; height: 80px; margin-bottom: 12px; }
.emptyT { font-size: 17px; color: #FFFFFF; }
.emptyS { font-size: 14px; color: rgba(255,255,255,0.55); }
.pad { width: 206px; height: 112px; padding-top: 10px; align-items: flex-start; justify-content: center; }
.padTip { width: 190px; text-align: center; font-size: 14px; line-height: 20px; color: rgba(255,255,255,0.55); }
.plus { position: absolute; left: 132px; top: 396px; width: 64px; height: 64px; }
</style>

<script>
import g from '../../../utils/g'
import habitStore from '../../../utils/habitStore'
import prompt from '@system.prompt'
import life from '../../../utils/pageLife'

const uiState = {
  unsub: null,
  ignoreId: '',
  ignoreUntil: 0,
  tapping: false
}

function decorate(raw) {
  const done = raw.todayCount >= raw.target
  const started = raw.todayCount > 0
  return {
    id: raw.id,
    name: raw.name,
    target: raw.target,
    todayCount: raw.todayCount,
    streak: raw.streak,
    totalDays: raw.totalDays,
    done: done,
    countText: raw.todayCount + '/' + raw.target,
    sub: '连续 ' + raw.streak + ' 天\n累计 ' + raw.totalDays + ' 天',
    barColor: done ? '#00C853' : started ? '#0D6EFF' : '#555555',
    countColor: done ? '#00C853' : started ? '#4E87FF' : 'rgba(255,255,255,0.75)'
  }
}

export default life({
  data: {
    _ck: null,
    clock: '--:--',
    items: []
  },
  onShow() {
    this.clock = g.time.formatClock(new Date())
    uiState.ignoreId = ''
    uiState.ignoreUntil = 0
    uiState.tapping = false
    this.reload()
    const page = this
    this._ck = (s) => { if (page.$valid) page.clock = s }
    g.clock.sub(this._ck)
    if (!uiState.unsub) {
      uiState.unsub = habitStore.subscribe(() => {
        if (page.$valid) page.reload()
      })
    }
  },
  onHide() {
    this.cleanup()
  },
  onDestroy() {
    this.cleanup()
  },
  cleanup() {
    if (this._ck) {
      g.clock.unsub(this._ck)
      this._ck = null
    }
    if (uiState.unsub) {
      try { uiState.unsub() } catch (e) {}
      uiState.unsub = null
    }
  },
  reload() {
    habitStore.load((list) => {
      if (!this.$valid) return
      const out = []
      for (let i = 0; i < list.length; i++) out.push(decorate(list[i]))
      this.items = out
    })
  },
  onTap(item) {
    if (!item || !item.id) return
    if (uiState.ignoreId === item.id && Date.now() < uiState.ignoreUntil) {
      uiState.ignoreId = ''
      uiState.ignoreUntil = 0
      return
    }
    if (uiState.tapping) return
    uiState.tapping = true
    g.haptic.short()
    habitStore.tapInc(item.id, (res) => {
      uiState.tapping = false
      if (!res || !res.ok) return
      if (this.$valid) {
        const out = []
        for (let i = 0; i < res.list.length; i++) out.push(decorate(res.list[i]))
        this.items = out
      }
      if (res.reachedNow) {
        g.haptic.short()
        prompt.showToast({ message: '今日已达标！连续 ' + res.item.streak + ' 天', duration: 1500 })
      } else {
        prompt.showToast({
          message: res.item.name + ' ' + res.item.todayCount + '/' + res.item.target,
          duration: 1000
        })
      }
    })
  },
  onLong(item) {
    if (!item || !item.id) return
    uiState.ignoreId = item.id
    uiState.ignoreUntil = Date.now() + 900
    g.haptic.short()
    g.router.push('/pages/habit/edit', { id: item.id })
  },
  create() {
    g.haptic.short()
    if (this.items.length >= habitStore.MAX_ITEMS) {
      prompt.showToast({ message: '最多保留 ' + habitStore.MAX_ITEMS + ' 个打卡项', duration: 1500 })
      return
    }
    g.router.push('/pages/habit/edit', { id: '' })
  }
})
</script>
