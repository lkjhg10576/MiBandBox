<template>
  <div class="ph">
    <img class="phMask" src="/common/shadow.png" />
    <div class="phHit" @click="go">
      <text class="f phClock">{{ clock }}</text>
      <text class="f phTitle">{{ title }}</text>
    </div>
  </div>
</template>

<style>
.ph {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 84px;
  z-index: 1;
}
.phMask {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 84px;
}
/* 头部命中区：时间+标题那一整条（y0..74）可点 = 返回，替代只点左上角 28px 返回键。
   下界取 74：正文卡片最早从 y76 起步（节拍器/随机数键盘态编辑卡），不截胡正文点击；
   横屏正文（歌词 show）本就给页头让出顶部 80px，正好落在命中区内。
   命中区里不许放别的可点元素：页头的动作键（保存/完成/参考）一律放页面最下方独占一行，
   命中区一旦压住它们，真机上点「保存」会被页头吞掉（变成返回，或干脆点不到）。
   之所以不能靠 z-index 解决：Vela 渲染器直接丢弃 z-index（模拟器日志 "Unknown style -
   zIndex"，band10 / Pro 都一样），层序只按文档顺序排，真机与模拟器的点按判定顺序未必
   一致 —— 唯一稳的办法就是「不重叠」。门禁 R15 会扫这条不变量。 */
.phHit {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 212px;
  height: 74px;
}
.phClock {
  position: absolute;
  left: 0px;
  top: 22px;
  width: 212px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  font-size: 16px;
  color: rgba(255,255,255,0.72);
}
.phTitle {
  position: absolute;
  left: 0px;
  top: 42px;
  width: 212px;
  height: 30px;
  line-height: 30px;
  text-align: center;
  font-size: 18px;
  color: #FFFFFF;
  lines: 1;
}
</style>

<script>

import g from '../utils/g'
export default {
  props: ['clock', 'title', 'noback'],
  data: {},
  go() {
    // noback：首页（无上级可回）与整屏点按类页面（手速测试/节拍测定，点按即计数）退出头部返回
    if (this.noback) return
    g.router.back()
  }
}
</script>
