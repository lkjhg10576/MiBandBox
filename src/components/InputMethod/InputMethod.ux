<template>
  <!-- 根容器高度固定 365px（= 完成栏 32 + 拼音行 28 + 键盘体 305，三机型不变量），
       不用 auto：Band 11 真机固件对 absolute 根节点的 auto 高度测量不可靠，且下层包装
       全 absolute 后根流内高度会塌成 0。overflow 恒 hidden：内容最大 y471，超出根底
       466 的部分本就在画布外，hidden 不裁掉任何可见像素。 -->
  <div class="page" style="flex-direction: column; height: {{hide ? '0px' : '365px'}}; overflow: hidden;">
    <!-- 键盘内容懒建：外 if 保证键盘隐藏时整个子树不进 VDOM（chat/search 首进 1s 卡顿根因：
         旧实现 show 只是不可见，200+ 节点/图片在进页瞬间全部创建），首次弹出才创建，
         之后 keyboardCreated 保活、hide 切换只走内层 show 显隐，不重复重建。
         kbOuter/kbInner/kbBody/kbDown 四个包装层都必须带完整几何的 CSS 类
         （position + left/top + width/height）：Band 11 真机固件严格执行「带 if 的 div
         必须有 CSS 规则，否则其绝对定位子元素不被布局」这条 Vela 规则
         （docs/emulator-fix.md），缺类时按键区/控制栏/候选面板整棵不布局，
         只剩流内的完成栏 —— 手环 11 的键盘不弹就是这个原因。 -->
    <div if="{{!hide || keyboardCreated}}" class="kbOuter">
      <div show="{{!hide}}" class="kbInner">
      <!-- 「完成」栏：键盘态收起键盘的唯一入口。放在组件内部而不是页面模板里，是 Vela 4 的
           渲染层顺序坑：同一父容器里动态插入/show 翻转的节点会沉到静态兄弟之下（V5 无此问题），
           页面侧的 kbBar 在 band9 键盘态会被输入卡等静态内容盖住（2026-11-20 band9 验收实测，
           探针 probe-v2 定位）。组件整体在页面内容之上合成，栏随键盘一起显隐；
           高度 32 进根高 → 根顶 = 画布高 − 365（2026-11-20 三机型实测修正：
           band10/Pro/band9 的快应用画布高都是 466，根顶恒 101；
           旧文档记的 155/115/125 是按「屏高 − 365」算的，偏低）。点击经 close 事件交给页面收键盘。 -->
      <div class="kbdone" @click="onDoneBar"><text class="kbdoneT">完成</text></div>
      <!-- 拼音小字行：键盘框外上方单独一行，黑底覆盖，仅中/日模式且有 cval 时显示，只展示不可点。
           if 而非 show：show 隐藏时节点仍在 VDOM，键盘顶部会残留一条黑条 -->
      <div if="{{screentype === 'pill-shaped'}}" class="cvalrow-wrap" show="{{(lang==='cn' || lang==='jp') && downFlag==='' && !numFlag && cval}}">
        <text class="cvalrow">{{cvalDisplay}}</text>
      </div>
      <!-- 胶囊屏66 -->
      <!-- kbBody：键盘体容器。top:60px = 完成栏 32 + 拼音行 28，把键盘体的布局原点钉在
           根顶 +60（= 画布高 466 − 365 + 60 = 161），与改造前「流内排在完成栏/拼音行之后」
           的原点完全一致 —— 其绝对定位子节点（按键区 top34 / 控制栏 top0 / 下展面板 top47）
           的绝对坐标逐一不变。切勿改成 top:0：那会把整棵按键子树上移 60px，
           控制栏盖住完成栏，所有机型回归。 -->
      <div if="{{screentype==='pill-shaped'}}" class="kbBody">
        <div static style="position:absolute;left:0px;top:34px;width:100%;height:276px;">
          <progress percent="{{30+percent66}}" type="arc" style="start-angle:204deg;total-angle:-48deg;width:188px;height:188px;top:82px;left:2px;position:absolute;color:#ffffff;stroke-width:6px;layer-color:#262626;margin-left: {{(screenWidth - 192)/2}}px;"></progress>
          <scroll id="keyboard66" scroll-x="{{true}}" onscroll="handelScroll" style="padding-left: {{(screenWidth - 192)/2}}px;padding-right: {{(screenWidth - 192)/2}}px;">
            <div if="{{!numFlag}}" style="left: 3px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['full'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['full'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['full'][2]}}" @click="onSelect(item)">{{item}}</text>
                <img static src="./assets/arc/space.png" style="width: 60px;height: 60px;" @click="onBtnClick('space')" />
              </div>
            </div>
            <div if="{{numFlag && !numFlag_jp && !hexFlag && !rgbFlag}}" style="left: 3px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign'][2]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
            <div if="{{hexFlag}}" style="left: 3px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['hex'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['hex'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
            <!-- rgb 键面（色卡页专用）：数字行 + 逗号行；逗号放行首，无需横滚即可达
                 （number 键面的全角逗号在横滚区末尾，band10 上够不着，见 Beta 245 记录）。
                 键面进页即固定（watchKeyboardTypePropsChange 是空函数），与 hex 面同一套路。 -->
            <div if="{{rgbFlag}}" style="left: 3px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['rgb'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 0px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['rgb'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
            <div if="{{numFlag_jp}}" style="left: 3px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign_jp'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign_jp'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn66" for="{{item in keys['sign_jp'][2]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
          </scroll>
        </div>
        <div static style="position: absolute;left: {{(screenWidth - 192)/2}}px;top: 0px;width: 192px;height: 110px;">
          <img static style="position: absolute;left: 3px;top: 47px;width: 186px;height: 60px;" src="./assets/arc/search.png" />
          <!-- 候选横滚行：整词在前、单字随后（拼音已在键盘上方独立小字行显示，这里不放 cval） -->
          <scroll id="cvalWaiting" scroll-x="{{true}}" style="position: absolute;left: 15px;top: 56px;width: 144px;height: 42px;">
            <div style="position: absolute;left: 0px;top: 0px;height: 42px;padding-right:20px">
              <text for="{{resultRow0}}" show="{{resultRow0.length > $idx}}" class="calbtn02" style="padding-right:10px" @click="onRsSelect(resultRow0[$idx])">{{resultRow0[$idx]}}</text>
            </div>
          </scroll>
          <img show="{{resultRow0.length > 0}}" style="position: absolute;left: 120px;top: 57px;width: 60px;height: 40px;" src="./assets/arc/down2.png" @click="onBtnClick('down')" />
          <!-- 语言切换按钮：按语言写死字面量 src（工具链对变量拼接的 src 会告警）。
               三张图同位叠放，靠 show 互斥显示，行为与原 {{lang}} 动态 src 一致。 -->
          <img src="./assets/arc/cn.png" style="position: absolute;top:0px;left:9px;width: 48px;height: 42px;" @click="onBtnClick('lang')" show="{{downFlag==='' && !numFlag && !numFlag_jp && lang==='cn'}}" />
          <img src="./assets/arc/en.png" style="position: absolute;top:0px;left:9px;width: 48px;height: 42px;" @click="onBtnClick('lang')" show="{{downFlag==='' && !numFlag && !numFlag_jp && lang==='en'}}" />
          <img src="./assets/arc/back2.png" style="position: absolute;top:0px;left:9px;width: 48px;height: 42px;" @click="onBtnClick('switchCn')" show="{{keyboardtype === 'QWERTY' && (numFlag && lang==='cn' || numFlag_jp && lang==='jp') }}" />
          <img src="./assets/arc/123.png" style="position: absolute;left: 70px;top: 0px;width: 52px;height: 42px;" @click="onBtnClick('switchNum')" show="{{downFlag==='' && !numFlag && lang==='cn'}}" />
          <img src="./assets/arc/123.png" style="position: absolute;left: 70px;top: 0px;width: 52px;height: 42px;" @click="onBtnClick('switchNum_jp')" show="{{downFlag==='' && !numFlag_jp && lang==='jp'}}" />
          <img src="./assets/arc/bigA.png" style="position: absolute;top:0px;left:72px;width:48px;height:42px;" @click="onBtnClick('switchLow')" show="{{downFlag==='' && upperFlag && lang==='en' }}" />
          <img src="./assets/arc/a.png" style="position: absolute;top:0px;left:72px;width:48px;height:42px;" @click="onBtnClick('switchUpper')" show="{{downFlag==='' && !upperFlag && lang==='en' }}" />
          <img src="./assets/arc/del.png" style="position: absolute;left: 135px;top: 0px;width: 48px;height: 42px;" @click="onBtnClick('D')" />
        </div>
        <!-- 这里使用show会导致每次输入都会加载全部候选列表，很卡 -->
        <div class="kbDown" if="{{downFlag==='down'}}">
          <div style="position: absolute;left: {{(screenWidth - 192)/2}}px;width: 192px;height: 263px;"> 
            <scroll scroll-y="{{true}}" class="list66 expanded-scroll">
              <div class="expanded-candidates expanded-candidates66">
                <text class="calbtn-down-text" for="{{item in resultList2}}" @click="onRsSelect(item)">{{item}}</text>
              </div>
            </scroll>
            <img static style="position: absolute;top:196px;left:56px;width: 80px;height: 60px;" src="./assets/arc/up2.png" @click="onBtnClick('down')" />
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</template>

<script>
import vibrator from "@system.vibrator";
import { createDictionaryLoader } from "./assets/dictionaryLoader.js";
import { SCREEN } from "../../common/layout.js";

function deleteLast(t) {
  if (t) {
    return t.substr(0, t.length - 1);
  }
  return "";
}
export default {
  props: {
    dictionarypath: {
      default: "/components/InputMethod/assets/dictionary/",
    },
    hide: {
      default: true,
    },
    keyboardtype: {
      default: "QWERTY",
    },
    maxlength: {
      default: 5,
    },
    vibratemode: {
      default: "",
    },
    screentype: {
      // 圆屏(circle)/方屏(rect)布局已移除，唯一在用的是胶囊屏 pill-shaped
      default: "pill-shaped",
    },
  },
  data: {
    cval: "",
    // 拼音分词显示串（如 ni'hao），在 resetResultList 中随 cval 同步更新
    cvalDisplay: "",
    resultList: [],
    resultList2: [],
    // 多拼：整词候选（最前）及其与单字合并后的首页展示序列与对应整词标记
    resultWordList: [],
    resultRow0: [],
    resultRow0IsWord: [],
    // 当前已匹配的拼音前缀长度（用于逐字递进选择：选一个单字只消费对应长度）
    matchedLen: 0,
    // 每音节首字 + 累计拼音偏移（逐字递进选择：选哪个字就消费到哪个偏移位置）
    sylTopChars: [],
    waitingList: [],
    waitingIndex: -1,
    lastWaitingStr: "",
    downFlag: "",
    lang: "cn",
    numFlag: false,
    // hex 键面标记（进制转换页专用）：键盘上同时有数字与 A-F，走 numFlag 直出，本标记只负责换键面行
    hexFlag: false,
    // rgb 键面标记（色卡页专用）：数字 + 逗号键面，走 numFlag 直出，本标记只负责换键面行
    rgbFlag: false,
    numFlag_jp: false,
    upperFlag: false,
    // 键盘子树是否已建入 DOM：首次弹出置 true 保活（之后 hide 只走 show 显隐，不重建）
    keyboardCreated: false,
    cvalList: [0, 1, 2, 3, 4],
    percent66: 0,
    // 胶囊屏(pill-shaped)设备的屏宽，用于把 192 宽键盘居中。
    // 取构建期常量 SCREEN.w（src/common/layout.js，由 apply-profile 按 profile 生成：
    // band10=212 / band9=192 / pro336=336），不再用 device.getInfo 异步取：
    // 那条路有三个坑 —— 无 fail 回调、data 默认值 336 会让首帧偏移 72px、
    // 而偏移又绑定在 static 节点上（异步更新可能不重绘）。
    // 模板里的 {{(screenWidth - 192)/2}} 表达式字面量保持不动：
    // profiles/pro336.json 的 14 条替换对精确命中这些子串，改表达式会造成 profile 漂移。
    screenWidth: SCREEN.w,
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"],
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "!", "@", "#", "%", "“", "”", "*", "?", "/"],
        ["(", ")", "-", "_", ":", ";", "，", "。", "."],
      ],
      sign_jp: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "•", "@", "#", "%", "「", "」", "*", "?", "/"],
        ["(", ")", "-", "…", ":", ";", "、", "。", "!"],
      ],
      hex: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["A", "B", "C", "D", "E", "F"],
      ],
      rgb: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        [","],
      ],
    },
  },
  onInit() {
    // Initialize the loader independently of hide watchers (unreliable on some devices).
    // Dictionary data is loaded on input; failed reads can retry on the next query.
    Object.defineProperty(this, "_dictionary", {
      value: createDictionaryLoader(this.dictionarypath), configurable: true
    });
    if (this.maxlength) {
      const tempCvalList = [];
      for (let i = 0; i < this.maxlength; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
    // number 模式直接落数字行：复用 numFlag，按键行与控制栏的 show 条件都已按它分支
    if (this.keyboardtype === "number") {
      this.numFlag = true;
    }
    // hex 模式同样复用 numFlag 直出（绕过拼音组合与大小写转换），hexFlag 只负责换键面行
    if (this.keyboardtype === "hex") {
      this.numFlag = true;
      this.hexFlag = true;
    }
    // rgb 模式（色卡页专用）：数字 + 逗号键面，同样走 numFlag 直出
    if (this.keyboardtype === "rgb") {
      this.numFlag = true;
      this.rgbFlag = true;
    }
    if (!this.hide) this.keyboardCreated = true;
    this.$watch("hide", "watchHidePropsChange");
    this.$watch("maxlength", "watchMaxLengthPropsChange");
    this.$watch("keyboardtype", "watchKeyboardTypePropsChange");
  },
  onDestroy() {
    this._dictionary.destroy();
  },
  addAllTxt(txt) {
    this.$emit("complete", { content: txt });
  },
  onDoneBar() {
    this.$emit("close", {});
  },
  onRsSelect(txt) {
    this.onVibrate();
    // 检查是否为每音节首字 → 按偏移消费 cval 前缀
    var consumed = false;
    if (txt.length === 1 && this.sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this.sylTopChars.length; si++) {
        if (this.sylTopChars[si].char === txt && this.sylTopChars[si].offset > 0 && this.sylTopChars[si].offset <= this.cval.length) {
          this.cval = this.cval.slice(this.sylTopChars[si].offset);
          this.addAllTxt(txt);
          this.clearWaiting();
          this.resetResultList();
          this.downFlag = "";   // 下展 list 在 Vela 中缓存不刷新，先收回用顶行展示新数据
          consumed = true;
          break;
        }
      }
    }
    if (consumed) return;
    // 单字兜底：只消费已匹配的拼音前缀长度（兼容 matchedLen）
    if (txt.length === 1 && this.matchedLen > 0 && this.cval.length > this.matchedLen) {
      this.cval = this.cval.slice(this.matchedLen);
      this.addAllTxt(txt);
      this.clearWaiting();
      this.resetResultList();
      this.downFlag = "";
      return;
    }
    // 整词或多字：整体清空 cval 并一次输出
    this.cval = "";
    this.addAllTxt(txt);
    this.clearWaiting();
    this.resetResultList();
    this.downFlag = "";
  },
  onBtnClick(sign) {
    this.onVibrate();
    switch (sign) {
      case "AC":
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "lang":
        // L5-2：日文词库已下线，语言只在中/英之间切换
        if (this.lang === "cn") {
          this.lang = "en";
        } else {
          this.lang = "cn";
        }
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "D":
        if (this.waitingIndex >= 0) {
          this.clearWaiting();
          this.resetResultList();
        } else if (this.cval.length > 0) {
          this.cval = deleteLast(this.cval);
          this.resetResultList();
        } else {
          this.$emit("delete", {});
        }
        break;
      case "space":
        this.addAllTxt(" ");
        break;
      case "down":
        this.downFlag = this.downFlag === "down" ? "" : "down";
        break;
      case "switchNum":
        this.numFlag = true;
        this.numFlag_jp = false;
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "switchNum_jp":
        this.numFlag = true;
        this.numFlag_jp = true;
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "switchCn":
        this.numFlag = false;
        this.numFlag_jp = false;
        break;
      case "switchUpper":
        this.upperFlag = true;
        break;
      case "switchLow":
        this.upperFlag = false;
        break;
      default:
        // QWERTY 路径只有单字符按键（字母/数字/符号），不再有九键多击输入
        if (sign.length === 1) {
          this.addAllTxt(sign);
        }
        break;
    }
  },
  clearWaiting() {
    this.waitingList = [];
    this.waitingIndex = -1;
    this.lastWaitingStr = "";
  },
  resetResultList() {
    let watingStr = "";
    if (this.lastWaitingStr && this.lastWaitingStr[this.waitingIndex]) {
      watingStr = this.lastWaitingStr[this.waitingIndex];
    }
    this.cvalDisplay = this.cval + watingStr;
    if (!(this.cval + watingStr) || (this.lang !== "cn" && this.lang !== "jp")) {
      this._dictionary.release();
      this.clearCandidates();
      return;
    }
    this.getResultByWord(this.cval + watingStr);
  },
  clearCandidates() {
    this.resultList = [];
    this.resultWordList = [];
    this.matchedLen = 0;
    this.sylTopChars = [];
    this.setResultListAll();
  },
  setResultListAll() {
    // 首页展示序列：整词在前，单字随后，截断到 maxlength
    const cap = parseInt(this.maxlength);
    let row0 = [];
    let row0IsWord = [];
    for (let i = 0; i < this.resultWordList.length && row0.length < cap; i++) {
      row0.push(this.resultWordList[i]);
      row0IsWord.push(true);
    }
    // 单字候选去重：同音单字串首字可能与整词/逐字首字重复（如 shishei 的「是」），跳过
    for (let i = 0; i < this.resultList.length && row0.length < cap; i++) {
      if (this.resultWordList.indexOf(this.resultList[i]) !== -1) continue;
      row0.push(this.resultList[i]);
      row0IsWord.push(false);
    }
    this.resultRow0 = row0;
    this.resultRow0IsWord = row0IsWord;

    // Expanded candidates flow by content width, independently of maxlength.
    const expanded = this.resultWordList.slice();
    for (let i = 0; i < this.resultList.length; i++) {
      if (this.resultWordList.indexOf(this.resultList[i]) !== -1) continue;
      expanded.push(this.resultList[i]);
    }
    this.resultList2 = expanded;
  },
  getResultByWord(val) {
    const that = this;
    let completed = false;
    this._dictionary.search(val, that.lang, function (data, display) {
      completed = true;
      that.cvalDisplay = display;
      that.resultList = data.chars;                       // 单字候选（沿用）
      that.matchedLen = data.matched ? data.matched.length : 0;
      const multi = data.multi || { words: [], composed: "", sylTopChars: [] };
      that.sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0; });
      let words = (multi.words || []).slice();
      // 词库未命中但分词组合出多字串 → 也作为一条整词候选（排在整词区末尾，但在逐字首字之前）
      if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
        words = [multi.composed];
      } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
        words.push(multi.composed);
      }
      // 每音节首字放在整词后面、同音单字前面
      const sylOnlyChars = that.sylTopChars.map(function(sc) { return sc.char; });
      // 去重：音节首字列表中可能重复，从前往后去重
      const seen = {};
      const uniqueSylChars = [];
      for (var si = 0; si < sylOnlyChars.length; si++) {
        if (!seen[sylOnlyChars[si]]) { seen[sylOnlyChars[si]] = 1; uniqueSylChars.push(sylOnlyChars[si]); }
      }
      for (var si = 0; si < uniqueSylChars.length; si++) {
        if (words.indexOf(uniqueSylChars[si]) === -1) { words.push(uniqueSylChars[si]); }
      }
      that.resultWordList = words;
      that.setResultListAll();
    });
    // Keep warm queries synchronous; clear stale candidates only during I/O.
    if (!completed) this.clearCandidates();
  },
  onSelect(num) {
    this.$emit("keyDown", { content: num });
    this.onVibrate();
    if ((this.lang === 'cn' || this.lang === 'jp')  && !this.numFlag) {
      this.cval += num.toLowerCase();
    } else if (this.lang === "en" && !this.numFlag) {
      if (this.upperFlag) {
        this.addAllTxt(num.toUpperCase());
      } else {
        this.addAllTxt(num.toLowerCase());
      }
    } else {
      this.addAllTxt(num);
    }
    this.resetResultList();
  },
  onSelectWaiting(num) {
    this.onVibrate();
    if (this.lang === "cn") {
      this.cval += this.waitingList[num].toString();
    } else {
      if (this.upperFlag) {
        this.addAllTxt(this.waitingList[num].toUpperCase());
      } else {
        this.addAllTxt(this.waitingList[num].toLowerCase());
      }
    }
    this.clearWaiting();
    this.resetResultList();
  },
  watchHidePropsChange(newV, oldV) {
    this.$emit("visibilityChange", { visible: newV });
    if (newV === false) {
      this.keyboardCreated = true;
      this.resetResultList();
    } else {
      this._dictionary.release();
      this.clearCandidates();
    }
  },
  watchMaxLengthPropsChange(newV, oldV) {
    if (newV) {
      const tempCvalList = [];
      for (let i = 0; i < newV; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
  },
  watchKeyboardTypePropsChange(newV, oldV) {
    // 九键(T9)布局已移除，仅保留 QWERTY：keyboardtype 变化不再需要重置语言/候选状态
  },
  onVibrate() {
    if (this.vibratemode != "") {
      vibrator.vibrate({ mode: this.vibratemode });
    }
  },
  handelScroll(event) {
    let percentTemp66 = (event.scrollX / 633) * 100;
    this.percent66 = parseInt(percentTemp66 <= 100 ? percentTemp66 : 100);
  },
  pushCval() {
    this.onVibrate();
    let temp = this.cval;
    this.cval = "";
    this.clearWaiting();
    this.resetResultList();
    this.addAllTxt(temp);
  }
};
</script>

<style>
.page {
	width:100%;
	position:absolute;
	left:0;
	bottom:0;
	z-index:999
}
/* 键盘包装层的完整几何。
   Band 11 真机固件严格执行 Vela 规则「带 if 的 div 必须有 CSS 规则
   （position + left/top + width/height），否则其绝对定位子元素不被布局」
   （docs/emulator-fix.md）：缺类时按键区/控制栏/候选面板整棵不布局，
   只剩流内的完成栏 —— 这正是手环 11「键盘不弹、只有完成键」的成因。
   四个包装层都以根原点为基准：kbBody 额外下移 60px（完成栏 32 + 拼音行 28），
   让键盘体的布局原点停在根顶 +60，与改造前「流内排在完成栏/拼音行之后」完全一致，
   其绝对定位子节点（按键区 top34 / 控制栏 top0 / 下展面板 top47）坐标逐一不变。 */
.kbOuter {
	position:absolute;
	left:0;
	top:0;
	width:100%;
	height:365px
}
.kbInner {
	position:absolute;
	left:0;
	top:0;
	width:100%;
	height:365px;
	background-color:black;
	flex-direction:column
}
.kbBody {
	position:absolute;
	left:0;
	top:60px;
	width:100%;
	height:305px
}
.kbDown {
	position:absolute;
	left:0;
	top:47px;
	width:100%;
	height:263px;
	background-color:black
}
.item {
	height:52px;
	flex:1
}
.calbtn0 {
	color:#fff;
	font-size:28px;
	background-color:rgba(38,38,38,0);
	border-radius:0;
	height:52px;
	width:52px;
	text-align:center
}
.calbtn02 {
	color:rgb(255,255,255);
	background-color:rgba(38,38,38,0);
	border-radius:0px;
	font-size:32px;
	text-align:center;
	height:42px;
}
/* 下展分页候选按钮：宽度按文字自适应，不截断长词；覆盖各屏候选 class 的固定 width */
.calbtn-down {
	width:auto;
	min-width:52px;
	padding-left:14px;
	padding-right:14px;
	text-align:center;
}
.expanded-scroll {
	flex-direction:column;
	align-items:flex-start;
}
/* Keep wrapped content independent of the fixed scroll viewport height. */
.expanded-candidates {
	position:absolute;
	left:0px;
	top:0px;
	width:100%;
	flex-direction:row;
	flex-wrap:wrap;
	justify-content:center;
	align-items:center;
	align-content:flex-start;
	flex-shrink:0;
}
.expanded-candidates66 {
	padding:10px;
}
.calbtn-down-text {
	color:#ffffff;
	font-size:28px;
	padding:8px 10px;
	min-height:52px;
	max-width:100%;
	flex-shrink:0;
	text-align:center;
}
/* 拼音小字行：键盘框外上方单独一行显示 cval，单行裁剪、不可点 */
.cvalrow-wrap {
	width:100%;
	height:28px;
	background-color:transparent;
}
/* 「完成」栏（组件内）：宽度通栏、右对齐，样式与旧 theme .kbBar 一致 */
.kbdone {
	width:100%;
	height:32px;
	background-color:#111111;
	flex-direction:row;
	align-items:center;
	justify-content:flex-start;
}
.kbdoneT {
	width:178px;
	height:32px;
	line-height:32px;
	text-align:right;
	padding-right:14px;
	font-size:14px;
	color:#0D6EFF;
}
.cvalrow {
	color:#0d84ff;
	font-size:22px;
	font-weight:bold;
	lines:1;
	text-overflow:ellipsis;
	text-align:left;
	padding-left:14px;
