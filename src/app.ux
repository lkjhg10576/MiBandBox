<style>
/* 使用系统字体：Band 10/11 的系统字体覆盖完整中文，避免用户输入出现豆腐块。 */
.f {
  font-family: sans-serif;
}
</style>
<script>
import g from './global'
import interconnectUtil from './utils/interconnect'
import otpBridge from './utils/otpBridge'
import perf from './utils/perf'
import layoutFlag from './utils/layoutFlag'

function normalizeLayout(mode) {
  return mode === 'list' ? 'list' : 'grid'
}

/**
 * 应用级布局状态：所有页面共享同一份内存值。
 * 状态放在模块闭包里，不依赖 app.ux 方法被调用时的 this 指向。
 *
 * 注意：app.ux 只读 kv，不写 kv，也不在 onDestroy 里 flush。
 * 页面写入已经会及时落盘；app 侧的空/过期快照会覆盖用户偏好。
 */
const layoutState = {
  mode: 'grid',
  ready: false,
  watchers: []
}

function notifyLayout() {
  const mode = normalizeLayout(layoutState.mode)
  layoutState.watchers.slice().forEach((fn) => {
    try {
      fn(mode)
    } catch (e) {}
  })
}

export default {
  onCreate() {
    perf.mark('app.create')
    layoutState.mode = 'grid'
    layoutState.ready = false
    layoutState.watchers = []
    // 初始化手机互传通道（全局一次），供「从手机传输」页面订阅消息
    try {
      interconnectUtil.init()
    } catch (e) {}
    // OTP 常驻接收层：注册 bandbox-otp 协议订阅（按 app 字段过滤，
    // 与歌词传输页共存；app 生命周期内不退订）
    try {
      otpBridge.init()
    } catch (e) {}
    // 快路径：先读 4 字节的布局标志，首页不必等整份 store.json 读完就能定布局。
    // 随后 kv.init() 仍然以 KV 里的值为准（两者不一致时以 KV 为准并通知）。
    layoutFlag.read((flag) => {
      if (!flag) return
      layoutState.mode = flag
      layoutState.ready = true
      notifyLayout()
    })
    g.kv.init(() => {
      perf.mark('kv.ready')
      const mode = normalizeLayout(g.kv.get('home', 'grid'))
      if (!layoutState.ready) {
        layoutState.mode = mode
      } else if (mode !== layoutState.mode) {
        // 布局标志与 KV 不一致（标志写失败或被外部改动）→ 以 KV 为准
        layoutState.mode = mode
        notifyLayout()
      }
      layoutState.ready = true
      notifyLayout()
    })
  },
  getHomeLayout() {
    return normalizeLayout(layoutState.mode)
  },
  isHomeLayoutReady() {
    return layoutState.ready === true
  },
  watchHomeLayout(cb) {
    if (typeof cb !== 'function') return
    if (layoutState.watchers.indexOf(cb) < 0) {
      layoutState.watchers.push(cb)
    }
    if (layoutState.ready) {
      try {
        cb(normalizeLayout(layoutState.mode))
      } catch (e) {}
    }
  },
  unwatchHomeLayout(cb) {
    const i = layoutState.watchers.indexOf(cb)
    if (i >= 0) layoutState.watchers.splice(i, 1)
  },
  setHomeLayout(mode) {
    layoutState.mode = normalizeLayout(mode)
    layoutState.ready = true
    notifyLayout()
  }
}
</script>
