{
  "name": "bandbox",
  "version": "0.4.0",
  "description": "BandBox - 小米手环百宝箱",
  "scripts": {
    "check": "node tools/perf-audit.mjs --check",
    "build": "node tools/perf-audit.mjs --check && aiot build",
    "build:jsc": "node tools/perf-audit.mjs --check && aiot build --enable-jsc",
    "watch": "aiot start",
    "deploy": "./tools/deploy.sh"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.10",
    "aiot-toolkit": "2.0.5"
  }
}
